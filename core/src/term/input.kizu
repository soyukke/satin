// What the host's key, mouse, paste and focus events become on the PTY,
// encoded by libghostty from the terminal's current modes. The Rust
// `encode_key`, `encode_mouse`, `encode_paste` and `encode_focus`.
import std::mem;
import std::string;

@link_library("ghostty-vt")
extern "c" fn ghostty_key_encoder_new(allocator: ?ptr<u8>, out: ptr<u8>) -> i32
@link_library("ghostty-vt")
extern "c" fn ghostty_key_encoder_free(encoder: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_encoder_setopt(encoder: ptr<u8>, option: i32, value: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_encoder_setopt_from_terminal(encoder: ptr<u8>, terminal: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_encoder_encode(
    encoder: ptr<u8>,
    event: ptr<u8>,
    out: ptr<u8>,
    out_size: usize,
    out_len: ptr<u8>
) -> i32
@link_library("ghostty-vt")
extern "c" fn ghostty_key_event_new(allocator: ?ptr<u8>, out: ptr<u8>) -> i32
@link_library("ghostty-vt")
extern "c" fn ghostty_key_event_free(event: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_event_set_action(event: ptr<u8>, action: i32) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_event_set_key(event: ptr<u8>, key: i32) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_event_set_mods(event: ptr<u8>, mods: u16) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_event_set_composing(event: ptr<u8>, composing: bool) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_event_set_utf8(event: ptr<u8>, text: ?ptr<const u8>, length: usize) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_key_event_set_unshifted_codepoint(event: ptr<u8>, codepoint: u32) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_encoder_new(allocator: ?ptr<u8>, out: ptr<u8>) -> i32
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_encoder_free(encoder: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_encoder_setopt(encoder: ptr<u8>, option: i32, value: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_encoder_setopt_from_terminal(encoder: ptr<u8>, terminal: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_encoder_encode(
    encoder: ptr<u8>,
    event: ptr<u8>,
    out: ptr<u8>,
    out_size: usize,
    out_len: ptr<u8>
) -> i32
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_event_new(allocator: ?ptr<u8>, out: ptr<u8>) -> i32
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_event_free(event: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_event_set_action(event: ptr<u8>, action: i32) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_event_set_button(event: ptr<u8>, button: i32) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_event_clear_button(event: ptr<u8>) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_event_set_mods(event: ptr<u8>, mods: u16) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_mouse_event_set_position(event: ptr<u8>, position: MousePosition) -> void
@link_library("ghostty-vt")
extern "c" fn ghostty_paste_encode(
    data: ptr<u8>,
    data_len: usize,
    bracketed: bool,
    out: ptr<u8>,
    out_size: usize,
    out_written: ptr<u8>
) -> i32
@link_library("ghostty-vt")
extern "c" fn ghostty_terminal_mode_get(terminal: ptr<u8>, mode: u16, out: ptr<u8>) -> i32

/// libghostty's `GhosttyMousePosition`, in surface pixels.
extern "c" struct MousePosition {
    x: f32,
    y: f32,
}

/// libghostty's `GhosttyMouseEncoderSize`.
extern "c" struct MouseEncoderSize {
    size: usize,
    screen_width: u32,
    screen_height: u32,
    cell_width: u32,
    cell_height: u32,
    padding_top: u32,
    padding_bottom: u32,
    padding_right: u32,
    padding_left: u32,
}

/// A key event as the host reports it: a macOS virtual key code, the host's
/// modifier bits, the text the key produced when has_text is set, and the
/// text it produces without shift.
pub struct KeyInput {
    pub key_code: i64,
    pub modifiers: u32,
    pub has_text: bool,
    pub text: []u8,
    pub unshifted: []u8,
    pub repeat: bool,
    pub released: bool,
}

pub enum MouseAction {
    Press,
    Release,
    Motion,
}

/// A mouse event as the host reports it. button is libghostty's button
/// number, read only when has_button is set; x and y are surface pixels.
pub struct MouseInput {
    pub action: MouseAction,
    pub has_button: bool,
    pub button: i32,
    pub modifiers: u32,
    pub x: f32,
    pub y: f32,
    pub cell_width: u32,
    pub cell_height: u32,
}

/// The DEC private mode a focus report needs.
fn mode_focus_event() -> u16 {
    return 1004;
}

/// The DEC private mode that brackets a paste.
fn mode_bracketed_paste() -> u16 {
    return 2004;
}

fn terminal_data_mouse_tracking() -> i32 {
    return 11;
}

fn key_option_macos_option_as_alt() -> i32 {
    return 6;
}

fn mouse_option_size() -> i32 {
    return 2;
}

fn mouse_option_any_button_pressed() -> i32 {
    return 3;
}

/// libghostty's key for each macOS virtual key code, two hex digits a code,
/// sixteen codes a row; 00 is a code with no key.
fn key_row(row: i64) -> []u8 {
    if row == 0 {
        return "142617191b1a2d2b16290015242a1825";
    }
    if row == 1 {
        return "2c270708090a0c0b100f0d2e0e060422";
    }
    if row == 2 {
        return "28031c233a1f1d301e3102053221202f";
    }
    if row == 3 {
        return "403f01350078003b3d3633383e343900";
    }
    if row == 4 {
        return "895f0068005a005c0000006061006b8a";
    }
    if row == 5 {
        return "8b6250515253545556578c5859130000";
    }
    if row == 6 {
        return "7d7e7f7b808143834285888600820084";
    }
    return "008746474a447c457a49794c4d4b4e00";
}

fn hex_digit(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return value - 87;
    }
    return value - 48;
}

/// libghostty's key for a macOS virtual key code; zero when it has none.
pub fn macos_key(code: i64) -> i32 {
    if code < 0 or code > 127 {
        return 0;
    }
    let row = key_row(code / 16);
    let column = (code % 16) * 2;
    return cast<i32>(hex_digit(row[column]) * 16 + hex_digit(row[column + 1]));
}

/// The host's modifier bits as libghostty's. The six the host reports sit in
/// the same bits; libghostty's side bits above them stay clear.
fn key_mods(modifiers: u32) -> u16 {
    return cast<u16>(modifiers & 63);
}

/// One scalar of UTF-8 text and the bytes it took. Bytes that are not UTF-8
/// decode one at a time, as themselves.
struct Scalar {
    value: i64,
    length: i64,
}

fn continuation(bytes: []u8, index: i64) -> i64 {
    if index >= mem::len(bytes) {
        return -1;
    }
    let value = cast<i64>(bytes[index]);
    if value < 128 or value > 191 {
        return -1;
    }
    return value - 128;
}

fn decode_scalar(bytes: []u8, index: i64) -> Scalar {
    let first = cast<i64>(bytes[index]);
    var length: i64 = 1;
    var value = first;
    if first >= 240 and first < 248 {
        length = 4;
        value = first - 240;
    } else if first >= 224 and first < 240 {
        length = 3;
        value = first - 224;
    } else if first >= 192 and first < 224 {
        length = 2;
        value = first - 192;
    }
    for 1..length |offset| {
        let next = continuation(bytes, index + offset);
        if next < 0 {
            return Scalar { value: first, length: 1 };
        }
        value = value * 64 + next;
    }
    return Scalar { value: value, length: length };
}

/// Whether text is what a key press types: not empty, with no control
/// character and nothing from the range AppKit reports function keys in.
fn valid_key_text(text: []u8) -> bool {
    if mem::len(text) == 0 {
        return false;
    }
    var index: i64 = 0;
    while index < mem::len(text) {
        let scalar = decode_scalar(text, index);
        index = index + scalar.length;
        if scalar.value < 32 or (scalar.value >= 127 and scalar.value < 160) {
            return false;
        }
        if scalar.value >= 63232 and scalar.value <= 63743 {
            return false;
        }
    }
    return true;
}

/// The libghostty encoders and the one event of each kind they encode.
///
/// Each handle is live and the slot is a Slot; deinit frees all five, once.
unsafe struct InputHandles {
    key_encoder: ptr<u8>,
    key_event: ptr<u8>,
    mouse_encoder: ptr<u8>,
    mouse_event: ptr<u8>,
    slot: ptr<u8>,
}

/// Encodes input for one terminal. buffer is what libghostty writes an
/// encoding to, and is always full-length zero-initialized storage.
pub struct InputEncoder {
    handles: InputHandles,
    buffer: string::String,
    pub option_as_alt: bool,
    mouse_button_pressed: bool,
}

/// A handle from one of libghostty's `*_new` calls; null when it made none.
fn new_input_handle(slot: ptr<u8>, kind: i64) -> ?ptr<u8> {
    set_slot_usize(slot, 0);
    var result: i32 = 0;
    if kind == 0 {
        // SAFETY: the slot holds one writable handle; a null allocator is libghostty's own.
        result = unsafe ghostty_key_encoder_new(null, slot);
    } else if kind == 1 {
        // SAFETY: as above.
        result = unsafe ghostty_key_event_new(null, slot);
    } else if kind == 2 {
        // SAFETY: as above.
        result = unsafe ghostty_mouse_encoder_new(null, slot);
    } else {
        // SAFETY: as above.
        result = unsafe ghostty_mouse_event_new(null, slot);
    }
    if result != success() {
        return null;
    }
    return slot_handle(slot);
}

fn new_input_handles() -> GhosttyError!InputHandles {
    let slot = new_slot() orelse return GhosttyError::Refused;
    let key_encoder = new_input_handle(slot, 0);
    let key_event = new_input_handle(slot, 1);
    let mouse_encoder = new_input_handle(slot, 2);
    let mouse_event = new_input_handle(slot, 3);
    if key_encoder |key_encoder_live| {
        if key_event |key_event_live| {
            if mouse_encoder |mouse_encoder_live| {
                if mouse_event |mouse_event_live| {
                    // SAFETY: each handle is live and the slot is a Slot.
                    return unsafe InputHandles {
                        key_encoder: key_encoder_live,
                        key_event: key_event_live,
                        mouse_encoder: mouse_encoder_live,
                        mouse_event: mouse_event_live,
                        slot: slot
                    };
                }
            }
        }
    }
    if mouse_event |live| {
        // SAFETY: live came from mouse_event_new and nothing holds it.
        unsafe ghostty_mouse_event_free(live);
    }
    if mouse_encoder |live| {
        // SAFETY: live came from mouse_encoder_new and nothing holds it.
        unsafe ghostty_mouse_encoder_free(live);
    }
    if key_event |live| {
        // SAFETY: live came from key_event_new and nothing holds it.
        unsafe ghostty_key_event_free(live);
    }
    if key_encoder |live| {
        // SAFETY: live came from key_encoder_new and nothing holds it.
        unsafe ghostty_key_encoder_free(live);
    }
    // SAFETY: the slot came from malloc and nothing reads it after this.
    unsafe free(slot);
    return GhosttyError::Refused;
}

fn (self: InputHandles) deinit() -> void {
    // SAFETY: the mouse event is live and freed once, here.
    unsafe ghostty_mouse_event_free(self.mouse_event);
    // SAFETY: the mouse encoder is live and freed once, here.
    unsafe ghostty_mouse_encoder_free(self.mouse_encoder);
    // SAFETY: the key event is live and freed once, here.
    unsafe ghostty_key_event_free(self.key_event);
    // SAFETY: the key encoder is live and freed once, here.
    unsafe ghostty_key_encoder_free(self.key_encoder);
    // SAFETY: the slot came from malloc and nothing reads it after this.
    unsafe free(self.slot);
}

/// The bytes the encoding buffer starts with; a key or mouse report is far
/// shorter.
fn encoding_bytes() -> i64 {
    return 128;
}

fn grow_buffer(allocator: Allocator, buffer: &var string::String, length: i64) -> mem::Error!void {
    while buffer.len() < length {
        try buffer.append_byte(allocator, 0);
    }
    return;
}

pub fn new_input_encoder(allocator: Allocator) -> Failure!InputEncoder {
    var buffer = string::new(allocator);
    errdefer buffer.deinit(allocator);
    try grow_buffer(allocator, &var buffer, encoding_bytes());
    let handles = try new_input_handles();
    return InputEncoder {
        handles: move handles,
        buffer: move buffer,
        option_as_alt: false,
        mouse_button_pressed: false
    };
}

pub fn (self: InputEncoder) deinit(allocator: Allocator) -> void {
    self.handles.deinit();
    self.buffer.deinit(allocator);
}

/// Whether a DEC private mode is set; false when libghostty does not say.
///
/// terminal must be a live libghostty terminal and slot a Slot.
unsafe fn mode_is_set(terminal: ptr<u8>, slot: ptr<u8>, mode: u16) -> bool {
    // SAFETY: the caller passes a live terminal and a Slot, which holds a bool.
    let result = unsafe ghostty_terminal_mode_get(terminal, mode, slot);
    return result == success() and slot_bool(slot);
}

/// Appends what the key event is on the PTY to out. False when the key has
/// no encoding, which leaves out as it was.
///
/// terminal must be a live libghostty terminal.
pub unsafe fn(self: &var InputEncoder) encode_key(
    allocator: Allocator,
    terminal: ptr<u8>,
    input: KeyInput,
    out: &var string::String
) -> Failure!bool {
    let key = macos_key(input.key_code);
    if key == 0 {
        return false;
    }
    let encoder = self.handles.key_encoder;
    let event = self.handles.key_event;
    let slot = self.handles.slot;
    // SAFETY: the encoder and the caller's terminal are live.
    unsafe ghostty_key_encoder_setopt_from_terminal(encoder, terminal);
    var option_as_alt: usize = 0;
    if self.option_as_alt {
        option_as_alt = 1;
    }
    set_slot_usize(slot, option_as_alt);
    // SAFETY: the encoder is live; the slot holds the option-as-alt value.
    unsafe ghostty_key_encoder_setopt(encoder, key_option_macos_option_as_alt(), slot);
    var action: i32 = 1;
    if input.released {
        action = 0;
    } else if input.repeat {
        action = 2;
    }
    // SAFETY: the event is live.
    unsafe ghostty_key_event_set_action(event, action);
    // SAFETY: the event is live.
    unsafe ghostty_key_event_set_key(event, key);
    // SAFETY: the event is live.
    unsafe ghostty_key_event_set_mods(event, key_mods(input.modifiers));
    // SAFETY: the event is live.
    unsafe ghostty_key_event_set_composing(event, false);
    if !input.released and input.has_text and valid_key_text(input.text) {
        // SAFETY: the event is live; input.text outlives the encode below, which is what reads it.
        unsafe ghostty_key_event_set_utf8(event, ptr_of(input.text), cast<usize>(mem::len(input.text)));
    } else {
        // SAFETY: the event is live; null with no length is no text.
        unsafe ghostty_key_event_set_utf8(event, null, 0);
    }
    var codepoint: u32 = 0;
    if mem::len(input.unshifted) > 0 {
        codepoint = cast<u32>(decode_scalar(input.unshifted, 0).value);
    }
    // SAFETY: the event is live.
    unsafe ghostty_key_event_set_unshifted_codepoint(event, codepoint);
    return self.encode_event(allocator, true, out);
}

/// Whether the terminal asked for mouse reports.
///
/// terminal must be a live libghostty terminal.
pub unsafe fn(self: &InputEncoder) is_mouse_tracking(terminal: ptr<u8>) -> bool {
    let slot = self.handles.slot;
    // SAFETY: the caller passes a live terminal; the slot holds a bool.
    let result = unsafe ghostty_terminal_get(terminal, terminal_data_mouse_tracking(), slot);
    return result == success() and slot_bool(slot);
}

fn at_least_one(value: u32) -> u32 {
    if value == 0 {
        return 1;
    }
    return value;
}

fn saturating_product(cells: i64, pixels: u32) -> u32 {
    let product = cells * cast<i64>(pixels);
    if product > 4294967295 {
        return 4294967295;
    }
    return cast<u32>(product);
}

/// Appends what the mouse event is on the PTY to out, for a terminal of
/// cols x rows. False when the terminal wants no report of it.
///
/// terminal must be a live libghostty terminal.
pub unsafe fn(self: &var InputEncoder) encode_mouse(
    allocator: Allocator,
    terminal: ptr<u8>,
    cols: i64,
    rows: i64,
    input: MouseInput,
    out: &var string::String
) -> Failure!bool {
    // SAFETY: the caller passes a live terminal.
    if !unsafe self.is_mouse_tracking(terminal) {
        return false;
    }
    let encoder = self.handles.mouse_encoder;
    let event = self.handles.mouse_event;
    let slot = self.handles.slot;
    // SAFETY: the encoder and the caller's terminal are live.
    unsafe ghostty_mouse_encoder_setopt_from_terminal(encoder, terminal);
    let cell_width = at_least_one(input.cell_width);
    let cell_height = at_least_one(input.cell_height);
    let size = MouseEncoderSize {
        size: mem::size_of<MouseEncoderSize>(),
        screen_width: saturating_product(cols, cell_width),
        screen_height: saturating_product(rows, cell_height),
        cell_width: cell_width,
        cell_height: cell_height,
        padding_top: 0,
        padding_bottom: 0,
        padding_right: 0,
        padding_left: 0
    };
    // SAFETY: the slot is writable storage larger than a MouseEncoderSize.
    unsafe ptr_write(cast<ptr<MouseEncoderSize>>(slot), size);
    // SAFETY: the encoder is live; the slot holds a sized MouseEncoderSize.
    unsafe ghostty_mouse_encoder_setopt(encoder, mouse_option_size(), slot);
    var pressed: usize = 0;
    if self.mouse_button_pressed {
        pressed = 1;
    }
    set_slot_usize(slot, pressed);
    // SAFETY: the encoder is live; the slot holds the any-button-pressed bool.
    unsafe ghostty_mouse_encoder_setopt(encoder, mouse_option_any_button_pressed(), slot);
    var action: i32 = 0;
    if input.action == MouseAction::Release {
        action = 1;
    } else if input.action == MouseAction::Motion {
        action = 2;
    }
    // SAFETY: the event is live.
    unsafe ghostty_mouse_event_set_action(event, action);
    if input.has_button {
        // SAFETY: the event is live.
        unsafe ghostty_mouse_event_set_button(event, input.button);
    } else {
        // SAFETY: the event is live.
        unsafe ghostty_mouse_event_clear_button(event);
    }
    // SAFETY: the event is live.
    unsafe ghostty_mouse_event_set_mods(event, key_mods(input.modifiers));
    // SAFETY: the event is live.
    unsafe ghostty_mouse_event_set_position(event, MousePosition { x: input.x, y: input.y });
    let encoded = try self.encode_event(allocator, false, out);
    if encoded and input.has_button {
        self.mouse_button_pressed = input.action != MouseAction::Release;
    }
    return encoded;
}

/// Runs the key or the mouse encoder over its event and appends the result
/// to out. False when the encoding is empty.
fn (self: &var InputEncoder) encode_event(
    allocator: Allocator,
    key: bool,
    out: &var string::String
) -> Failure!bool {
    var result = self.run_encoder(key);
    if result == out_of_space() {
        let required = cast<i64>(slot_usize(self.handles.slot));
        try grow_buffer(allocator, &var self.buffer, required);
        result = self.run_encoder(key);
    }
    if result != success() {
        return GhosttyError::Refused;
    }
    let written = cast<i64>(slot_usize(self.handles.slot));
    if written == 0 {
        return false;
    }
    let bytes = self.buffer.as_bytes();
    try out.append_bytes(allocator, bytes[0..written]);
    return true;
}

/// One encode call into the buffer; the slot then holds the bytes written,
/// or the bytes needed when the result is out_of_space.
fn (self: &var InputEncoder) run_encoder(key: bool) -> i32 {
    let slot = self.handles.slot;
    let key_encoder = self.handles.key_encoder;
    let key_event = self.handles.key_event;
    let mouse_encoder = self.handles.mouse_encoder;
    let mouse_event = self.handles.mouse_event;
    set_slot_usize(slot, 0);
    let storage = self.buffer.as_mut_bytes();
    let capacity = cast<usize>(mem::len(storage));
    if key {
        // SAFETY: encoder and event are live; storage is capacity writable bytes; the slot holds a usize.
        return unsafe ghostty_key_encoder_encode(key_encoder, key_event, mut_ptr_of(storage), capacity, slot);
    }
    // SAFETY: encoder and event are live; storage is capacity writable bytes; the slot holds a usize.
    return unsafe ghostty_mouse_encoder_encode(mouse_encoder, mouse_event, mut_ptr_of(storage), capacity, slot);
}

/// Appends text as a paste to out: bracketed when the terminal asked for
/// that, and with what would break out of the paste made safe.
///
/// terminal must be a live libghostty terminal.
pub unsafe fn(self: &var InputEncoder) encode_paste(
    allocator: Allocator,
    terminal: ptr<u8>,
    text: []u8,
    out: &var string::String
) -> Failure!void {
    let slot = self.handles.slot;
    // SAFETY: the caller passes a live terminal; slot is a Slot.
    let bracketed = unsafe mode_is_set(terminal, slot, mode_bracketed_paste());
    var data = try string::from_bytes(allocator, text);
    defer data.deinit(allocator);
    try grow_buffer(allocator, &var self.buffer, mem::len(text) + 32);
    var result = self.run_paste(&var data, bracketed);
    if result == out_of_space() {
        let required = cast<i64>(slot_usize(slot));
        try grow_buffer(allocator, &var self.buffer, required);
        result = self.run_paste(&var data, bracketed);
    }
    if result != success() {
        return GhosttyError::Refused;
    }
    let written = cast<i64>(slot_usize(slot));
    let bytes = self.buffer.as_bytes();
    try out.append_bytes(allocator, bytes[0..written]);
    return;
}

/// One paste encode into the buffer; libghostty rewrites data in place.
fn (self: &var InputEncoder) run_paste(data: &var string::String, bracketed: bool) -> i32 {
    let slot = self.handles.slot;
    set_slot_usize(slot, 0);
    let source = data.as_mut_bytes();
    let length = cast<usize>(mem::len(source));
    let storage = self.buffer.as_mut_bytes();
    let capacity = cast<usize>(mem::len(storage));
    // SAFETY: source is length writable bytes, storage capacity writable bytes; the slot holds a usize.
    return unsafe ghostty_paste_encode(mut_ptr_of(source), length, bracketed, mut_ptr_of(storage), capacity, slot);
}

/// Appends the focus report to out. False when the terminal asked for none.
///
/// terminal must be a live libghostty terminal.
pub unsafe fn(self: &InputEncoder) encode_focus(
    allocator: Allocator,
    terminal: ptr<u8>,
    focused: bool,
    out: &var string::String
) -> mem::Error!bool {
    // SAFETY: the caller passes a live terminal; the slot is a Slot.
    if !unsafe mode_is_set(terminal, self.handles.slot, mode_focus_event()) {
        return false;
    }
    try out.append_byte(allocator, 27);
    if focused {
        try out.append_bytes(allocator, "[I");
    } else {
        try out.append_bytes(allocator, "[O");
    }
    return true;
}
