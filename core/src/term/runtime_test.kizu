import satin::tmux;
import std::mem;
import std::string;
import std::testing;

fn test_size() -> GridSize {
    return GridSize { rows: 24, cols: 80, pixel_width: 800, pixel_height: 480 };
}

/// text with `^` read as ESC, `~` as BEL and `$` as CR LF.
fn marked(allocator: Allocator, text: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    for 0..mem::len(text) |index| {
        if text[index] == cast<u8>(94) {
            try out.append_byte(allocator, 27);
        } else if text[index] == cast<u8>(126) {
            try out.append_byte(allocator, 7);
        } else if text[index] == cast<u8>(36) {
            try out.append_byte(allocator, 13);
            try out.append_byte(allocator, 10);
        } else {
            try out.append_byte(allocator, text[index]);
        }
    }
    return move out;
}

fn feed(allocator: Allocator, runtime: &var Runtime, text: []u8, replies: &var string::String) -> !void {
    let input = try marked(allocator, text);
    defer input.deinit(allocator);
    let bytes = input.as_bytes();
    try runtime.feed_external(allocator, bytes, replies);
    return;
}

fn project(allocator: Allocator, runtime: &var Runtime, text: []u8) -> !void {
    let input = try marked(allocator, text);
    defer input.deinit(allocator);
    let bytes = input.as_bytes();
    try runtime.feed_tmux_projection(allocator, bytes);
    return;
}

fn screen_has(allocator: Allocator, runtime: &var Runtime, needle: []u8) -> !bool {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try runtime.screen_text(allocator, &var text);
    let bytes = text.as_bytes();
    return find_bytes(bytes, needle, 0) >= 0;
}

fn newline() -> []u8 {
    return
        \\
        \\
    ;
}

fn prompt_is(runtime: &Runtime, expected: ShellPromptState) -> bool {
    if runtime.tmux_shell_prompt_state() |state| {
        return state == expected;
    } else |_| {}
    return false;
}

test "a fed terminal carries its replies and bells" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    var replies = string::new(allocator);
    defer replies.deinit(allocator);
    try feed(allocator, &var runtime, "^[c", &var replies);
    let reply = replies.as_bytes();
    testing::expect(mem::len(reply) > 3 and reply[0] == cast<u8>(27) and reply[2] == cast<u8>(63));
    replies.clear();
    try feed(allocator, &var runtime, "", &var replies);
    testing::expect(replies.len() == 0);
    try feed(allocator, &var runtime, "~ding~", &var replies);
    testing::expect(runtime.take_bell_count() == 2);
    testing::expect(runtime.take_bell_count() == 0);
    testing::expect(try screen_has(allocator, &var runtime, "ding"));
    testing::expect(runtime.wakeup_fd() == -1);
    testing::expect(!runtime.is_exited());
    testing::expect(!try runtime.drain(allocator));
}

test "a tmux projection drops the terminal's replies" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    try project(allocator, &var runtime, "^[c");
    var replies = string::new(allocator);
    defer replies.deinit(allocator);
    try feed(allocator, &var runtime, "", &var replies);
    testing::expect(replies.len() == 0);
}

test "the prompt state follows the cursor until the shell marks its prompts" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    testing::expect(prompt_is(&runtime, ShellPromptState::Waiting));
    try project(allocator, &var runtime, "prompt> ");
    testing::expect(prompt_is(&runtime, ShellPromptState::Ready));
    try project(allocator, &var runtime, "$^]133;C^\");
    testing::expect(runtime.tmux_semantic_prompt_seen());
    testing::expect(runtime.tmux_prompt_generation() == 0);
    testing::expect(prompt_is(&runtime, ShellPromptState::Waiting));
    try project(allocator, &var runtime, "^]133;A^\next> ^]133;B^\");
    testing::expect(runtime.tmux_prompt_generation() == 1);
    testing::expect(prompt_is(&runtime, ShellPromptState::Ready));
    runtime.reset_tmux_prompt_tracking();
    testing::expect(!runtime.tmux_semantic_prompt_seen());
    testing::expect(runtime.tmux_prompt_generation() == 0);
    try project(allocator, &var runtime, "^[?1049h");
    testing::expect(prompt_is(&runtime, ShellPromptState::Unavailable));
}

test "a fed terminal refuses what needs a child" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    var refused = false;
    if runtime.write_all("x") {} else |_| {
        refused = true;
    }
    testing::expect(refused);
    testing::expect(!runtime.interactive_shell_owns_foreground());
    testing::expect(!try runtime.tmux_command(allocator, "list-sessions"));
    testing::expect(!try runtime.tmux_send_bytes(allocator, 1, "x"));
}

test "a scroll region the output names animates the model" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, GridSize { rows: 4, cols: 8, pixel_width: 80, pixel_height: 80 });
    defer runtime.deinit(allocator);
    var replies = string::new(allocator);
    defer replies.deinit(allocator);
    try feed(allocator, &var runtime, "^[?1049hone$two$three$status", &var replies);
    try runtime.update_model(allocator);
    testing::expect(!runtime.model.has_active_animation());
    try feed(allocator, &var runtime, "^[1;3r^[H^[M^[r", &var replies);
    try runtime.update_model(allocator);
    testing::expect(runtime.model.scroll_position() == cast<f32>(-1.0));
    testing::expect(runtime.model.window.margins.bottom == 1);
    testing::expect(runtime.model.advance_animations(cast<f32>(0.016)));
}

fn tree_size() -> GridSize {
    return GridSize { rows: 8, cols: 24, pixel_width: 240, pixel_height: 160 };
}

fn append_number(allocator: Allocator, out: &var string::String, value: i64) -> !void {
    if value >= 10 {
        try append_number(allocator, out, value / 10);
    }
    try out.append_byte(allocator, cast<u8>(48 + value % 10));
    return;
}

/// Draws a file tree in the first six columns and, past its border, seven
/// lines of text from line first. Its icon, U+E612, holds a byte that is also
/// the value of a C1 control.
fn append_tree_screen(allocator: Allocator, out: &var string::String, first: i64) -> !void {
    for 0..7 |row| {
        try out.append_bytes(allocator, "^[");
        try append_number(allocator, out, row + 1);
        try out.append_bytes(allocator, ";1H");
        if row == 0 {
            try out.append_byte(allocator, 238);
            try out.append_byte(allocator, 152);
            try out.append_byte(allocator, 146);
            try out.append_bytes(allocator, "tree ");
        } else if row < 3 {
            try out.append_bytes(allocator, "  file");
        } else {
            try out.append_bytes(allocator, "      ");
        }
        try out.append_bytes(allocator, "│line ");
        try append_number(allocator, out, first + row);
        try out.append_bytes(allocator, "^[K");
    }
    return;
}

/// What an editor beside a tree writes for a key that moves its text up two
/// rows: the scroll named, then the rows in one synchronized update, carried
/// by whatever scroll sequence the terminal takes.
fn tree_key_output(allocator: Allocator, carried: []u8, first: i64) -> !string::String {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "^]777;SatinScroll;2;2;1;7;8;24~^[?2026h");
    try text.append_bytes(allocator, carried);
    try append_tree_screen(allocator, &var text, first);
    try text.append_bytes(allocator, "^[?2026l");
    let bytes = text.as_bytes();
    return marked(allocator, bytes);
}

fn tree_runtime(allocator: Allocator) -> !Runtime {
    var runtime = try external_runtime(allocator, tree_size());
    errdefer runtime.deinit(allocator);
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "^[?1049h");
    try append_tree_screen(allocator, &var text, 1);
    let bytes = text.as_bytes();
    try project(allocator, &var runtime, bytes);
    try runtime.update_model_at(allocator, 1000);
    return move runtime;
}

fn expect_slides_beside_tree(runtime: &Runtime, position: f64) -> void {
    testing::expect(runtime.model.scroll_position() == cast<f32>(position));
    testing::expect(runtime.model.window.margins.left == 7);
    testing::expect(runtime.model.window.margins.right == 0);
    testing::expect(runtime.model.window.margins.top == 0);
    testing::expect(runtime.model.window.margins.bottom == 1);
}

fn expect_one_slide_wherever_a_frame_falls(allocator: Allocator, carried: []u8) -> !void {
    let output = try tree_key_output(allocator, carried, 3);
    defer output.deinit(allocator);
    let bytes = output.as_bytes();
    for 0..mem::len(bytes) + 1 |cut| {
        var runtime = try tree_runtime(allocator);
        defer runtime.deinit(allocator);
        try runtime.feed_tmux_projection(allocator, bytes[0..cut]);
        try runtime.update_model_at(allocator, 3000);
        try runtime.feed_tmux_projection(allocator, bytes[cut..mem::len(bytes)]);
        try runtime.update_model_at(allocator, 3008);
        expect_slides_beside_tree(&runtime, -2.0);
    }
    return;
}

test "a named scroll slides once beside a tree wherever a frame falls" {
    let allocator = mem::page_allocator();
    try expect_one_slide_wherever_a_frame_falls(allocator, "");
}

test "a named scroll the terminal also carries out counts once" {
    let allocator = mem::page_allocator();
    try expect_one_slide_wherever_a_frame_falls(allocator, "^[1;7r^[?69h^[8;24s^[8;1H^[2M^[r^[1;24s^[?69l");
}

test "a named scroll slides when a frame follows every byte" {
    let allocator = mem::page_allocator();
    let output = try tree_key_output(allocator, "", 3);
    defer output.deinit(allocator);
    let bytes = output.as_bytes();
    var runtime = try tree_runtime(allocator);
    defer runtime.deinit(allocator);
    for 0..mem::len(bytes) |index| {
        try runtime.feed_tmux_projection(allocator, bytes[index..index + 1]);
        try runtime.update_model_at(allocator, 3000 + index / 8);
    }
    expect_slides_beside_tree(&runtime, -2.0);
}

test "keys pressed closer than output streams each slide beside a tree" {
    let allocator = mem::page_allocator();
    var runtime = try tree_runtime(allocator);
    defer runtime.deinit(allocator);
    for 0..3 |press| {
        let output = try tree_key_output(allocator, "", 3 + press * 2);
        defer output.deinit(allocator);
        let bytes = output.as_bytes();
        try runtime.feed_tmux_projection(allocator, bytes);
        try runtime.update_model_at(allocator, 3000 + press * 80);
        expect_slides_beside_tree(&runtime, cast<f64>(-2 - press * 2));
    }
}

fn plain_screen(allocator: Allocator, opening: []u8, first: i64) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes(allocator, opening);
    for 0..7 |row| {
        try text.append_bytes(allocator, "^[");
        try append_number(allocator, &var text, row + 1);
        try text.append_bytes(allocator, ";1Hline ");
        try append_number(allocator, &var text, first + row);
        try text.append_bytes(allocator, "^[K");
    }
    return move text;
}

fn show_plain(allocator: Allocator, runtime: &var Runtime, opening: []u8, first: i64, millis: i64) -> !void {
    let text = try plain_screen(allocator, opening, first);
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    try project(allocator, runtime, bytes);
    try runtime.update_model_at(allocator, millis);
    return;
}

test "rows are read for scrolls only of a program that does not name them" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, tree_size());
    defer runtime.deinit(allocator);
    try show_plain(allocator, &var runtime, "^[?1049h", 1, 1000);
    try show_plain(allocator, &var runtime, "^]777;SatinScroll;2;2;1;7;1;24~", 3, 3000);
    testing::expect(runtime.model.scroll_position() == cast<f32>(-2.0));
    let _ = runtime.model.advance_animations(cast<f32>(10.0));
    // Rows it moved without naming them are not a scroll.
    try show_plain(allocator, &var runtime, "", 5, 5000);
    testing::expect(runtime.model.scroll_position() == cast<f32>(0.0));
    // The program that comes after it on the screen says nothing of its own.
    try show_plain(allocator, &var runtime, "^[?1049l^[?1049h", 1, 7000);
    try show_plain(allocator, &var runtime, "", 3, 9000);
    testing::expect(runtime.model.scroll_position() == cast<f32>(-2.0));
}

fn program_status_is(runtime: &Runtime, word: []u8, line: []u8) -> !bool {
    let allocator = mem::page_allocator();
    var got_word = string::new(allocator);
    defer got_word.deinit(allocator);
    var got_line = string::new(allocator);
    defer got_line.deinit(allocator);
    if !try runtime.program_status(allocator, 0, &var got_word, &var got_line) {
        return false;
    }
    let word_bytes = got_word.as_bytes();
    let line_bytes = got_line.as_bytes();
    return mem::equal_bytes(word_bytes, word) and mem::equal_bytes(line_bytes, line);
}

test "a terminal answers a program status query and keeps its reports" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    var replies = string::new(allocator);
    defer replies.deinit(allocator);
    try feed(allocator, &var runtime, "^[c^]7501;?~", &var replies);
    let reply_bytes = replies.as_bytes();
    let device = try marked(allocator, "^[?");
    defer device.deinit(allocator);
    let device_bytes = device.as_bytes();
    testing::expect(find_bytes(reply_bytes, "7501;?:states=idle,working,done,blocked,error", 0) >= 0);
    // The device attributes asked first are answered first.
    testing::expect(find_bytes(reply_bytes, device_bytes, 0) >= 0);
    testing::expect(find_bytes(reply_bytes, device_bytes, 0) < find_bytes(reply_bytes, "7501;", 0));
    try feed(allocator, &var runtime, "^]7501;state=blocked:kind=question:app=antigravity~", &var replies);
    testing::expect(try program_status_is(&runtime, "waiting", "Antigravity needs input"));
    // The shell's next prompt ends it, as the program is gone.
    try feed(allocator, &var runtime, "^]133;A~$ ^]133;B~", &var replies);
    testing::expect(try program_status_is(&runtime, "idle", ""));
}

test "a tmux projection keeps the program status reply it owes" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    try project(allocator, &var runtime, "^[c^]7501;?^\\");
    var kept = string::new(allocator);
    defer kept.deinit(allocator);
    try runtime.take_graphics_replies(allocator, &var kept);
    let kept_bytes = kept.as_bytes();
    let device = try marked(allocator, "^[?");
    defer device.deinit(allocator);
    let device_bytes = device.as_bytes();
    testing::expect(find_bytes(kept_bytes, "7501;?:states=", 0) >= 0);
    // tmux answers the device attributes itself.
    testing::expect(find_bytes(kept_bytes, device_bytes, 0) < 0);
}

test "scrolling the viewport is bounded by the scrollback and recorded" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, GridSize { rows: 3, cols: 8, pixel_width: 80, pixel_height: 60 });
    defer runtime.deinit(allocator);
    var replies = string::new(allocator);
    defer replies.deinit(allocator);
    try feed(allocator, &var runtime, "1$2$3$4$5", &var replies);
    try runtime.update_model(allocator);
    testing::expect(runtime.scroll_delta(-10) == -2);
    testing::expect(runtime.scroll_delta(-1) == 0);
    try runtime.update_model(allocator);
    testing::expect(runtime.model.scroll_position() == cast<f32>(2.0));
    testing::expect(try screen_has(allocator, &var runtime, "1"));
    runtime.finish_external_input();
    testing::expect(!try screen_has(allocator, &var runtime, "1"));
}

test "a resize reaches the terminal and the model" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    try runtime.resize(allocator, GridSize { rows: 10, cols: 40, pixel_width: 400, pixel_height: 200 });
    try runtime.update_model(allocator);
    testing::expect(runtime.frame.row_count() == 10);
    testing::expect(runtime.model.window.width == 40);
    testing::expect(runtime.model.window.height == 10);
}

test "the terminal reports the directory its shell names" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    var replies = string::new(allocator);
    defer replies.deinit(allocator);
    var directory = string::new(allocator);
    defer directory.deinit(allocator);
    testing::expect(!try runtime.working_directory(allocator, &var directory));
    try feed(allocator, &var runtime, "^]7;file://host/tmp/a%20b^\", &var replies);
    testing::expect(try runtime.working_directory(allocator, &var directory));
    let bytes = directory.as_bytes();
    testing::expect(mem::equal_bytes(bytes, "/tmp/a b"));
}

test "a child's output is drained into the terminal and its exit seen" {
    let allocator = mem::page_allocator();
    var config = new_spawn_config(allocator);
    defer config.deinit(allocator);
    config.direct_startup = true;
    config.has_cwd = true;
    try config.cwd.append_bytes(allocator, "/tmp");
    try append_text(allocator, &var config.startup_command, "/bin/sh");
    try append_text(allocator, &var config.startup_command, "-c");
    try append_text(allocator, &var config.startup_command, "printf 'hello\033[6n'; read -r reply; echo got-reply");
    var runtime = try spawn_runtime(allocator, test_size(), &config);
    defer runtime.deinit(allocator);
    testing::expect(runtime.wakeup_fd() >= 0);
    var exited = false;
    var answered = false;
    for 0..300 |_attempt| {
        let _ = try runtime.drain(allocator);
        if !exited {
            // The shell waits for a line; the cursor report the terminal
            // answered arrives without a newline.
            if !answered and try screen_has(allocator, &var runtime, "hello") {
                try runtime.write_all(newline());
                answered = true;
            }
            exited = runtime.is_exited();
            // SAFETY: sleeping takes no memory of ours.
            let _ = unsafe usleep(10000);
        }
    }
    let _ = try runtime.drain(allocator);
    testing::expect(exited);
    testing::expect(try screen_has(allocator, &var runtime, "got-reply"));
    var directory = string::new(allocator);
    defer directory.deinit(allocator);
    testing::expect(try runtime.working_directory(allocator, &var directory));
    let bytes = directory.as_bytes();
    testing::expect(mem::equal_bytes(bytes, "/tmp"));
}


/// A 4 x 2 PNG of 16-bit RGB samples, red on the left and blue on the
/// right, base64 as the protocol carries it.
fn deep_png() -> []u8 {
    return "iVBORw0KGgoAAAANSUhEUgAAAAQAAAACEAIAAACgWjZ3AAAAFUlEQVR4nGP4/58BCCAkggUkcUkAAI6xD/H1JsyPAAAAAElFTkSuQmCC";
}

/// Feeds text, with `^` read as ESC, to runtime as tmux's control mode
/// hands a pane's output over: the passthrough envelope still around it.
fn project_through_tmux(allocator: Allocator, runtime: &var Runtime, text: []u8) -> !void {
    var decoder = tmux::new_decoder(0);
    var shown = string::new(allocator);
    defer shown.deinit(allocator);
    var inner = string::new(allocator);
    defer inner.deinit(allocator);
    let input = try marked(allocator, text);
    defer input.deinit(allocator);
    let bytes = input.as_bytes();
    try decoder.decode(allocator, bytes, &var shown, &var inner);
    let output = shown.as_bytes();
    try runtime.feed_tmux_projection(allocator, output);
    return;
}

/// Kitty graphics command, wrapped as a program in tmux sends it.
fn wrapped_graphics(allocator: Allocator, control: []u8, payload: []u8) -> mem::Error!string::String {
    var out = try string::from_bytes(allocator, "^Ptmux;^^_G");
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, control);
    try out.append_byte(allocator, 59);
    try out.append_bytes(allocator, payload);
    try out.append_bytes(allocator, "^^");
    try out.append_byte(allocator, 92);
    try out.append_byte(allocator, 94);
    try out.append_byte(allocator, 92);
    return move out;
}

test "a PNG a program in tmux passes through is placed" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    let command = try wrapped_graphics(allocator, "a=T,f=100,t=d,q=2,i=901,c=20,r=3,C=0", deep_png());
    defer command.deinit(allocator);
    let text = command.as_bytes();
    try project_through_tmux(allocator, &var runtime, text);
    try runtime.update_model(allocator);
    try runtime.collect_kitty(allocator);
    testing::expect(runtime.kitty.placements.len() == 1);
    let placement = runtime.kitty.placements.get(0) orelse return GhosttyError::Refused;
    testing::expect(placement.image_id == 901 and placement.image_width == 4 and placement.image_height == 2);
    testing::expect(placement.pixel_width == 200 and placement.pixel_height == 60);
    var pixels = string::new(allocator);
    defer pixels.deinit(allocator);
    testing::expect(try runtime.kitty.append_pixels(allocator, 901, &var pixels));
    let rgba = pixels.as_bytes();
    testing::expect(mem::len(rgba) == 32 and rgba[0] == cast<u8>(255) and rgba[2] == cast<u8>(0));
    testing::expect(rgba[12] == cast<u8>(0) and rgba[14] == cast<u8>(255));
}

test "Unicode placeholders in a tmux pane show their virtual placement" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    let command = try wrapped_graphics(allocator, "a=T,U=1,f=100,t=d,q=2,i=77,c=4,r=2", deep_png());
    defer command.deinit(allocator);
    let text = command.as_bytes();
    try project_through_tmux(allocator, &var runtime, text);
    try project_through_tmux(allocator, &var runtime, "^[2;3H^[38;5;77m􎻮̅̅􎻮􎻮􎻮^[3;3H􎻮̍̅􎻮􎻮􎻮^[39m");
    try runtime.update_model(allocator);
    try runtime.collect_kitty(allocator);
    // Cells are 10 x 20 pixels: the 4 x 2 image fills the 40 pixels of the
    // grid's width, 20 high, centered with 10 above and below.
    testing::expect(runtime.kitty.placements.len() == 2);
    let top = runtime.kitty.placements.get(0) orelse return GhosttyError::Refused;
    let bottom = runtime.kitty.placements.get(1) orelse return GhosttyError::Refused;
    testing::expect(top.image_id == 77 and top.viewport_row == 1 and top.viewport_col == 2);
    testing::expect(top.source_y == 0 and top.source_height == 1 and top.source_width == 4);
    testing::expect(top.y_offset == 10 and top.pixel_height == 10 and top.pixel_width == 40);
    testing::expect(bottom.viewport_row == 2 and bottom.source_y == 1 and bottom.source_height == 1);
    testing::expect(bottom.y_offset == 0 and bottom.pixel_height == 10);
    testing::expect(!try screen_has(allocator, &var runtime, "􎻮"));
}

test "a tmux projection keeps the Kitty graphics replies it owes" {
    let allocator = mem::page_allocator();
    var runtime = try external_runtime(allocator, test_size());
    defer runtime.deinit(allocator);
    let command = try wrapped_graphics(allocator, "i=31,s=1,v=1,a=q,t=d,f=24", "AAAA");
    defer command.deinit(allocator);
    let text = command.as_bytes();
    try project_through_tmux(allocator, &var runtime, text);
    try project(allocator, &var runtime, "^[c");
    var replies = string::new(allocator);
    defer replies.deinit(allocator);
    try runtime.take_graphics_replies(allocator, &var replies);
    var expected = try marked(allocator, "^_Gi=31;OK^");
    defer expected.deinit(allocator);
    try expected.append_byte(allocator, 92);
    let got = replies.as_bytes();
    let want = expected.as_bytes();
    testing::expect(mem::equal_bytes(got, want));
    replies.clear();
    try runtime.take_graphics_replies(allocator, &var replies);
    testing::expect(replies.len() == 0);
}
