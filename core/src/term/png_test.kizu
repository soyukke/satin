import std::mem;
import std::string;
import std::testing;

fn png_hex_digit(byte: u8) -> u8 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return cast<u8>(value - 87);
    }
    return cast<u8>(value - 48);
}

/// The bytes hex spells, two digits a byte.
fn png_bytes(allocator: Allocator, hex: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index: i64 = 0;
    while index + 1 < mem::len(hex) {
        try out.append_byte(allocator, png_hex_digit(hex[index]) * 16 + png_hex_digit(hex[index + 1]));
        index = index + 2;
    }
    return move out;
}

/// Whether the PNG that image spells decodes to width x height pixels that pixels spells.
fn decodes_to(image: []u8, width: i64, height: i64, pixels: []u8) -> !bool {
    let allocator = mem::page_allocator();
    let source = try png_bytes(allocator, image);
    defer source.deinit(allocator);
    let expected = try png_bytes(allocator, pixels);
    defer expected.deinit(allocator);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    var decoded_width: i64 = 0;
    var decoded_height: i64 = 0;
    let source_bytes = source.as_bytes();
    try decode_png(allocator, source_bytes, &var decoded_width, &var decoded_height, &var out);
    let out_bytes = out.as_bytes();
    let expected_bytes = expected.as_bytes();
    return decoded_width == width and decoded_height == height and mem::equal_bytes(out_bytes, expected_bytes);
}

test "decodes 8-bit RGBA through every row filter" {
    testing::expect(try decodes_to(
        "",
        5,
        6,
        "a54dca182530bb1d6d132cded6237b2ed91e3f721fcb1971174494d6493c9d5c3460be31201e69fedaa0eee8b9997f5c7c2999fdafe593253cd654af4dfad71427a0aeb3fee9232f8af2211f9ee491c5b10becb5563bfc1e6f93427ecbc8fe2955e5cd8e46dc8ed4b7c2764d2a5a4d767706f85d8690024a"
    ));
}

test "narrows 16-bit RGB and applies its transparent color" {
    testing::expect(try decodes_to(
        "",
        3,
        5,
        "d6bda3ff401be9ffc8cbccffc935f6ffcd1f61ff226ae1ff5338aeff1a3400004d33baff0d246affc04c81ffb1baf2ff3e3bf9ffeef5f7ff9f2b49ff"
    ));
}

test "spreads 1-bit gray over the range" {
    testing::expect(try decodes_to(
        "89504e470d0a1a0a0000000d494844520000000a0000000301000000008246a3d800000003744558746b0076cb04f3900000000849444154789c63286460dcea5785f8da0000000949444154cd34fd00000a4002cc5355d26f0000000049454e44ae426082",
        10,
        3,
        "000000ffffffffffffffffffffffffff000000ff000000ff000000ffffffffff000000ff000000ffffffffff000000ffffffffffffffffff000000ffffffffff000000ffffffffff000000ff000000ff000000ffffffffff000000ff000000ffffffffffffffffff000000ff000000ffffffffffffffffff"
    ));
}

test "looks 4-bit indexes up in the palette and its alphas" {
    testing::expect(try decodes_to(
        "",
        7,
        4,
        "2b3dc6ff8463b000deaa2cff2b3dc6ffcaedcdff66f45bff2b5157ffdeaa2cffb34f43ffac68f7ffe4b2ba80410e4dff0a0734ffb34f43ffac68f7ffac68f7ff8463b0000a0734ff00f5b0ff8463b000ac68f7ff00f5b0ffac68f7ff47de63ff74f064ffe4b2ba802b5157ff47de63ff"
    ));
}

test "places the pixels of an interlaced gray and alpha image" {
    testing::expect(try decodes_to(
        "",
        9,
        10,
        ""
    ));
}

test "reads an interlaced image narrower than a pass" {
    testing::expect(try decodes_to(
        "89504e470d0a1a0a0000000d494844520000000500000003020000000143eab21300000003744558746b0076cb04f3900000000a49444154789c63706000811f0c1f3024a4f70000000b494441541827302c71000014bc039e30cf450d0000000049454e44ae426082",
        5,
        3,
        "555555ffffffffff000000ffffffffff000000ffaaaaaaffaaaaaaff555555ff000000ff555555ffffffffffaaaaaaffffffffff555555ffaaaaaaff"
    ));
}

test "refuses bytes that are not a whole PNG" {
    let allocator = mem::page_allocator();
    let source = try png_bytes(allocator, "");
    defer source.deinit(allocator);
    let bytes = source.as_bytes();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    var width: i64 = 0;
    var height: i64 = 0;
    try png_size(bytes, &var width, &var height);
    testing::expect(width == 5 and height == 6);
    var refused = false;
    if decode_png(allocator, bytes[0..mem::len(bytes) - 20], &var width, &var height, &var out) {} else |_| {
        refused = true;
    }
    testing::expect(refused);
    refused = false;
    if decode_png(allocator, "not a png at all, only some text", &var width, &var height, &var out) {} else |_| {
        refused = true;
    }
    testing::expect(refused);
    testing::expect(out.len() == 0);
}
