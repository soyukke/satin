// The display list: what one frame draws, as a flat run of commands in
// device pixels that a backend executes in order. It names no drawing
// library; the Rust renderer made the same calls on a Skia canvas.
//
// A list is built once a frame and reused: reset keeps its storage.
import std::array;
import std::mem;
import std::string;

/// A rectangle in device pixels, y down from the top left.
pub struct Rect {
    pub x: f32,
    pub y: f32,
    pub width: f32,
    pub height: f32,
}

pub struct Point {
    pub x: f32,
    pub y: f32,
}

/// A color and how much of it covers what is under it, not premultiplied.
pub struct Rgba {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8,
}

pub enum CommandKind {
    /// Fills the whole target with color. A frame's first pane issues it
    /// before any clip.
    Clear,
    /// Fills rect with color, without antialiasing.
    FillRect,
    /// Draws only inside rect, and inside the clips still pushed, until the
    /// PopClip that matches.
    PushClip,
    PopClip,
    /// Draws the text run at first of runs in color.
    Text,
    /// Strokes the count points from first of points, joined in order, width
    /// pixels wide in color, without antialiasing.
    Polyline,
    /// Fills the four points from first of points in color, antialiased.
    Quad,
    /// Draws the image at first of images into rect.
    Image,
}

pub struct Command {
    pub kind: CommandKind,
    pub rect: Rect,
    pub color: Rgba,
    pub first: i64,
    pub count: i64,
    pub width: f32,
}

/// One cell's text in a run: text_len bytes of the list's text at
/// text_start, drawn cell cells after the run's first.
pub struct Cluster {
    pub text_start: i64,
    pub text_len: i64,
    pub cell: i64,
}

/// The neighboring cells of one row that share a color and a style: count
/// clusters from first of clusters. The first cell's left edge is x and the
/// row's baseline is baseline; a cell is advance wide and the run spans
/// cells of them. key is what the run's glyphs depend on: its texts and
/// whether it is bold or italic. gap is set when the cell after the run is
/// empty, which is where the second half of a wide character is.
pub struct TextRun {
    pub first: i64,
    pub count: i64,
    pub x: f32,
    pub baseline: f32,
    pub advance: f32,
    pub cells: i64,
    pub gap: bool,
    pub bold: bool,
    pub italic: bool,
    pub key: u64,
}

/// The part source of an image to draw. owner and image_id name the image,
/// which is width x height pixels; a new image_number says its pixels
/// changed.
pub struct ImageDraw {
    pub owner: usize,
    pub image_id: u32,
    pub image_number: u32,
    pub width: u32,
    pub height: u32,
    pub source: Rect,
}

pub struct DisplayList {
    pub commands: array::Array<Command>,
    pub runs: array::Array<TextRun>,
    pub clusters: array::Array<Cluster>,
    pub text: string::String,
    pub points: array::Array<Point>,
    pub images: array::Array<ImageDraw>,
    /// The scene's own background, which a backdrop may show through; its
    /// alpha is zero when no scene named one.
    pub background: Rgba,
}

pub fn new_display_list(allocator: Allocator) -> DisplayList {
    return DisplayList {
        commands: array::new<Command>(allocator),
        runs: array::new<TextRun>(allocator),
        clusters: array::new<Cluster>(allocator),
        text: string::new(allocator),
        points: array::new<Point>(allocator),
        images: array::new<ImageDraw>(allocator),
        background: no_color()
    };
}

pub fn (self: DisplayList) deinit(allocator: Allocator) -> void {
    self.commands.deinit(allocator);
    self.runs.deinit(allocator);
    self.clusters.deinit(allocator);
    self.text.deinit(allocator);
    self.points.deinit(allocator);
    self.images.deinit(allocator);
}

/// Empties the list, keeping its storage for the next frame.
pub fn (self: &var DisplayList) reset(allocator: Allocator) -> void {
    self.commands.clear(allocator);
    self.runs.clear(allocator);
    self.clusters.clear(allocator);
    self.text.clear();
    self.points.clear(allocator);
    self.images.clear(allocator);
    self.background = no_color();
}

fn no_rect() -> Rect {
    return Rect { x: cast<f32>(0.0), y: cast<f32>(0.0), width: cast<f32>(0.0), height: cast<f32>(0.0) };
}

fn no_color() -> Rgba {
    return Rgba { r: 0, g: 0, b: 0, a: 0 };
}

fn (self: &var DisplayList) push(
    allocator: Allocator,
    kind: CommandKind,
    rect: Rect,
    color: Rgba,
    first: i64,
    count: i64
) -> mem::Error!void {
    try self.commands.append(
        allocator,
        Command { kind: kind, rect: rect, color: color, first: first, count: count, width: cast<f32>(0.0) }
    );
    return;
}

pub fn (self: &var DisplayList) clear_target(allocator: Allocator, color: Rgba) -> mem::Error!void {
    try self.push(allocator, CommandKind::Clear, no_rect(), color, 0, 0);
    return;
}

pub fn (self: &var DisplayList) fill_rect(allocator: Allocator, rect: Rect, color: Rgba) -> mem::Error!void {
    try self.push(allocator, CommandKind::FillRect, rect, color, 0, 0);
    return;
}

pub fn (self: &var DisplayList) push_clip(allocator: Allocator, rect: Rect) -> mem::Error!void {
    try self.push(allocator, CommandKind::PushClip, rect, no_color(), 0, 0);
    return;
}

pub fn (self: &var DisplayList) pop_clip(allocator: Allocator) -> mem::Error!void {
    try self.push(allocator, CommandKind::PopClip, no_rect(), no_color(), 0, 0);
    return;
}

/// Strokes the line from one point to the other.
pub fn (self: &var DisplayList) line(
    allocator: Allocator,
    from: Point,
    to: Point,
    width: f32,
    color: Rgba
) -> mem::Error!void {
    let first = self.points.len();
    try self.points.append(allocator, from);
    try self.points.append(allocator, to);
    try self.commands.append(
        allocator,
        Command { kind: CommandKind::Polyline, rect: no_rect(), color: color, first: first, count: 2, width: width }
    );
    return;
}

/// Fills the shape whose corners are the four points, in order around it.
pub fn (self: &var DisplayList) quad(
    allocator: Allocator,
    first: Point,
    second: Point,
    third: Point,
    fourth: Point,
    color: Rgba
) -> mem::Error!void {
    let start = self.points.len();
    try self.points.append(allocator, first);
    try self.points.append(allocator, second);
    try self.points.append(allocator, third);
    try self.points.append(allocator, fourth);
    try self.push(allocator, CommandKind::Quad, no_rect(), color, start, 4);
    return;
}

/// Adds the text of the cell that is cell cells into the run being
/// collected; text_run then names the clusters added since the last run.
pub fn (self: &var DisplayList) add_cluster(allocator: Allocator, bytes: []u8, cell: i64) -> mem::Error!void {
    let start = self.text.len();
    try self.text.append_bytes(allocator, bytes);
    try self.clusters.append(allocator, Cluster { text_start: start, text_len: mem::len(bytes), cell: cell });
    return;
}

pub fn (self: &var DisplayList) text_run(allocator: Allocator, run: TextRun, color: Rgba) -> mem::Error!void {
    let index = self.runs.len();
    try self.runs.append(allocator, run);
    try self.push(allocator, CommandKind::Text, no_rect(), color, index, 1);
    return;
}

pub fn (self: &var DisplayList) image(allocator: Allocator, image: ImageDraw, destination: Rect) -> mem::Error!void {
    let index = self.images.len();
    try self.images.append(allocator, image);
    try self.push(allocator, CommandKind::Image, destination, no_color(), index, 1);
    return;
}

/// How many commands of kind the list holds.
pub fn (self: &DisplayList) count_of(kind: CommandKind) -> i64 {
    let commands = self.commands.as_slice();
    var found = 0;
    for 0..mem::count<Command>(commands) |index| {
        if commands[index].kind == kind {
            found = found + 1;
        }
    }
    return found;
}
