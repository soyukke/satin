import std::fmt;
import std::mem;
import std::string;
import std::testing;

fn fresh(allocator: Allocator) -> !Core {
    return new_core(allocator, "Graphite");
}

/// Fails the test with the snapshot when it is not want.
fn expect_snapshot(allocator: Allocator, core: &Core, want: []u8) -> !void {
    var got = string::new(allocator);
    defer got.deinit(allocator);
    try core.snapshot_json(allocator, &var got);
    let bytes = got.as_bytes();
    if !mem::equal_bytes(bytes, want) {
        testing::fail(bytes);
    }
    return;
}

/// Checks the snapshot of a core with one tab: its active pane, pane list
/// and layout.
fn expect_tab(allocator: Allocator, core: &Core, active_pane: i64, panes: []u8, layout: []u8) -> !void {
    var want = try string::from_bytes(allocator,
        \\{"active_tab":0,"tabs":[{"id":1,"index":0,"title":"session 1","active_pane":
    );
    defer want.deinit(allocator);
    try fmt::append_i64(allocator, &var want, active_pane);
    try want.append_bytes(allocator,
        \\,"theme":"Graphite","panes":
    );
    try want.append_bytes(allocator, panes);
    try want.append_bytes(allocator,
        \\,"layout":
    );
    try want.append_bytes(allocator, layout);
    try want.append_bytes(allocator, "}]}");
    let bytes = want.as_bytes();
    return expect_snapshot(allocator, core, bytes);
}

test "default core starts with one session tab" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    try expect_tab(allocator, &core, 1, "[1]",
        \\{"kind":"leaf","pane_id":1}
    );
}

test "configured default theme applies to new tabs" {
    let allocator = mem::page_allocator();
    var core = try new_core(allocator, "Harbor");
    defer core.deinit(allocator);
    testing::expect(try core.set_tab_theme(allocator, 0, "Rose"));
    testing::expect_equal<i64>(1, try core.new_tab(allocator));
    try core.set_default_theme(allocator, "  Paper ");
    testing::expect_equal<i64>(2, try core.new_tab(allocator));
    try expect_snapshot(allocator, &core,
        \\{"active_tab":2,"tabs":[{"id":1,"index":0,"title":"session 1","active_pane":1,"theme":"Rose","panes":[1],"layout":{"kind":"leaf","pane_id":1}},{"id":2,"index":1,"title":"session 2","active_pane":2,"theme":"Harbor","panes":[2],"layout":{"kind":"leaf","pane_id":2}},{"id":3,"index":2,"title":"session 3","active_pane":3,"theme":"Paper","panes":[3],"layout":{"kind":"leaf","pane_id":3}}]}
    );
}

test "splitting the active pane selects the new pane" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    try expect_tab(allocator, &core, 2, "[1,2]",
        \\{"kind":"split","axis":"vertical","ratio":0.5,"first":{"kind":"leaf","pane_id":1},"second":{"kind":"leaf","pane_id":2}}
    );
}

test "resizing a nested split updates only the marked boundary" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    testing::expect_equal<i64>(3, try core.split_active(allocator, Axis::Horizontal));
    testing::expect(core.resize_split(2, 3, 0.7));
    testing::expect(core.resize_split(1, 2, 0.35));
    try expect_tab(allocator, &core, 3, "[1,2,3]",
        \\{"kind":"split","axis":"vertical","ratio":0.35,"first":{"kind":"leaf","pane_id":1},"second":{"kind":"split","axis":"horizontal","ratio":0.7,"first":{"kind":"leaf","pane_id":2},"second":{"kind":"leaf","pane_id":3}}}
    );
}

test "resizing a split rejects invalid markers and ratios" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    testing::expect(!core.resize_split(1, 99, 0.4));
    testing::expect(!core.resize_split(1, 2, 0.0 / 0.0));
    testing::expect(!core.resize_split(1, 2, 0.01));
    testing::expect(!core.resize_split(1, 1, 0.4));
    try expect_tab(allocator, &core, 2, "[1,2]",
        \\{"kind":"split","axis":"vertical","ratio":0.5,"first":{"kind":"leaf","pane_id":1},"second":{"kind":"leaf","pane_id":2}}
    );
}

test "center drop swaps panes without changing split geometry" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    testing::expect_equal<i64>(3, try core.split_active(allocator, Axis::Horizontal));
    testing::expect(core.resize_split(1, 2, 0.35));
    testing::expect(core.resize_split(2, 3, 0.65));
    testing::expect(try core.move_pane(allocator, 1, 3, DropPosition::Center));
    try expect_tab(allocator, &core, 1, "[3,2,1]",
        \\{"kind":"split","axis":"vertical","ratio":0.35,"first":{"kind":"leaf","pane_id":3},"second":{"kind":"split","axis":"horizontal","ratio":0.65,"first":{"kind":"leaf","pane_id":2},"second":{"kind":"leaf","pane_id":1}}}
    );
}

test "edge drop reparents a pane and invalid moves are atomic" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    testing::expect_equal<i64>(3, try core.split_active(allocator, Axis::Horizontal));
    testing::expect(try core.move_pane(allocator, 1, 3, DropPosition::Bottom));
    let want =
        \\{"kind":"split","axis":"horizontal","ratio":0.5,"first":{"kind":"leaf","pane_id":2},"second":{"kind":"split","axis":"horizontal","ratio":0.5,"first":{"kind":"leaf","pane_id":3},"second":{"kind":"leaf","pane_id":1}}}
    ;
    try expect_tab(allocator, &core, 1, "[2,3,1]", want);
    testing::expect(!try core.move_pane(allocator, 1, 1, DropPosition::Left));
    testing::expect(!try core.move_pane(allocator, 99, 2, DropPosition::Right));
    try expect_tab(allocator, &core, 1, "[2,3,1]", want);
}

/// Splits pane 1 vertically at 0.35 and drops pane 1 on pane 2 at position.
fn dropped_on_sibling(allocator: Allocator, position: DropPosition, layout: []u8) -> !void {
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    testing::expect(core.resize_split(1, 2, 0.35));
    testing::expect(try core.move_pane(allocator, 1, 2, position));
    return expect_snapshot(allocator, &core, layout);
}

test "edge drop maps every visual side to the expected split" {
    let allocator = mem::page_allocator();
    try dropped_on_sibling(allocator, DropPosition::Left,
        \\{"active_tab":0,"tabs":[{"id":1,"index":0,"title":"session 1","active_pane":1,"theme":"Graphite","panes":[1,2],"layout":{"kind":"split","axis":"vertical","ratio":0.35,"first":{"kind":"leaf","pane_id":1},"second":{"kind":"leaf","pane_id":2}}}]}
    );
    try dropped_on_sibling(allocator, DropPosition::Right,
        \\{"active_tab":0,"tabs":[{"id":1,"index":0,"title":"session 1","active_pane":1,"theme":"Graphite","panes":[2,1],"layout":{"kind":"split","axis":"vertical","ratio":0.35,"first":{"kind":"leaf","pane_id":2},"second":{"kind":"leaf","pane_id":1}}}]}
    );
    try dropped_on_sibling(allocator, DropPosition::Top,
        \\{"active_tab":0,"tabs":[{"id":1,"index":0,"title":"session 1","active_pane":1,"theme":"Graphite","panes":[1,2],"layout":{"kind":"split","axis":"horizontal","ratio":0.5,"first":{"kind":"leaf","pane_id":1},"second":{"kind":"leaf","pane_id":2}}}]}
    );
    try dropped_on_sibling(allocator, DropPosition::Bottom,
        \\{"active_tab":0,"tabs":[{"id":1,"index":0,"title":"session 1","active_pane":1,"theme":"Graphite","panes":[2,1],"layout":{"kind":"split","axis":"horizontal","ratio":0.5,"first":{"kind":"leaf","pane_id":2},"second":{"kind":"leaf","pane_id":1}}}]}
    );
}

test "selecting a visible split pane updates focus" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Horizontal));
    testing::expect(core.select_pane(1));
    testing::expect(!core.select_pane(99));
    try expect_tab(allocator, &core, 1, "[1,2]",
        \\{"kind":"split","axis":"horizontal","ratio":0.5,"first":{"kind":"leaf","pane_id":1},"second":{"kind":"leaf","pane_id":2}}
    );
}

test "finds neighboring panes in a grid without wrapping" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    testing::expect(core.select_pane(1));
    testing::expect_equal<i64>(3, try core.split_active(allocator, Axis::Horizontal));
    testing::expect(core.select_pane(2));
    testing::expect_equal<i64>(4, try core.split_active(allocator, Axis::Horizontal));

    testing::expect(core.select_pane(1));
    testing::expect_equal<i64>(-1, try core.pane_in_direction(allocator, Direction::Left));
    testing::expect_equal<i64>(-1, try core.pane_in_direction(allocator, Direction::Up));
    testing::expect_equal<i64>(2, try core.pane_in_direction(allocator, Direction::Right));
    testing::expect_equal<i64>(3, try core.pane_in_direction(allocator, Direction::Down));

    testing::expect(core.select_pane(4));
    testing::expect_equal<i64>(3, try core.pane_in_direction(allocator, Direction::Left));
    testing::expect_equal<i64>(2, try core.pane_in_direction(allocator, Direction::Up));
    testing::expect_equal<i64>(-1, try core.pane_in_direction(allocator, Direction::Right));
    testing::expect_equal<i64>(-1, try core.pane_in_direction(allocator, Direction::Down));
}

test "chooses the nearest aligned pane in an unbalanced layout" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    testing::expect_equal<i64>(3, try core.split_active(allocator, Axis::Horizontal));
    testing::expect(core.select_pane(1));
    testing::expect_equal<i64>(2, try core.pane_in_direction(allocator, Direction::Right));
    testing::expect(core.select_pane(2));
    testing::expect_equal<i64>(3, try core.pane_in_direction(allocator, Direction::Down));
    testing::expect(core.select_pane(3));
    testing::expect_equal<i64>(1, try core.pane_in_direction(allocator, Direction::Left));
    testing::expect_equal<i64>(2, try core.pane_in_direction(allocator, Direction::Up));
}

test "closing a split pane selects the remaining pane" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(2, try core.split_active(allocator, Axis::Vertical));
    testing::expect(try core.close_pane(allocator, 2));
    try expect_tab(allocator, &core, 1, "[1]",
        \\{"kind":"leaf","pane_id":1}
    );
}

test "closing the last pane removes the tab and selects a neighbor" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(1, try core.new_tab(allocator));
    testing::expect(try core.close_pane(allocator, 2));
    try expect_tab(allocator, &core, 1, "[1]",
        \\{"kind":"leaf","pane_id":1}
    );
}

/// Writes the tab ids in order and the active tab's id after them.
fn expect_tab_order(allocator: Allocator, core: &Core, want: []u8) -> !void {
    var got = string::new(allocator);
    defer got.deinit(allocator);
    var index = 0;
    while core.tabs.at(index) |tab| {
        try fmt::append_i64(allocator, &var got, tab.id);
        try got.append_bytes(allocator, " ");
        index = index + 1;
    }
    try got.append_bytes(allocator, "active ");
    if core.tabs.at(core.active_tab) |active| {
        try fmt::append_i64(allocator, &var got, active.id);
    }
    let bytes = got.as_bytes();
    if !mem::equal_bytes(bytes, want) {
        testing::fail(bytes);
    }
    return;
}

test "moving a tab preserves the active tab identity" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(1, try core.new_tab(allocator));
    testing::expect_equal<i64>(2, try core.new_tab(allocator));
    testing::expect(core.move_tab(1, 2));
    try expect_tab_order(allocator, &core, "2 3 1 active 3");
    testing::expect(core.move_tab(1, 0));
    try expect_tab_order(allocator, &core, "1 2 3 active 3");
}

test "moving a tab rejects unknown ids and out of range indexes" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect_equal<i64>(1, try core.new_tab(allocator));
    testing::expect(!core.move_tab(99, 0));
    testing::expect(!core.move_tab(1, 2));
    try expect_tab_order(allocator, &core, "1 2 active 2");
}

test "renaming a tab refuses a blank title" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    testing::expect(!try core.rename_tab(allocator, 0, "   "));
    testing::expect(!try core.rename_tab(allocator, 5, "work"));
    testing::expect(try core.rename_tab(allocator, 0, " work "));
    try expect_snapshot(allocator, &core,
        \\{"active_tab":0,"tabs":[{"id":1,"index":0,"title":" work ","active_pane":1,"theme":"Graphite","panes":[1],"layout":{"kind":"leaf","pane_id":1}}]}
    );
}

test "applies a validated external workspace with its ratio" {
    let allocator = mem::page_allocator();
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    try core.apply_workspace(allocator,
        \\{"active_tab":0,"tabs":[{"id":90,"title":"tmux","active_pane":902,"theme":"Harbor","panes":[901,902],"layout":{"kind":"split","axis":"vertical","ratio":0.4,"first":{"kind":"leaf","pane_id":901},"second":{"kind":"leaf","pane_id":902}}}]}
    );
    try expect_snapshot(allocator, &core,
        \\{"active_tab":0,"tabs":[{"id":90,"index":0,"title":"tmux","active_pane":902,"theme":"Harbor","panes":[901,902],"layout":{"kind":"split","axis":"vertical","ratio":0.4,"first":{"kind":"leaf","pane_id":901},"second":{"kind":"leaf","pane_id":902}}}]}
    );
    testing::expect_equal<i64>(1, try core.new_tab(allocator));
    testing::expect_equal<i64>(904, try core.split_active(allocator, Axis::Vertical));
}

/// Applies document and expects it refused with the core unchanged.
fn expect_refused(allocator: Allocator, document: []u8) -> !void {
    var core = try fresh(allocator);
    defer core.deinit(allocator);
    if core.apply_workspace(allocator, document) {
        testing::fail(document);
    } else |_| {}
    return expect_tab(allocator, &core, 1, "[1]",
        \\{"kind":"leaf","pane_id":1}
    );
}

test "refuses an invalid workspace whole" {
    let allocator = mem::page_allocator();
    try expect_refused(allocator, "not json");
    try expect_refused(allocator,
        \\{"active_tab":0,"tabs":[]}
    );
    try expect_refused(allocator,
        \\{"active_tab":1,"tabs":[{"id":1,"title":"a","active_pane":1,"theme":"","panes":[1],"layout":{"kind":"leaf","pane_id":1}}]}
    );
    try expect_refused(allocator,
        \\{"active_tab":0,"tabs":[{"id":1,"title":"a","active_pane":2,"theme":"","panes":[1],"layout":{"kind":"leaf","pane_id":1}}]}
    );
    try expect_refused(allocator,
        \\{"active_tab":0,"tabs":[{"id":1,"title":"a","active_pane":1,"theme":"","panes":[1,2],"layout":{"kind":"leaf","pane_id":1}}]}
    );
    try expect_refused(allocator,
        \\{"active_tab":0,"tabs":[{"id":1,"title":"a","active_pane":1,"theme":"","panes":[1],"layout":{"kind":"leaf","pane_id":1}},{"id":2,"title":"b","active_pane":1,"theme":"","panes":[1],"layout":{"kind":"leaf","pane_id":1}}]}
    );
    try expect_refused(allocator,
        \\{"active_tab":0,"tabs":[{"id":1,"title":"a","active_pane":1,"theme":"","panes":[1,2],"layout":{"kind":"split","axis":"vertical","ratio":0.99,"first":{"kind":"leaf","pane_id":1},"second":{"kind":"leaf","pane_id":2}}}]}
    );
}
