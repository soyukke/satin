import std::machine;
import std::mem;
import std::string;
import std::testing;

// Reads `\e` as ESC and `\a` as BEL, which a string literal cannot hold.
fn escaped(allocator: Allocator, text: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while index < mem::len(text) {
        if text[index] == cast<u8>(92) and index + 1 < mem::len(text) {
            let next = text[index + 1];
            if next == cast<u8>(101) {
                try out.append_byte(allocator, cast<u8>(27));
            } else if next == cast<u8>(97) {
                try out.append_byte(allocator, cast<u8>(7));
            } else {
                try out.append_byte(allocator, next);
            }
            index = index + 2;
        } else {
            try out.append_byte(allocator, text[index]);
            index = index + 1;
        }
    }
    return move out;
}

fn feed(allocator: Allocator, tracker: &var PromptTracker, text: []u8) -> !void {
    let input = try escaped(allocator, text);
    defer input.deinit(allocator);
    let bytes = input.as_bytes();
    return tracker.feed(allocator, bytes);
}

test "counts one ready prompt per prompt" {
    let allocator = mem::page_allocator();
    var tracker = new_prompt_tracker(allocator);
    defer tracker.deinit(allocator);
    try feed(allocator, &var tracker, "\e]133;C\e\\");
    testing::expect(tracker.observed);
    testing::expect_equal<u64>(0, tracker.ready_generation);

    try feed(allocator, &var tracker, "\e]133;B");
    testing::expect_equal<u64>(0, tracker.ready_generation);
    try feed(allocator, &var tracker, "\e\\");
    testing::expect_equal<u64>(1, tracker.ready_generation);

    try feed(allocator, &var tracker, "\e]0;133;B\a");
    testing::expect_equal<u64>(1, tracker.ready_generation);
    try feed(allocator, &var tracker, "\e]133;B;fresh\a");
    testing::expect_equal<u64>(1, tracker.ready_generation);

    try feed(allocator, &var tracker, "\e]133;A\e\\prompt> \e]133;B\a");
    testing::expect_equal<u64>(2, tracker.ready_generation);
    try feed(allocator, &var tracker, "\e]133;B");
    try feed(allocator, &var tracker, ";duplicate\e\\");
    testing::expect_equal<u64>(2, tracker.ready_generation);

    try feed(allocator, &var tracker, "\e]133;D;0\e\\\e]133;B\e\\");
    testing::expect_equal<u64>(3, tracker.ready_generation);
}

test "reset forgets the marks" {
    let allocator = mem::page_allocator();
    var tracker = new_prompt_tracker(allocator);
    defer tracker.deinit(allocator);
    try feed(allocator, &var tracker, "\e]133;A\e\\\e]133;B\e\\");
    testing::expect_equal<u64>(1, tracker.ready_generation);
    tracker.reset();
    testing::expect(!tracker.observed);
    testing::expect_equal<u64>(0, tracker.ready_generation);
}

test "counts the commands a shell runs and how they ended" {
    let allocator = mem::page_allocator();
    var tracker = new_prompt_tracker(allocator);
    defer tracker.deinit(allocator);
    try feed(allocator, &var tracker, "\e]133;D;0\e\\");
    testing::expect_equal<u64>(0, tracker.commands_finished);

    try feed(allocator, &var tracker, "\e]133;C\e\\");
    testing::expect_equal<u64>(1, tracker.commands_started);
    testing::expect_equal<u64>(0, tracker.commands_finished);
    try feed(allocator, &var tracker, "\e]133;D;127\a");
    testing::expect_equal<u64>(1, tracker.commands_finished);
    testing::expect_equal<i64>(127, tracker.last_exit);
    try feed(allocator, &var tracker, "\e]133;D;0\a");
    testing::expect_equal<u64>(1, tracker.commands_finished);

    try feed(allocator, &var tracker, "\e]133;C\a\e]133;D;0;aid=1\a");
    testing::expect_equal<u64>(2, tracker.commands_finished);
    testing::expect_equal<i64>(0, tracker.last_exit);
    try feed(allocator, &var tracker, "\e]133;C\a\e]133;D\a");
    testing::expect_equal<i64>(-1, tracker.last_exit);

    tracker.reset();
    testing::expect_equal<u64>(0, tracker.commands_started);
    testing::expect_equal<i64>(-1, tracker.last_exit);
}

test "a prompt that comes back ends the command that marked no end" {
    let allocator = mem::page_allocator();
    var tracker = new_prompt_tracker(allocator);
    defer tracker.deinit(allocator);
    // The prompt start is enough, and the input start after it counts no
    // second finish.
    try feed(allocator, &var tracker, "\e]133;C\a\e]133;D;3\a\e]133;C\a\e]133;A\a");
    testing::expect_equal<u64>(2, tracker.commands_started);
    testing::expect_equal<u64>(2, tracker.commands_finished);
    testing::expect_equal<i64>(-1, tracker.last_exit);
    try feed(allocator, &var tracker, "\e]133;B\a");
    testing::expect_equal<u64>(2, tracker.commands_finished);
    testing::expect_equal<u64>(1, tracker.ready_generation);

    // So is an input start alone, which still counts its prompt.
    try feed(allocator, &var tracker, "\e]133;C\a\e]133;B\a");
    testing::expect_equal<u64>(3, tracker.commands_finished);
    testing::expect_equal<u64>(2, tracker.ready_generation);
    // The end that comes late has no command left to end.
    try feed(allocator, &var tracker, "\e]133;D;0\a");
    testing::expect_equal<u64>(3, tracker.commands_finished);
    testing::expect_equal<i64>(-1, tracker.last_exit);
}

fn machine_next(state: PromptState, byte: PromptByte) -> PromptState {
    return prompt_advance(state, byte).state;
}

fn machine_outcome(state: PromptState, byte: PromptByte) -> PromptOutcome {
    return prompt_advance(state, byte).outcome;
}

// The tracker reads output for as long as the pane lives.
fn machine_never_ends(state: PromptState) -> bool {
    return false;
}

test "every state of the byte machine is reached" {
    let allocator = mem::page_allocator();
    let table = try machine::answers<PromptState, PromptByte, PromptOutcome>(
        allocator,
        machine_next,
        machine_outcome,
        PromptState::Ground,
        machine_never_ends
    );
    defer table.deinit(allocator);
    var problems = try table.problems(allocator);
    defer problems.deinit(allocator);
    if problems.at(0) |line| {
        let bytes = line.as_bytes();
        testing::fail(bytes);
    }
}

test "an escape held in a payload is kept unless a backslash follows" {
    let allocator = mem::page_allocator();
    var tracker = new_prompt_tracker(allocator);
    defer tracker.deinit(allocator);
    // BEL after the held ESC does not end the payload: both are kept, and
    // the mark is read when the terminator comes.
    try feed(allocator, &var tracker, "\e]133;B\e\a");
    testing::expect_equal<u64>(0, tracker.ready_generation);
    try feed(allocator, &var tracker, "\e\\\\");
    testing::expect_equal<u64>(1, tracker.ready_generation);
}

fn mark_machine_next(phase: PromptPhase, mark: PromptMark) -> PromptPhase {
    return prompt_mark_advance(phase, mark).state;
}

fn mark_machine_outcome(phase: PromptPhase, mark: PromptMark) -> PromptCount {
    return prompt_mark_advance(phase, mark).outcome;
}

// The shell goes on printing marks for as long as the pane lives.
fn mark_machine_never_ends(phase: PromptPhase) -> bool {
    return false;
}

test "every phase of the mark machine is reached" {
    let allocator = mem::page_allocator();
    let table = try machine::answers<PromptPhase, PromptMark, PromptCount>(
        allocator,
        mark_machine_next,
        mark_machine_outcome,
        PromptPhase::Unseen,
        mark_machine_never_ends
    );
    defer table.deinit(allocator);
    var problems = try table.problems(allocator);
    defer problems.deinit(allocator);
    if problems.at(0) |line| {
        let bytes = line.as_bytes();
        testing::fail(bytes);
    }
}

fn mark_is(payload: []u8, expected: PromptMark) -> bool {
    if prompt_mark(payload) |mark| {
        return mark == expected;
    }
    return false;
}

fn no_mark(payload: []u8) -> bool {
    if prompt_mark(payload) |_| {
        return false;
    }
    return true;
}

test "only an OSC 133 payload is a mark" {
    testing::expect(no_mark("0;133;B"));
    testing::expect(no_mark("133"));
    testing::expect(mark_is("133;", PromptMark::OtherMark));
    testing::expect(mark_is("133;A", PromptMark::PromptStart));
    testing::expect(mark_is("133;B;fresh", PromptMark::InputStart));
    testing::expect(mark_is("133;C", PromptMark::CommandStart));
    testing::expect(mark_is("133;D;0", PromptMark::CommandEnd));
    testing::expect(mark_is("133;P;k=i", PromptMark::OtherMark));
}
