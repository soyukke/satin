// Shell prompt tracking over terminal output: the OSC 133 semantic prompt
// marks a shell writes, read far enough to know when a fresh prompt is ready
// for input. The Rust `SemanticPromptTracker`.
import std::mem;
import std::string;

fn max_payload_bytes() -> i64 {
    return 64;
}

/// Where the tracker is in the bytes of an OSC sequence.
pub enum PromptState {
    /// Outside any sequence.
    Ground,
    /// After an ESC that may open a sequence.
    Escape,
    /// Inside an OSC payload.
    Payload,
    /// After an ESC inside a payload, which a backslash makes its end.
    PayloadEscape,
}

/// A byte, as far as the tracker tells bytes apart.
pub enum PromptByte {
    Esc,
    /// `]`, which after an ESC opens an OSC payload.
    Bracket,
    /// BEL, which ends a payload.
    Bell,
    /// `\`, which after an ESC ends a payload.
    Backslash,
    Other,
}

/// What a byte does to the payload being collected.
pub enum PromptOutcome {
    /// The byte is outside any payload and is dropped.
    Skipped,
    /// A payload starts, empty.
    Opened,
    /// The byte joins the payload.
    Kept,
    /// An ESC inside a payload waits for the byte after it.
    Held,
    /// The held ESC joins the payload and this ESC is held in its place.
    KeptHeld,
    /// The held ESC and the byte join the payload.
    KeptBoth,
    /// The payload ends and is read.
    Finished,
}

/// The state a byte leaves the tracker in, and what it did to the payload.
pub struct PromptStep {
    pub state: PromptState,
    pub outcome: PromptOutcome,
}

pub fn prompt_byte(byte: u8) -> PromptByte {
    if byte == cast<u8>(27) {
        return PromptByte::Esc;
    }
    if byte == cast<u8>(93) {
        return PromptByte::Bracket;
    }
    if byte == cast<u8>(7) {
        return PromptByte::Bell;
    }
    if byte == cast<u8>(92) {
        return PromptByte::Backslash;
    }
    return PromptByte::Other;
}

/// The tracker's byte machine, whole: `feed` does what this says and nothing
/// else decides a state. spec/ reads its table out of this function.
pub fn prompt_advance(state: PromptState, byte: PromptByte) -> PromptStep {
    match state {
        Ground => match byte {
            Esc => return PromptStep { state: PromptState::Escape, outcome: PromptOutcome::Skipped },
            _ => return PromptStep { state: PromptState::Ground, outcome: PromptOutcome::Skipped },
        },
        Escape => match byte {
            Bracket => return PromptStep { state: PromptState::Payload, outcome: PromptOutcome::Opened },
            Esc => return PromptStep { state: PromptState::Escape, outcome: PromptOutcome::Skipped },
            _ => return PromptStep { state: PromptState::Ground, outcome: PromptOutcome::Skipped },
        },
        Payload => match byte {
            Bell => return PromptStep { state: PromptState::Ground, outcome: PromptOutcome::Finished },
            Esc => return PromptStep { state: PromptState::PayloadEscape, outcome: PromptOutcome::Held },
            _ => return PromptStep { state: PromptState::Payload, outcome: PromptOutcome::Kept },
        },
        PayloadEscape => match byte {
            Backslash => return PromptStep { state: PromptState::Ground, outcome: PromptOutcome::Finished },
            Esc => return PromptStep { state: PromptState::PayloadEscape, outcome: PromptOutcome::KeptHeld },
            _ => return PromptStep { state: PromptState::Payload, outcome: PromptOutcome::KeptBoth },
        },
    }
}

/// Where the shell is between its OSC 133 marks.
pub enum PromptPhase {
    /// No mark has come yet.
    Unseen,
    /// A prompt is being drawn, or a command has ended: not ready for input.
    Drawing,
    /// The prompt is ready for input, and has been counted.
    Ready,
    /// A command is running.
    Running,
    /// A prompt was counted ready while a command had not reported its end.
    ReadyRunning,
}

/// An OSC 133 mark, as far as the tracker tells marks apart.
pub enum PromptMark {
    /// `133;A`: the shell starts drawing a prompt.
    PromptStart,
    /// `133;B`: the prompt is drawn and input starts.
    InputStart,
    /// `133;C`: a command starts running.
    CommandStart,
    /// `133;D`: the command ended.
    CommandEnd,
    /// Any other `133;` payload.
    OtherMark,
}

/// What a mark adds to the tracker's counts.
pub enum PromptCount {
    /// Nothing is counted.
    Noted,
    /// One more prompt became ready for input.
    ReadyCounted,
    /// One more command started.
    CommandStarted,
    /// One more started command finished, and its exit status is read.
    CommandFinished,
}

/// The phase a mark leaves the tracker in, and what it counted.
pub struct PromptMarkStep {
    pub state: PromptPhase,
    pub outcome: PromptCount,
}

/// The mark an OSC payload carries; null for a payload that is not OSC 133.
pub fn prompt_mark(payload: []u8) -> ?PromptMark {
    if !mem::starts_with(payload, "133;") {
        return null;
    }
    if mem::len(payload) == 4 {
        return PromptMark::OtherMark;
    }
    let command = payload[4];
    if command == cast<u8>(65) {
        return PromptMark::PromptStart;
    }
    if command == cast<u8>(66) {
        return PromptMark::InputStart;
    }
    if command == cast<u8>(67) {
        return PromptMark::CommandStart;
    }
    if command == cast<u8>(68) {
        return PromptMark::CommandEnd;
    }
    return PromptMark::OtherMark;
}

fn mark_step(state: PromptPhase, outcome: PromptCount) -> PromptMarkStep {
    return PromptMarkStep { state: state, outcome: outcome };
}

/// The tracker's mark machine, whole: a prompt is counted ready once, at its
/// first `B` after an `A`, `C` or `D`, and a command finishes only if it
/// started. `finish_payload` does what this says and nothing else decides a
/// phase. spec/ reads its table out of this function.
pub fn prompt_mark_advance(phase: PromptPhase, mark: PromptMark) -> PromptMarkStep {
    match mark {
        // A new command starts whatever came before, and its prompt is over.
        CommandStart => return mark_step(PromptPhase::Running, PromptCount::CommandStarted),
        CommandEnd => match phase {
            Running => return mark_step(PromptPhase::Drawing, PromptCount::CommandFinished),
            ReadyRunning => return mark_step(PromptPhase::Drawing, PromptCount::CommandFinished),
            // An end with no command started counts nothing.
            _ => return mark_step(PromptPhase::Drawing, PromptCount::Noted),
        },
        PromptStart => match phase {
            // A prompt drawn while a command has not ended leaves it running.
            Running => return mark_step(PromptPhase::Running, PromptCount::Noted),
            ReadyRunning => return mark_step(PromptPhase::Running, PromptCount::Noted),
            _ => return mark_step(PromptPhase::Drawing, PromptCount::Noted),
        },
        InputStart => match phase {
            Unseen => return mark_step(PromptPhase::Ready, PromptCount::ReadyCounted),
            Drawing => return mark_step(PromptPhase::Ready, PromptCount::ReadyCounted),
            Running => return mark_step(PromptPhase::ReadyRunning, PromptCount::ReadyCounted),
            // The same prompt's second `B` is not another prompt.
            Ready => return mark_step(PromptPhase::Ready, PromptCount::Noted),
            ReadyRunning => return mark_step(PromptPhase::ReadyRunning, PromptCount::Noted),
        },
        OtherMark => match phase {
            Unseen => return mark_step(PromptPhase::Drawing, PromptCount::Noted),
            _ => return mark_step(phase, PromptCount::Noted),
        },
    }
}

pub struct PromptTracker {
    state: PromptState,
    payload: string::String,
    /// Whether the output carried any OSC 133 mark.
    pub observed: bool,
    /// Counts the prompts that became ready for input, once per prompt.
    pub ready_generation: u64,
    /// Counts the commands the shell started running (`133;C`).
    pub commands_started: u64,
    /// Counts the started commands that finished (`133;D`).
    pub commands_finished: u64,
    /// The exit status the last finished command reported, or -1 when its
    /// mark carried none.
    pub last_exit: i64,
    phase: PromptPhase,
}

pub fn (self: PromptTracker) deinit(allocator: Allocator) -> void {
    self.payload.deinit(allocator);
}

pub fn new_prompt_tracker(allocator: Allocator) -> PromptTracker {
    return PromptTracker {
        state: PromptState::Ground,
        payload: string::new(allocator),
        observed: false,
        ready_generation: 0,
        commands_started: 0,
        commands_finished: 0,
        last_exit: -1,
        phase: PromptPhase::Unseen
    };
}

/// Forgets every mark seen so far, as a fresh tracker would.
pub fn (self: &var PromptTracker) reset() -> void {
    self.payload.clear();
    self.state = PromptState::Ground;
    self.observed = false;
    self.ready_generation = 0;
    self.commands_started = 0;
    self.commands_finished = 0;
    self.last_exit = -1;
    self.phase = PromptPhase::Unseen;
}

pub fn (self: &var PromptTracker) feed(allocator: Allocator, bytes: []u8) -> mem::Error!void {
    var index = 0;
    while index < mem::len(bytes) {
        try self.feed_byte(allocator, bytes[index]);
        index = index + 1;
    }
    return;
}

fn (self: &var PromptTracker) feed_byte(allocator: Allocator, byte: u8) -> mem::Error!void {
    let escape = cast<u8>(27);
    let step = prompt_advance(self.state, prompt_byte(byte));
    match step.outcome {
        Skipped => {},
        Held => {},
        Opened => self.payload.clear(),
        Kept => try self.push_payload_byte(allocator, byte),
        KeptHeld => try self.push_payload_byte(allocator, escape),
        KeptBoth => {
            try self.push_payload_byte(allocator, escape);
            try self.push_payload_byte(allocator, byte);
        },
        Finished => self.finish_payload(),
    }
    self.state = step.state;
    return;
}

fn (self: &var PromptTracker) push_payload_byte(allocator: Allocator, byte: u8) -> mem::Error!void {
    if self.payload.len() < max_payload_bytes() {
        try self.payload.append_byte(allocator, byte);
    }
    return;
}

fn (self: &var PromptTracker) finish_payload() -> void {
    let bytes = self.payload.as_bytes();
    let mark = prompt_mark(bytes) orelse return;
    let step = prompt_mark_advance(self.phase, mark);
    match step.outcome {
        Noted => {},
        ReadyCounted => {
            self.ready_generation = self.ready_generation + 1;
        },
        CommandStarted => {
            self.commands_started = self.commands_started + 1;
        },
        CommandFinished => {
            self.commands_finished = self.commands_finished + 1;
            self.last_exit = exit_status(bytes);
        },
    }
    self.phase = step.state;
    self.observed = true;
    return;
}

/// The exit status in a `133;D;N` mark, or -1 when it carries none.
fn exit_status(bytes: []u8) -> i64 {
    if mem::len(bytes) < 7 or bytes[5] != cast<u8>(59) {
        return -1;
    }
    var value: i64 = 0;
    var index = 6;
    while index < mem::len(bytes) and bytes[index] != cast<u8>(59) {
        let digit = bytes[index];
        if digit < cast<u8>(48) or digit > cast<u8>(57) or value > 100000 {
            return -1;
        }
        value = value * 10 + cast<i64>(digit - cast<u8>(48));
        index = index + 1;
    }
    return value;
}
