    entered.deinit(allocator);
    try expect_event(allocator, &var control,
        \\{"kind":"protocol_error","message":"malformed tmux output record"}
    );
    try expect_outgoing(allocator, &var control, "detach-client\n");
}

fn admitted(allocator: Allocator) -> Control {
    var control = new_control(allocator);
    control.active = true;
    control.control_client_admitted = true;
    return move control;
}

test "rejected tmux commands are reported without detaching" {
    let allocator = mem::page_allocator();
    var control = admitted(allocator);
    defer control.deinit(allocator);
    testing::expect(try control.command(allocator, "not-a-command"));
    try feed_quiet(allocator, &var control, "%begin 1 2 0\nunknown command: not-a-command\n%error 1 2 0\n");
    try expect_event(allocator, &var control,
        \\{"kind":"command_error","message":"unknown command: not-a-command"}
    );
    testing::expect(control.is_active());
}

test "lines ending in repeated carriage returns are read whole" {
