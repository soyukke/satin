        \\{"kind":"sessions","sessions":[{"session_id":0,"name":"alpha","window_count":2,"socket_path":"/tmp/tmux.sock","server_pid":4242},{"session_id":1,"name":"beta","window_count":1,"socket_path":"/tmp/tmux.sock","server_pid":4242}],"session_error":null}
    );
