test "the topology sync asks for every field in order" {
    let allocator = mem::page_allocator();
    var control = admitted(allocator);
    defer control.deinit(allocator);
    try control.request_sync(allocator);
    try expect_outgoing(allocator, &var control,
        "list-panes -s -F '#{q:session_id}\t#{q:session_name}\t#{q:socket_path}\t#{q:window_id}\t#{q:window_index}\t#{q:window_name}\t#{q:window_active}\t#{q:window_visible_layout}\t#{q:window_zoomed_flag}\t#{q:pane_id}\t#{q:pane_index}\t#{q:pane_active}\t#{q:pane_current_path}\t#{q:pane_width}\t#{q:pane_height}\t#{q:cursor_x}\t#{q:cursor_y}\t#{q:cursor_flag}\t#{q:cursor_shape}\t#{q:cursor_blinking}\t#{q:history_size}\t#{q:alternate_on}\t#{q:insert_flag}\t#{q:keypad_cursor_flag}\t#{q:keypad_flag}\t#{q:origin_flag}\t#{q:wrap_flag}\t#{q:mouse_standard_flag}\t#{q:mouse_button_flag}\t#{q:mouse_any_flag}\t#{q:mouse_utf8_flag}\t#{q:mouse_sgr_flag}\t#{q:pane_input_off}\t#{q:scroll_region_upper}\t#{q:scroll_region_lower}\t#{q:pid}\t#{q:pane_private_modes}\t#{q:pane_key_mode}\t#{q:pane_current_command}\t#{q:pane_title}\t#{q:allow-passthrough}'\n"
    );
}

test "a duplicate control client is rejected without waiting" {
    let allocator = mem::page_allocator();
    var control = new_control(allocator);
    defer control.deinit(allocator);
    try feed_quiet(allocator, &var control, "\eP1000p%begin 1 1 0\n%end 1 1 0\n");
    try expect_outgoing_prefix(allocator, &var control, "list-clients");
    try feed_quiet(allocator, &var control, "%begin 1 2 0\n1\n1\n%end 1 2 0\n");
    let entered = try expect_event_kind(allocator, &var control, "entered");
    entered.deinit(allocator);
    try expect_event(allocator, &var control,
        \\{"kind":"protocol_error","message":"this tmux session already has another control-mode client"}
    );
    try expect_outgoing(allocator, &var control, "detach-client\n");
}

test "a later control client attachment revokes the projection" {
    let allocator = mem::page_allocator();
    var control = admitted(allocator);
    defer control.deinit(allocator);
    try feed_quiet(allocator, &var control, "%subscription-changed satin-session-clients $0 : /dev/ttys001\n");
    try expect_outgoing_prefix(allocator, &var control, "list-clients");
    try feed_quiet(allocator, &var control, "%begin 1 2 0\n1\n1\n%end 1 2 0\n");
    let error = try expect_event_kind(allocator, &var control, "protocol_error");
    error.deinit(allocator);
    try expect_outgoing(allocator, &var control, "detach-client\n");
}

test "a topology change while a snapshot is pending queues a trailing sync" {
    let allocator = mem::page_allocator();
    var control = admitted(allocator);
    defer control.deinit(allocator);
    try control.hydrated_panes.append(allocator, 7);
    try control.request_sync(allocator);
    try expect_outgoing_prefix(allocator, &var control, "list-panes -s");
    try feed_quiet(allocator, &var control, "%layout-change @1 changed\n");
    try expect_no_outgoing(allocator, &var control);
    let row = try snapshot_row(allocator, "/tmp", 0, false, false);
    defer row.deinit(allocator);
    try feed_response(allocator, &var control, "1 2 0", &row);
    try expect_outgoing_prefix(allocator, &var control, "list-panes -s");
    testing::expect(control.sync_pending);
    testing::expect(!control.sync_requested_while_pending);
}

test "rehydration forwards live scroll metadata without replaying cells" {
    let allocator = mem::page_allocator();
    var control = new_control(allocator);
    defer control.deinit(allocator);
    try control.rehydrating_panes.append(allocator, 7);
    let first = try b(allocator, "updated cells\e[1;22r\e[H\e[");
    defer first.deinit(allocator);
    let first_bytes = first.as_bytes();
    try control.push_output(allocator, 7, first_bytes);
    try expect_no_event(allocator, &var control);
    let second = try b(allocator, "11M\e[1;24r");
    defer second.deinit(allocator);
    let second_bytes = second.as_bytes();
    try control.push_output(allocator, 7, second_bytes);
    try expect_event(allocator, &var control,
        \\{"kind":"pane_scroll_metadata","pane_id":7,"rows":11,"region_top":1,"region_bottom":22,"region_left":null,"region_right":null}
    );
    try expect_no_event(allocator, &var control);
}

test "an exit without a reason reports null" {
    let allocator = mem::page_allocator();
    var control = new_control(allocator);
    defer control.deinit(allocator);
    try feed_quiet(allocator, &var control, "\eP1000p%exit\n");
    let entered = try expect_event_kind(allocator, &var control, "entered");
    entered.deinit(allocator);
    try expect_event(allocator, &var control,
        \\{"kind":"exited","reason":null}
    );
}
