test "session fields decode tmux q escapes" {
    let allocator = mem::page_allocator();
    var why = string::new(allocator);
    defer why.deinit(allocator);
    var lines = array::new<string::String>(allocator);
    defer lines.deinit(allocator);
    let line = try b(allocator, "$7|name\\|with\\ space|2|/tmp/tmux\\ socket|4242");
    try lines.append(allocator, move line);
    var sessions = try parse_sessions(allocator, &lines, &var why);
    defer sessions.deinit(allocator);
    if sessions.at(0) |session| {
        testing::expect_equal<i64>(7, session.session_id);
        let name = session.name.as_bytes();
        try expect_bytes(allocator, name, "name|with space");
        let socket = session.socket_path.as_bytes();
        try expect_bytes(allocator, socket, "/tmp/tmux socket");
        testing::expect_equal<i64>(2, session.window_count);
        testing::expect_equal<i64>(4242, session.server_pid);
    }
    var broken = array::new<string::String>(allocator);
    defer broken.deinit(allocator);
    let broken_line = try b(allocator, "$0|broken|1|path\\");
    try broken.append(allocator, move broken_line);
    if parse_sessions(allocator, &broken, &var why) |parsed| {
        parsed.deinit(allocator);
        testing::fail("a row ending in an escape parsed");
    } else |_| {}
}

test "paste uses a binary-safe private tmux buffer" {
    let allocator = mem::page_allocator();
    let row = try snapshot_row(allocator, "/tmp", 0, false, false);
    defer row.deinit(allocator);
    var control = new_control(allocator);
    defer control.deinit(allocator);
    control.active = true;
    let pane = try row_pane(allocator, &row);
    try control.latest_panes.append(allocator, move pane);
    let data = try b(allocator, "a\n'\\\0");
    defer data.deinit(allocator);
    let bytes = data.as_bytes();
    testing::expect(try control.paste(allocator, 7, bytes));
    try expect_outgoing(allocator, &var control, "set-buffer -b satin-7-1 \x22\\141\\012\\047\\134\\000\x22\n");
    try expect_outgoing(allocator, &var control, "paste-buffer -dpr -b satin-7-1 -t %7\n");
}

test "alternate hydration keeps the modes of the alternate screen" {
    let allocator = mem::page_allocator();
    var why = string::new(allocator);
    defer why.deinit(allocator);
    let row = try snapshot_row(allocator, "/tmp", 0, true, false);
    defer row.deinit(allocator);
    let pane = try row_pane(allocator, &row);
    defer pane.deinit(allocator);
    var lines = array::new<string::String>(allocator);
    defer lines.deinit(allocator);
    let marker = try string::from_bytes(allocator, "ALT_MARKER");
    try lines.append(allocator, move marker);
    var backing = array::new<string::String>(allocator);
    defer backing.deinit(allocator);
    let primary = try string::from_bytes(allocator, "PRIMARY_MARKER");
    try backing.append(allocator, move primary);
    var data = string::new(allocator);
    defer data.deinit(allocator);
    try build_hydration(allocator, &lines, true, &backing, &pane, &var data, &var why);
    let bytes = data.as_bytes();
    let paste = try b(allocator, "\e[?2004h");
    defer paste.deinit(allocator);
    let paste_bytes = paste.as_bytes();
    testing::expect(contains(bytes, paste_bytes));
    let keys = try b(allocator, "\e[>4;2m");
    defer keys.deinit(allocator);
    let keys_bytes = keys.as_bytes();
    testing::expect(contains(bytes, keys_bytes));
    let switch = try b(allocator, "PRIMARY_MARKER\e[0m\e[2J\e[1;1HPRIMARY_MARKER\e[?1049hALT_MARKER");
    defer switch.deinit(allocator);
    let switch_bytes = switch.as_bytes();
    testing::expect(contains(bytes, switch_bytes));
}

test "resizing a hydrated pane does not enqueue a full capture" {
    let allocator = mem::page_allocator();
    var why = string::new(allocator);
    defer why.deinit(allocator);
    let old_row = try snapshot_row(allocator, "/tmp", 100000, false, false);
    defer old_row.deinit(allocator);
    let resized_row = try replace_first(allocator, &old_row, "\t80\t24\t", "\t120\t40\t");
    defer resized_row.deinit(allocator);
    var control = admitted(allocator);
    defer control.deinit(allocator);
    try control.hydrated_panes.append(allocator, 7);
    try control.passthrough_attempted_panes.append(allocator, 7);
    let old_pane = try row_pane(allocator, &old_row);
    try control.latest_panes.append(allocator, move old_pane);
    control.sync_pending = true;
    try open_response(allocator, &var control, PendingKind::Snapshot, -1, &resized_row);
    try control.finish_response(allocator, true, &var why);
    testing::expect(set_has(&control.hydrated_panes, 7));
    testing::expect_equal<i64>(0, control.outgoing.len());
    testing::expect(!set_has(&control.capture_pending, 7));
    testing::expect(!set_has(&control.rehydrating_panes, 7));
}

test "initial hydration queues one active pane at a time" {
    let allocator = mem::page_allocator();
    var why = string::new(allocator);
    defer why.deinit(allocator);
    let row = try snapshot_row(allocator, "/tmp", 100000, false, false);
    defer row.deinit(allocator);
    // Pane %8 beside %7 in the active window, and pane %9 in window @3.
    let sibling_row = try replace_first(allocator, &row, "\t%7\t0\t1\t", "\t%8\t1\t0\t");
    defer sibling_row.deinit(allocator);
    let hidden_first = try replace_first(allocator, &row, "@2\t0\tmain\t1\t", "@3\t1\tmain\t0\t");
    defer hidden_first.deinit(allocator);
    let hidden_row = try replace_first(allocator, &hidden_first, "\t%7\t", "\t%9\t");
    defer hidden_row.deinit(allocator);
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_string(allocator, &row);
    try text.append_byte(allocator, cast<u8>(10));
    try text.append_string(allocator, &sibling_row);
    try text.append_byte(allocator, cast<u8>(10));
    try text.append_string(allocator, &hidden_row);
    var lines = try row_lines(allocator, &text);
    defer lines.deinit(allocator);
    var snapshot = try parse_snapshot(allocator, &lines, &var why);
    defer snapshot.deinit(allocator);
    var control = new_control(allocator);
    defer control.deinit(allocator);
    try control.passthrough_attempted_panes.append(allocator, 7);
    try control.passthrough_attempted_panes.append(allocator, 8);
    try control.passthrough_attempted_panes.append(allocator, 9);
    try control.queue_pane_hydrations(allocator, &snapshot);
    testing::expect_equal<i64>(1, control.capture_pending.len());
    testing::expect(set_has(&control.capture_pending, 7));
    testing::expect_equal<i64>(1, control.outgoing.len());
    try expect_outgoing(allocator, &var control, "capture-pane -p -e -C -S -26132 -t %7\n");
}

test "keeps passthrough protocols while a pane is rehydrating" {
    let allocator = mem::page_allocator();
    var control = new_control(allocator);
    defer control.deinit(allocator);
    try control.rehydrating_panes.append(allocator, 7);
    let output = try b(allocator, "duplicate text\ePtmux;\e\e_Ga=T,i=7;AAAA\e\e\\\e\\");
    defer output.deinit(allocator);
    let bytes = output.as_bytes();
    try control.push_output(allocator, 7, bytes);
    try expect_no_event(allocator, &var control);
    set_drop(&var control.rehydrating_panes, 7);
    try control.flush_rehydration_passthrough(allocator, 7);
    // `\e_Ga=T,i=7;AAAA\e\`
    try expect_event(allocator, &var control,
        \\{"kind":"pane_output","pane_id":7,"data":[27,95,71,97,61,84,44,105,61,55,59,65,65,65,65,27,92]}
    );
}

