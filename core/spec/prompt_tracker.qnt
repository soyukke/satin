// GENERATED by scripts/machine-quint. Do not edit.
module prompt_tracker {
  type State = Ground | Escape | Payload | PayloadEscape
  type Event = Esc | Bracket | Bell | Backslash | Other
  type Outcome = Skipped | Opened | Kept | Held | KeptHeld | KeptBoth | Finished

  pure val events: Set[Event] = Set(Esc, Bracket, Bell, Backslash, Other)
  pure val outcomes: Set[Outcome] = Set(Skipped, Opened, Kept, Held, KeptHeld, KeptBoth, Finished)
  pure val ends: Set[State] = Set()

  pure val moves: (State, Event) -> (State, Outcome) = Map(
    (Ground, Esc) -> (Escape, Skipped),
    (Ground, Bracket) -> (Ground, Skipped),
    (Ground, Bell) -> (Ground, Skipped),
    (Ground, Backslash) -> (Ground, Skipped),
    (Ground, Other) -> (Ground, Skipped),
    (Escape, Esc) -> (Escape, Skipped),
    (Escape, Bracket) -> (Payload, Opened),
    (Escape, Bell) -> (Ground, Skipped),
    (Escape, Backslash) -> (Ground, Skipped),
    (Escape, Other) -> (Ground, Skipped),
    (Payload, Esc) -> (PayloadEscape, Held),
    (Payload, Bracket) -> (Payload, Kept),
    (Payload, Bell) -> (Ground, Finished),
    (Payload, Backslash) -> (Payload, Kept),
    (Payload, Other) -> (Payload, Kept),
    (PayloadEscape, Esc) -> (PayloadEscape, KeptHeld),
    (PayloadEscape, Bracket) -> (Payload, KeptBoth),
    (PayloadEscape, Bell) -> (Payload, KeptBoth),
    (PayloadEscape, Backslash) -> (Ground, Finished),
    (PayloadEscape, Other) -> (Payload, KeptBoth),
  )

  var state: State
  var previous: State
  var event: Event
  var outcome: Outcome
  var moved: bool

  action init = all {
    state' = Ground,
    previous' = Ground,
    nondet e = oneOf(events) event' = e,
    nondet o = oneOf(outcomes) outcome' = o,
    moved' = false,
  }

  action take(e: Event): bool = {
    val answer = moves.get((state, e))
    all {
      state' = answer._1,
      previous' = state,
      event' = e,
      outcome' = answer._2,
      moved' = true,
    }
  }

  action anyEvent = {
    nondet e = oneOf(events)
    take(e)
  }

  action onward = {
    val open = events.filter(e => not(ends.contains(moves.get((state, e))._1)))
    all {
      open != Set(),
      nondet e = oneOf(open)
      take(e),
    }
  }

  action step = any { anyEvent, onward }
}
