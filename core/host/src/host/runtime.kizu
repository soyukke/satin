// The C boundary the Swift host calls for a terminal: `satin_runtime_*`,
// the same functions and the same values the Rust library exported.
//
// A runtime lives in malloc storage the host holds as an opaque pointer,
// and the host calls from one thread.
import satin::term;
import satin::tmux;
import std::mem;
import std::string;

fn grid_size(rows: u16, cols: u16, pixel_width: u16, pixel_height: u16) -> term::GridSize {
    return term::GridSize { rows: rows, cols: cols, pixel_width: pixel_width, pixel_height: pixel_height };
}

/// Moves a runtime into malloc storage; null, with the runtime ended, when
/// there is none.
fn boxed(runtime: term::Runtime) -> ?ptr<term::Runtime> {
    // SAFETY: malloc returns storage for one Runtime or null.
    let storage = unsafe malloc(mem::size_of<term::Runtime>());
    if storage |slot| {
        // SAFETY: slot is fresh storage for one Runtime.
        let handle = unsafe cast<ptr<term::Runtime>>(slot);
        // SAFETY: handle is fresh storage for one Runtime; the runtime now lives there.
        unsafe ptr_write(handle, move runtime);
        return handle;
    }
    runtime.deinit(mem::page_allocator());
    return null;
}

fn spawned(size: term::GridSize, config: &term::SpawnConfig) -> ?ptr<term::Runtime> {
    if term::spawn_runtime(mem::page_allocator(), size, config) |runtime| {
        return boxed(move runtime);
    } else |_| {}
    return null;
}

export "c" fn satin_runtime_create(rows: u16, cols: u16, pixel_width: u16, pixel_height: u16) -> ?ptr<term::Runtime> {
    let allocator = mem::page_allocator();
    let config = term::new_spawn_config(allocator);
    defer config.deinit(allocator);
    return spawned(grid_size(rows, cols, pixel_width, pixel_height), &config);
}

export "c" fn satin_runtime_create_in_cwd(
    rows: u16,
    cols: u16,
    pixel_width: u16,
    pixel_height: u16,
    cwd: ?ptr<const u8>
) -> ?ptr<term::Runtime> {
    let allocator = mem::page_allocator();
    var config = term::new_spawn_config(allocator);
    defer config.deinit(allocator);
    if cwd |text| {
        // SAFETY: the host passes a NUL-terminated string that outlives the call.
        let length = unsafe c_length(text);
        // SAFETY: text holds length readable bytes.
        let path = unsafe view_from_ptr(text, length);
        if is_utf8(path) {
            if config.cwd.append_bytes(allocator, path) {
                config.has_cwd = true;
            } else |_| {
                return null;
            }
        }
    }
    return spawned(grid_size(rows, cols, pixel_width, pixel_height), &config);
}

export "c" fn satin_runtime_create_config(
    rows: u16,
    cols: u16,
    pixel_width: u16,
    pixel_height: u16,
    config: ?ptr<const u8>
) -> ?ptr<term::Runtime> {
    let text = config orelse return null;
    let allocator = mem::page_allocator();
    // SAFETY: the host passes a NUL-terminated string that outlives the call.
    let length = unsafe c_length(text);
    // SAFETY: text holds length readable bytes.
    let document = unsafe view_from_ptr(text, length);
    if term::spawn_config_from_json(allocator, document) |read| {
        defer read.deinit(allocator);
        return spawned(grid_size(rows, cols, pixel_width, pixel_height), &read);
    } else |_| {}
    return null;
}

export "c" fn satin_runtime_create_external(
    rows: u16,
    cols: u16,
    pixel_width: u16,
    pixel_height: u16
) -> ?ptr<term::Runtime> {
    let size = grid_size(rows, cols, pixel_width, pixel_height);
    if term::external_runtime(mem::page_allocator(), size) |runtime| {
        return boxed(move runtime);
    } else |_| {}
    return null;
}

export "c" fn satin_runtime_destroy(handle: ?ptr<term::Runtime>) -> void {
    let live = handle orelse return;
    // SAFETY: live came from a create and is destroyed once.
    let runtime = unsafe ptr_read(live);
    runtime.deinit(mem::page_allocator());
    // SAFETY: live is malloc storage nothing reads after this.
    unsafe free(cast<ptr<u8>>(live));
    return;
}

export "c" fn satin_runtime_resize(
    handle: ?ptr<term::Runtime>,
    rows: u16,
    cols: u16,
    pixel_width: u16,
    pixel_height: u16
) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    if runtime.resize(mem::page_allocator(), grid_size(rows, cols, pixel_width, pixel_height)) {
        return 1;
    } else |_| {}
    return 0;
}

export "c" fn satin_runtime_write(handle: ?ptr<term::Runtime>, bytes: ?ptr<const u8>, length: usize) -> u8 {
    let live = handle orelse return 0;
    let data = bytes orelse return 0;
    // SAFETY: the host passes length readable bytes at data.
    let view = unsafe view_from_ptr(data, cast<i64>(length));
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    if runtime.write_all(view) {
        return 1;
    } else |_| {}
    return 0;
}

export "c" fn satin_runtime_interactive_shell_owns_foreground(handle: ?ptr<term::Runtime>) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &live.*;
    return flag(runtime.interactive_shell_owns_foreground());
}

/// Encodes the key the host reports for shown's terminal and sends it: to
/// shown's own child, or with a gateway through tmux to the pane shown
/// shows. The key's text is read when it is given and UTF-8.
///
/// Each pointer must hold its length in readable bytes, and the handles
/// must be live and distinct.
unsafe fn send_key(
    gateway: ?ptr<term::Runtime>,
    shown: ptr<term::Runtime>,
    pane_id: u32,
    key_code: u16,
    modifiers: u32,
    text: ?ptr<const u8>,
    text_len: usize,
    unshifted: ptr<const u8>,
    unshifted_len: usize,
    repeat: u8,
    released: u8
) -> u8 {
    // SAFETY: the caller passes unshifted_len readable bytes at unshifted.
    let plain = unsafe view_from_ptr(unshifted, cast<i64>(unshifted_len));
    if !is_utf8(plain) {
        return 0;
    }
    var text_start = unshifted;
    var text_length: i64 = 0;
    if text |given| {
        text_start = given;
        text_length = cast<i64>(text_len);
    }
    // SAFETY: the caller passes text_len readable bytes at text; without text the view is empty.
    let typed = unsafe view_from_ptr(text_start, text_length);
    var has_text = false;
    if text |_| {
        has_text = is_utf8(typed);
    }
    let allocator = mem::page_allocator();
    // SAFETY: the caller passes a live handle the host calls from one thread.
    let runtime = unsafe &var shown.*;
    if gateway |sender| {
        var encoded = string::new(allocator);
        defer encoded.deinit(allocator);
        var wrote = false;
        if runtime.encode_key_of(allocator, cast<i64>(key_code), modifiers, has_text, typed, plain, repeat != 0, released != 0, &var encoded) |any| {
            wrote = any;
        } else |_| {}
        if !wrote {
            return 0;
        }
        return send_to_pane(sender, shown, pane_id, &encoded, true);
    }
    if runtime.write_key_of(allocator, cast<i64>(key_code), modifiers, has_text, typed, plain, repeat != 0, released != 0) |sent| {
        return flag(sent);
    } else |_| {}
    return 0;
}

export "c" fn satin_runtime_key(
    handle: ?ptr<term::Runtime>,
    key_code: u16,
    modifiers: u32,
    text: ?ptr<const u8>,
    text_len: usize,
    unshifted: ?ptr<const u8>,
    unshifted_len: usize,
    repeat: u8,
    released: u8
) -> u8 {
    let live = handle orelse return 0;
    let plain = unshifted orelse return 0;
    // SAFETY: the host passes each length in readable bytes and a handle from a create.
    return unsafe send_key(null, live, 0, key_code, modifiers, text, text_len, plain, unshifted_len, repeat, released);
}

export "c" fn satin_runtime_text(handle: ?ptr<term::Runtime>, bytes: ?ptr<const u8>, length: usize) -> u8 {
    let live = handle orelse return 0;
    let data = bytes orelse return 0;
    // SAFETY: the host passes length readable bytes at data.
    let text = unsafe view_from_ptr(data, cast<i64>(length));
    if !is_utf8(text) {
        return 0;
    }
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    if runtime.write_text(text) {
        return 1;
    } else |_| {}
    return 0;
}

export "c" fn satin_runtime_paste(handle: ?ptr<term::Runtime>, bytes: ?ptr<const u8>, length: usize) -> u8 {
