/// 0 unavailable, 1 waiting, 2 ready.
export "c" fn satin_runtime_tmux_shell_prompt_state(pane: ?ptr<term::Runtime>) -> u8 {
    let live = pane orelse return 0;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &live.*;
    if runtime.tmux_shell_prompt_state() |state| {
        if state == term::ShellPromptState::Waiting {
            return 1;
        }
        if state == term::ShellPromptState::Ready {
            return 2;
        }
    } else |_| {}
    return 0;
}

