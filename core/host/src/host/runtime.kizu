    let runtime = unsafe &var live.*;
    if runtime.write_paste(mem::page_allocator(), text) {
        return 1;
    } else |_| {}
    return 0;
}

/// Reads the host's mouse event into out; false for an action or a button
/// it has no number for. button -1 is no button.
fn mouse_input(
    action: u32,
    button: i32,
    modifiers: u32,
    x: f32,
    y: f32,
    cell_width: u32,
    cell_height: u32,
    out: &var term::MouseInput
) -> bool {
    if action == 0 {
        out.action = term::MouseAction::Press;
    } else if action == 1 {
        out.action = term::MouseAction::Release;
    } else if action == 2 {
        out.action = term::MouseAction::Motion;
    } else {
        return false;
    }
    if button < -1 or button > 10 {
        return false;
    }
    out.has_button = button >= 0;
    // libghostty numbers the buttons from one.
    out.button = button + 1;
    out.modifiers = modifiers;
    out.x = x;
    out.y = y;
    out.cell_width = cell_width;
    out.cell_height = cell_height;
    return true;
}

fn no_mouse_input() -> term::MouseInput {
    return term::MouseInput {
        action: term::MouseAction::Motion,
        has_button: false,
        button: 0,
        modifiers: 0,
        x: cast<f32>(0.0),
        y: cast<f32>(0.0),
        cell_width: 1,
        cell_height: 1
    };
}

export "c" fn satin_runtime_mouse(
    handle: ?ptr<term::Runtime>,
    action: u32,
    button: i32,
    modifiers: u32,
    x: f32,
    y: f32,
    cell_width: u32,
    cell_height: u32
) -> u8 {
    let live = handle orelse return 0;
    var input = no_mouse_input();
    if !mouse_input(action, button, modifiers, x, y, cell_width, cell_height, &var input) {
        return 0;
    }
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    if runtime.write_mouse(mem::page_allocator(), input) |sent| {
        return flag(sent);
    } else |_| {}
    return 0;
}

export "c" fn satin_runtime_mouse_tracking(handle: ?ptr<term::Runtime>) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &live.*;
    return flag(runtime.is_mouse_tracking());
}

export "c" fn satin_runtime_focus(handle: ?ptr<term::Runtime>, focused: u8) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    if runtime.write_focus(mem::page_allocator(), focused != 0) |sent| {
        return flag(sent);
    } else |_| {}
    return 0;
}

/// A selection event: 0 press, 1 drag, 2 release, 3 autoscroll tick, 4
/// cancel. An autoscroll returns the rows the viewport moved; the others 1
/// when they were applied and 0 when not.
export "c" fn satin_runtime_selection_event(
    handle: ?ptr<term::Runtime>,
    action: u32,
    row: u32,
    col: u16,
    x: f32,
    y: f32,
    cell_width: u32,
    cell_height: u32,
    rectangular: u8
) -> isize {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    let input = term::SelectionInput {
        row: cast<i64>(row),
        col: cast<i64>(col),
        x: x,
        y: y,
        cell_width: cell_width,
        cell_height: cell_height
    };
    if action == 0 {
        if runtime.selection_press(input) {
            return 1;
        } else |_| {}
    } else if action == 1 {
        if runtime.selection_drag(input, rectangular != 0) {
            return 1;
        } else |_| {}
    } else if action == 2 {
        if runtime.selection_release(true, input.row, input.col) {
            return 1;
        } else |_| {}
    } else if action == 3 {
        if runtime.selection_autoscroll(input, rectangular != 0) |moved| {
            return cast<isize>(moved);
        } else |_| {}
    } else if action == 4 {
        runtime.cancel_selection();
        return 1;
    }
    return 0;
}

