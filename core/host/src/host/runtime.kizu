fn same_runtime(first: ptr<term::Runtime>, second: ptr<term::Runtime>) -> bool {
    // SAFETY: reading a handle's address touches nothing it points at.
    let first_address = unsafe int_from_ptr<usize>(first);
    // SAFETY: as above.
    let second_address = unsafe int_from_ptr<usize>(second);
    return first_address == second_address;
}

/// Types what the pane's terminal encoded into the tmux pane it shows,
/// through the gateway terminal that runs tmux.
fn send_to_pane(
    gateway: ptr<term::Runtime>,
    pane: ptr<term::Runtime>,
    pane_id: u32,
    bytes: &string::String,
    finish: bool
) -> u8 {
    let encoded = bytes.as_bytes();
    // SAFETY: the host holds gateway from a create, apart from pane, and calls from one thread.
    let sender = unsafe &var gateway.*;
    var sent = false;
    if sender.tmux_send_bytes(mem::page_allocator(), cast<i64>(pane_id), encoded) |accepted| {
        sent = accepted;
    } else |_| {}
    if sent and finish {
        // SAFETY: the host holds pane from a create, apart from gateway.
        let shown = unsafe &var pane.*;
        shown.finish_external_input();
    }
    return flag(sent);
}

export "c" fn satin_runtime_tmux_key(
    gateway: ?ptr<term::Runtime>,
    pane: ?ptr<term::Runtime>,
    pane_id: u32,
    key_code: u16,
    modifiers: u32,
    text: ?ptr<const u8>,
    text_len: usize,
    unshifted: ?ptr<const u8>,
    unshifted_len: usize,
    repeat: u8,
    released: u8
) -> u8 {
    let sender = gateway orelse return 0;
    let shown = pane orelse return 0;
    let plain = unshifted orelse return 0;
    if same_runtime(sender, shown) {
        return 0;
    }
    // SAFETY: the host passes each length in readable bytes and distinct handles from creates.
    return unsafe send_key(
        sender,
        shown,
        pane_id,
        key_code,
        modifiers,
        text,
        text_len,
        plain,
        unshifted_len,
        repeat,
        released
    );
}

export "c" fn satin_runtime_tmux_write(
    gateway: ?ptr<term::Runtime>,
    pane: ?ptr<term::Runtime>,
    pane_id: u32,
    bytes: ?ptr<const u8>,
    length: usize
) -> u8 {
    let sender = gateway orelse return 0;
    let shown = pane orelse return 0;
    let data = bytes orelse return 0;
    if same_runtime(sender, shown) {
        return 0;
    }
    let allocator = mem::page_allocator();
    // SAFETY: the host passes length readable bytes at data.
    let view = unsafe view_from_ptr(data, cast<i64>(length));
    var copy = string::new(allocator);
    defer copy.deinit(allocator);
    if copy.append_bytes(allocator, view) {} else |_| {
        return 0;
    }
    return send_to_pane(sender, shown, pane_id, &copy, true);
}

export "c" fn satin_runtime_tmux_paste(
    gateway: ?ptr<term::Runtime>,
    pane: ?ptr<term::Runtime>,
    pane_id: u32,
    bytes: ?ptr<const u8>,
    length: usize
) -> u8 {
    let sender = gateway orelse return 0;
    let shown = pane orelse return 0;
    let data = bytes orelse return 0;
    if same_runtime(sender, shown) {
        return 0;
    }
    // SAFETY: the host passes length readable bytes at data.
    let text = unsafe view_from_ptr(data, cast<i64>(length));
    if !is_utf8(text) {
        return 0;
    }
    var sent = false;
    // SAFETY: the host holds sender from a create, apart from shown, and calls from one thread.
    let runtime = unsafe &var sender.*;
    if runtime.tmux_paste(mem::page_allocator(), cast<i64>(pane_id), text) |accepted| {
        sent = accepted;
    } else |_| {}
    if sent {
        // SAFETY: the host holds shown from a create, apart from sender.
        let runtime = unsafe &var shown.*;
        runtime.finish_external_input();
    }
    return flag(sent);
}

export "c" fn satin_runtime_tmux_mouse(
    gateway: ?ptr<term::Runtime>,
    pane: ?ptr<term::Runtime>,
    pane_id: u32,
    action: u32,
    button: i32,
    modifiers: u32,
    x: f32,
    y: f32,
    cell_width: u32,
    cell_height: u32
) -> u8 {
    let sender = gateway orelse return 0;
    let shown = pane orelse return 0;
    if same_runtime(sender, shown) {
        return 0;
    }
    var input = no_mouse_input();
    if !mouse_input(action, button, modifiers, x, y, cell_width, cell_height, &var input) {
        return 0;
    }
    let allocator = mem::page_allocator();
    var encoded = string::new(allocator);
    defer encoded.deinit(allocator);
    var wrote = false;
    // SAFETY: the host holds shown from a create and calls from one thread.
    let runtime = unsafe &var shown.*;
    if runtime.encode_mouse(allocator, input, &var encoded) |any| {
        wrote = any;
    } else |_| {}
    if !wrote {
        return 0;
    }
    return send_to_pane(sender, shown, pane_id, &encoded, false);
}

export "c" fn satin_runtime_tmux_focus(
    gateway: ?ptr<term::Runtime>,
    pane: ?ptr<term::Runtime>,
    pane_id: u32,
    focused: u8
) -> u8 {
    let sender = gateway orelse return 0;
    let shown = pane orelse return 0;
    if same_runtime(sender, shown) {
        return 0;
    }
    let allocator = mem::page_allocator();
    var encoded = string::new(allocator);
    defer encoded.deinit(allocator);
    var wrote = false;
    // SAFETY: the host holds shown from a create and calls from one thread.
    let runtime = unsafe &shown.*;
    if runtime.encode_focus(allocator, focused != 0, &var encoded) |any| {
        wrote = any;
    } else |_| {}
    if !wrote {
        return 0;
    }
    return send_to_pane(sender, shown, pane_id, &encoded, false);
}

/// Whether the child has exited; a null handle reads as exited.
export "c" fn satin_runtime_exited(handle: ?ptr<term::Runtime>) -> u8 {
    let live = handle orelse return 1;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    return flag(runtime.is_exited());
}

export "c" fn satin_runtime_wakeup_fd(handle: ?ptr<term::Runtime>) -> i32 {
    let live = handle orelse return -1;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &live.*;
    return runtime.wakeup_fd();
}

export "c" fn satin_runtime_scroll(handle: ?ptr<term::Runtime>, requested_rows: isize) -> isize {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    return cast<isize>(runtime.scroll_delta(cast<i64>(requested_rows)));
}

export "c" fn satin_runtime_renderer_scroll_position(handle: ?ptr<term::Runtime>) -> f32 {
    let live = handle orelse return cast<f32>(0.0);
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &live.*;
    return runtime.model.scroll_position();
}

/// The cursor as x in the low 16 bits and y in the next 16; all ones when
/// it cannot be read.
export "c" fn satin_runtime_cursor_position(handle: ?ptr<term::Runtime>) -> u32 {
    let live = handle orelse return 4294967295;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &live.*;
    var x: i64 = 0;
    var y: i64 = 0;
    if runtime.cursor_position(&var x, &var y) {
        return cast<u32>(x + y * 65536);
    } else |_| {}
    return 4294967295;
}

export "c" fn satin_runtime_cwd(handle: ?ptr<term::Runtime>) -> ?ptr<u8> {
    let live = handle orelse return null;
    let allocator = mem::page_allocator();
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &live.*;
    var directory = string::new(allocator);
    defer directory.deinit(allocator);
    if runtime.working_directory(allocator, &var directory) |known| {
        if known {
            return owned_out(&directory);
        }
    } else |_| {}
    return null;
}

export "c" fn satin_runtime_screen_text(handle: ?ptr<term::Runtime>) -> ?ptr<u8> {
    let live = handle orelse return null;
    let allocator = mem::page_allocator();
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    var text = string::new(allocator);
    defer text.deinit(allocator);
    if runtime.screen_text(allocator, &var text) {
        return owned_out(&text);
    } else |_| {}
    return null;
}

export "c" fn satin_runtime_kitty_placement_count(handle: ?ptr<term::Runtime>) -> usize {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from a create and calls from one thread.
    let runtime = unsafe &var live.*;
    if runtime.collect_kitty(mem::page_allocator()) {
        return cast<usize>(runtime.kitty.placements.len());
    } else |_| {}
    return 0;
}
