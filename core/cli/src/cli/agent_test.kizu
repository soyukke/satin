import std::mem;
import std::testing;

fn summary_is(input: []u8, status: []u8, summary: []u8) -> bool {
    if claude_pane_status(mem::page_allocator(), input) |number| {
        return mem::equal_bytes(status_word(number), status) and mem::equal_bytes(status_summary(number), summary);
    } else |_| {}
    return false;
}

test "a Claude Code turn maps to pane statuses without its prompt" {
    testing::expect(summary_is(
        \\{"hook_event_name":"SessionStart","cwd":"/private"}
    , "idle", "Claude Code ready"));
    testing::expect(summary_is(
        \\{"hook_event_name":"UserPromptSubmit","prompt":"do not expose this"}
    , "running", "Claude Code working"));
    testing::expect(summary_is(
        \\{"hook_event_name":"PermissionRequest"}
    , "waiting", "Claude Code needs approval"));
    testing::expect(summary_is(
        \\{"hook_event_name":"Stop","background_tasks":[],"session_crons":[]}
    , "done", "Claude Code finished"));
    testing::expect(summary_is(
        \\{"hook_event_name":"Stop","session_crons":[{"id":1}]}
    , "done", "Claude Code finished; background work listed"));
    testing::expect(summary_is(
        \\{"hook_event_name":"StopFailure"}
    , "failed", "Claude Code failed"));
}

test "what is no known event has no status" {
    testing::expect(summary_is(
        \\{"hook_event_name":"Notification"}
    , "", ""));
    testing::expect(summary_is(
        \\{"hook_event_name":"Stop","background_tasks":3}
    , "", ""));
    testing::expect(summary_is("nope", "", ""));
}

test "identifiers are whole decimal numbers" {
    testing::expect(parse_index("0") == 0);
    testing::expect(parse_index("42") == 42);
    testing::expect(parse_index("") == -1);
    testing::expect(parse_index("-1") == -1);
    testing::expect(parse_index("4x") == -1);
}
