#!/usr/bin/env bash
# Builds scripts/drawable-check.swift against target/host/satin.o and runs
# it: the exports the app renders through, into a real drawable, read back.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
sdk="$(env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun --sdk macosx --show-sdk-path)"
mkdir -p "$root/target/app"
env -u SDKROOT -u DEVELOPER_DIR \
  /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc \
  -O -sdk "$sdk" -target arm64-apple-macos14.0 \
  "$root/scripts/drawable-check.swift" \
  "$root/target/host/satin.o" "$root/target/native/libghostty-vt.a" \
  -framework Metal -framework QuartzCore -framework CoreText -framework CoreGraphics \
  -framework CoreFoundation -lobjc \
  -o "$root/target/app/drawable-check" 2>&1 | grep -v "was built for newer" || true
"$root/target/app/drawable-check"
