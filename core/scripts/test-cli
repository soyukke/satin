#!/bin/sh
# Runs the built `satin` command against a stand-in for the app: a socket
# that records each request line and answers what the test tells it to.
#
#   scripts/test-cli path/to/satin
set -eu
unset TMUX TMUX_PANE
satin="$1"
work="$(mktemp -d /tmp/satin-cli-test.XXXXXX)"
trap '{ kill "$server"; wait "$server"; } 2>/dev/null || true; rm -rf "$work"' EXIT
socket="$work/control.sock"

python3 - "$socket" "$work" <<'PY' &
import os, socket, sys
path, work = sys.argv[1], sys.argv[2]
server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
server.bind(path)
server.listen(8)
while True:
    client, _ = server.accept()
    line = b""
    while not line.endswith(b"\n"):
        chunk = client.recv(4096)
        if not chunk:
            break
        line += chunk
    with open(os.path.join(work, "request"), "wb") as out:
        out.write(line)
    with open(os.path.join(work, "answer"), "rb") as answer:
        client.sendall(answer.read() + b"\n")
    client.close()
PY
server=$!
while [ ! -S "$socket" ]; do sleep 0.05; done

failures=0
check() {
    label="$1"; expected="$2"; actual="$3"
    if [ "$expected" != "$actual" ]; then
        failures=$((failures + 1))
        printf 'FAIL %s\n  expected: %s\n  actual:   %s\n' "$label" "$expected" "$actual"
    fi
}
answer() { printf '%s' "$1" > "$work/answer"; }
request() { tr -d '\n' < "$work/request"; }

answer '{"ok":true,"result":{"text":"screen text"}}'
out="$("$satin" --socket "$socket" read-screen --pane 3)"
check "read-screen prints the result text" "screen text" "$out"
check "read-screen request" '{"version":1,"command":"read-screen","pane":3}' "$(request)"

answer '{"ok":true,"result":"sent"}'
out="$(SATIN_SOCKET="$socket" SATIN_PANE_ID=9 "$satin" send hello there)"
check "send prints a string result" "sent" "$out"
check "send takes the pane from the environment" '{"version":1,"command":"send","pane":9,"text":"hello there"}' "$(request)"

out="$(printf 'from stdin' | "$satin" --socket "$socket" send --pane 1 -)"
check "send reads stdin" '{"version":1,"command":"send","pane":1,"text":"from stdin"}' "$(request)"

answer '{"ok":true,"result":{"tabs":[]}}'
out="$("$satin" --socket "$socket" --json list)"
check "--json prints the whole answer" '{
  "ok": true,
  "result": {
    "tabs": []
  }
}' "$out"
out="$("$satin" --socket "$socket" list)"
check "a result without text is printed whole" '{
  "tabs": []
}' "$out"

"$satin" --socket "$socket" split --pane 2 --horizontal --cwd /tmp > /dev/null
check "split request" '{"version":1,"command":"split","pane":2,"axis":"horizontal","cwd":"/tmp","background":false}' "$(request)"
"$satin" --socket "$socket" new-tab --title project --background > /dev/null
check "new-tab request" '{"version":1,"command":"new-tab","cwd":null,"title":"project","background":true}' "$(request)"
"$satin" --socket "$socket" move-tab --tab 7 --index 1 > /dev/null
check "move-tab request" '{"version":1,"command":"move-tab","tab":7,"index":1}' "$(request)"
"$satin" --socket "$socket" rename-tab --tab 7 my project > /dev/null
check "rename-tab request" '{"version":1,"command":"rename-tab","tab":7,"title":"my project"}' "$(request)"
"$satin" --socket "$socket" status set --pane 4 done all tests passed > /dev/null
check "status set request" '{"version":1,"command":"status-set","pane":4,"status":"done","summary":"all tests passed"}' "$(request)"
"$satin" --socket "$socket" status wait --pane 4 --timeout 5 > /dev/null
check "status wait request" '{"version":1,"command":"status-wait","pane":4,"timeout_ms":5000}' "$(request)"
"$satin" --socket "$socket" status session-start --pane 4 codex > /dev/null
check "status session-start request" '{"version":1,"command":"status-set","pane":4,"status":"idle","summary":"Codex ready","agent_session_start":true}' "$(request)"
printf '{"hook_event_name":"Stop","background_tasks":[1],"prompt":"private"}' | "$satin" --socket "$socket" status event --pane 4 claude > /dev/null
check "status event request" '{"version":1,"command":"status-set","pane":4,"status":"done","summary":"Claude Code finished; background work listed"}' "$(request)"

# A status from inside tmux is also kept on its tmux pane, for other clients
# of that server. A private server keeps the test off any session in use.
if command -v tmux > /dev/null 2>&1; then
    tmux_socket="$work/tmux.sock"
    tmux -S "$tmux_socket" -f /dev/null new-session -d -x 80 -y 24
    tmux_pane="$(tmux -S "$tmux_socket" display-message -p '#{pane_id}')"
    TMUX="$tmux_socket,1,0" TMUX_PANE="$tmux_pane" SATIN_PANE_ID=4 \
        "$satin" --socket "$socket" status set waiting 'Bash(npm test)?' > /dev/null
    check "a tmux status names its tmux pane" \
        "{\"version\":1,\"command\":\"status-set\",\"pane\":4,\"status\":\"waiting\",\"summary\":\"Bash(npm test)?\",\"tmux_pane\":${tmux_pane#%},\"tmux_socket\":\"$tmux_socket\"}" \
        "$(request)"
    kept() {
        tmux -S "$tmux_socket" show-options -pqv -t "$tmux_pane" @satin-status | sed 's/^\([a-z]*\) [0-9][0-9]* /\1 MS /'
    }
    check "a tmux status is kept on the tmux pane" "waiting MS Bash(npm test)?" "$(kept)"
    TMUX="$tmux_socket,1,0" TMUX_PANE="$tmux_pane" SATIN_PANE_ID=4 \
        "$satin" --socket "$socket" status session-start codex > /dev/null
    check "a session start is kept on the tmux pane" "idle MS Codex ready" "$(kept)"
    TMUX="$tmux_socket,1,0" TMUX_PANE="$tmux_pane" \
        "$satin" --socket "$socket" status set --pane 4 done > /dev/null
    check "a status for a named pane leaves tmux alone" "idle MS Codex ready" "$(kept)"
    tmux -S "$tmux_socket" kill-server
fi

answer '{"ok":true,"result":{"tabs":[{"id":2,"title":"t"}],"panes":[{"id":5,"tab":2}]}}'
out="$(SATIN_TAB_ID=2 SATIN_PANE_ID=5 "$satin" --socket "$socket" --json identify | tr -d ' \n')"
check "identify" "{\"ok\":true,\"result\":{\"socket\":\"$socket\",\"tab\":{\"id\":2,\"title\":\"t\"},\"pane\":{\"id\":5,\"tab\":2}}}" "$out"
out="$(SATIN_TAB_ID=3 SATIN_PANE_ID=5 "$satin" --socket "$socket" identify 2>&1 || true)"
check "identify refuses a tab that is not live" "satin: SATIN_TAB_ID does not identify a live tab" "$out"

answer '{"ok":false,"error":{"code":"no_pane","message":"pane 3 is gone"}}'
status=0
out="$("$satin" --socket "$socket" read-screen --pane 3 2>&1)" || status=$?
check "a failure is printed with its code" "satin: no_pane: pane 3 is gone" "$out"
check "a failure exits with 1" "1" "$status"

out="$("$satin" --socket "$socket" split --pane 2 2>&1 || true)"
check "split needs an axis" "satin: split requires exactly one of --vertical or --horizontal" "$out"
out="$("$satin" --socket "$socket" list extra 2>&1 || true)"
check "leftover words are refused" "satin: unexpected arguments: extra" "$out"
out="$(env -u SATIN_PANE_ID -u NVTERM_PANE_ID "$satin" --socket "$socket" read-screen 2>&1 || true)"
check "a pane is required" "satin: pass --pane or set SATIN_PANE_ID" "$out"
out="$("$satin" --socket "$work/absent.sock" list 2>&1 || true)"
check "a missing socket is reported" "satin: connect $work/absent.sock" "$out"
check "--version" "satin 0.4.12" "$("$satin" --version)"
check "skill starts with its metadata" "---" "$("$satin" skill | head -1)"
check "help prints the usage" "usage: satin --version" "$("$satin" --help | head -1)"
check "help lists the page commands" "  page list [ID] [--limit N]" "$("$satin" --help | grep 'page list')"
check "help does not name the older artifact alias" "0" "$("$satin" --help | grep -c artifact || true)"

# The page commands keep their store beside the socket themselves;
# only `page show` asks the app for anything.
printf 'first line\nsecond line\n' > "$work/note.txt"
out="$(env -u LC_ALL -u LC_MESSAGES LANG=ja_JP.UTF-8 "$satin" --socket "$socket" page policy)"
check "page policy prints the default policy" '{
  "policy": {
    "language": "auto",
    "max_columns": 80,
    "max_rows": 32,
    "overflow": "compact"
  },
  "resolvedLanguage": "ja-JP"
}' "$out"
"$satin" --socket "$socket" page policy set --max-columns 60 --max-rows 12 --language en-US --overflow reject > /dev/null
check "page policy set saves the policy" '{
  "max_columns": 60,
  "max_rows": 12,
  "language": "en-US",
  "overflow": "reject"
}' "$(cat "$work/artifacts/.policy.json")"
out="$("$satin" --socket "$socket" page policy set --max-columns 10 2>&1 || true)"
check "page policy refuses bounds it cannot keep" "satin: max columns must be between 40 and 240" "$out"
"$satin" --socket "$socket" page policy set --overflow compact > /dev/null
out="$("$satin" --socket "$socket" --json page add --kind text --title 'Release notes' --file "$work/note.txt" --pane 4 --tab 2)"
id="$(printf '%s\n' "$out" | sed -n 's/^    "id": "\(.*\)",$/\1/p')"
check "page add answers the first version" '    "language": "en-US",
    "owner_pane": 4,
    "owner_tab": 2,
    "version": 1' "$(printf '%s\n' "$out" | grep -e '"language"' -e '"owner_' -e '"version"')"
check "page add keeps the document" '# Release notes

first line
second line' "$(cat "$work/artifacts/release-notes--$id/current.md")"
out="$("$satin" --socket "$socket" page add --id "$id" --kind text --title 'Release notes' --file "$work/note.txt" | grep '"version"')"
check "page add stores an unchanged source once" '  "version": 1' "$out"
out="$("$satin" --socket "$socket" page list | cut -f 1,2,3,5,6)"
check "page list" "$id	v1	text	Release notes	first line · second line" "$out"
out="$("$satin" --socket "$socket" page list "$id" | cut -f 1,3)"
check "page list ID lists the versions" "v1	23 bytes" "$out"
out="$("$satin" --socket "$socket" artifact list | cut -f 1,2,3,5,6)"
check "artifact is an alias of page" "$id	v1	text	Release notes	first line · second line" "$out"
unread() { "$satin" --socket "$socket" --json page list | grep -o '"read_version": *[0-9]*' | tr -d ' '; }
check "a new page is unread" '"read_version":0' "$(unread)"
check "page read marks a version" "$id	v1" "$("$satin" --socket "$socket" page read "$id")"
check "page list names the version read" '"read_version":1' "$(unread)"
check "page read --all counts what it read" "0 pages read" "$("$satin" --socket "$socket" page read --all)"
check "page read takes several pages" "$id	v1
$id	v1" "$("$satin" --socket "$socket" page read "$id" "$id@v1")"
out="$("$satin" --socket "$socket" page read 2>&1 || true)"
check "page read needs a page" "satin: page read requires a page ID or --all" "$out"
out="$("$satin" --socket "$socket" page 2>&1 | head -1 || true)"
check "page alone prints its usage" "satin: usage: satin page policy" "$out"
out="$(env -u COLUMNS -u LINES "$satin" --socket "$socket" page view "$id" --no-wait | sed -n 1p | tr -d '\033\r' | sed 's/ *\[0m$//')"
check "page view --no-wait draws the title" "[1;39mRelease notes" "$out"
out="$(env -u COLUMNS -u LINES "$satin" --socket "$socket" page view "$id" --no-wait | wc -l | tr -d ' ')"
check "page view --no-wait draws the policy's rows" "11" "$out"
answer '{"ok":true,"result":"shown"}'
out="$("$satin" --socket "$socket" page show --pane 3 "$id@1" --background)"
check "page show prints the app's answer" "shown" "$out"
check "page show request" "{\"version\":1,\"command\":\"artifact-show\",\"pane\":3,\"artifact\":\"$id@1\",\"axis\":\"vertical\",\"background\":true}" "$(request)"
out="$("$satin" --socket "$socket" page show --pane 3 a0 2>&1 || true)"
check "page show refuses a page that is not stored" "satin: page a0 does not exist" "$out"
out="$("$satin" --socket "$socket" page add --kind video 2>&1 || true)"
check "page add refuses a kind it does not know" 'satin: unsupported page kind "video"' "$out"

# A Markdown page is drawn block by block: `plain` is the body of the
# screen without its escapes and the spaces that fill each row.
cat > "$work/report.md" <<'MD'
# Report

## Findings

Status **first**, run `cargo test`.

- one
  1. nested

| Check | Result |
|---|---|
| tests | pass |

```sh
echo done
```
MD
"$satin" --socket "$socket" page policy set --max-columns 80 --max-rows 32 > /dev/null
out="$("$satin" --socket "$socket" --json page add --kind markdown --title 'Report' --file "$work/report.md")"
id="$(printf '%s\n' "$out" | sed -n 's/^    "id": "\(.*\)",$/\1/p')"
view="$(env -u COLUMNS -u LINES "$satin" --socket "$socket" page view "$id" --no-wait)"
plain="$(printf '%s\n' "$view" | sed -e "s/$(printf '\033')\[[0-9;]*m//g" -e 's/ *\r$//' | sed -n '4,22p')"
check "page view draws a Markdown heading and inline styles" '▌ Findings

Status first, run cargo test.' "$(printf '%s\n' "$plain" | sed -n '1,3p')"
check "page view draws a Markdown list" '• one

  1. nested' "$(printf '%s\n' "$plain" | sed -n '5,7p')"
check "page view draws a Markdown table" '┌───────────────────────────────────────┬──────────────────────────────────────┐
│Check                                  │Result                                │
├───────────────────────────────────────┼──────────────────────────────────────┤
│tests                                  │pass                                  │
└───────────────────────────────────────┴──────────────────────────────────────┘' "$(printf '%s\n' "$plain" | sed -n '9,13p')"
check "page view draws a Markdown code fence" '┌─ sh
│ echo done
└─' "$(printf '%s\n' "$plain" | sed -n '15,17p')"
check "page view styles Markdown spans" "1" "$(printf '%s\n' "$view" | grep -c '\[1mfirst.*\[36mcargo test')"

if [ "$failures" -ne 0 ]; then
    echo "$failures failed"
    exit 1
fi
echo "cli: ok"
