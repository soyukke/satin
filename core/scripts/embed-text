#!/bin/sh
# Writes a text file as a Kizu function returning its bytes, since Kizu has
# no way to embed a file at build time. The last newline of the file is not
# part of the literal; the callers add it.
#
#   scripts/embed-text SOURCE OUT.kizu FUNCTION
set -eu
source="$1"
out="$2"
name="$3"
{
    echo "// Generated by scripts/embed-text from $(basename "$source"). Do not edit."
    echo "fn $name() -> []u8 {"
    echo "    return"
    sed 's/^/        \\\\/' "$source"
    echo "    ;"
    echo "}"
} > "$out"
