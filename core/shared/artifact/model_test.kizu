import std::mem;
import std::string;
import std::testing;

test "kinds and overflows are named in any case" {
    testing::expect((parse_kind("MD") orelse ArtifactKind::Text) == ArtifactKind::Markdown);
    testing::expect((parse_kind("patch") orelse ArtifactKind::Text) == ArtifactKind::Diff);
    testing::expect((parse_kind("Png") orelse ArtifactKind::Text) == ArtifactKind::Image);
    testing::expect((parse_kind("timeline") orelse ArtifactKind::Text) == ArtifactKind::Timeline);
    var unknown = true;
    if parse_kind("video") |_| {
        unknown = false;
    }
    if kind_from_name("md") |_| {
        unknown = false;
    }
    testing::expect(unknown);
    testing::expect((parse_overflow("DEFER") orelse ArtifactOverflow::Compact) == ArtifactOverflow::Defer);
    testing::expect(mem::equal_bytes(kind_name(ArtifactKind::Tree), "tree"));
}

test "a timestamp is written as a UTC date and minute" {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try append_timestamp(allocator, &var out, 0);
    try out.append_byte(allocator, 124);
    try append_timestamp(allocator, &var out, 1709251199000);
    try out.append_byte(allocator, 124);
    try append_timestamp(allocator, &var out, 1791850413414);
    let bytes = out.as_bytes();
    testing::expect(mem::equal_bytes(bytes, "1970-01-01 00:00 UTC|2024-02-29 23:59 UTC|2026-10-13 00:13 UTC"));
}

test "a byte count is written in binary units" {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try append_byte_count(allocator, &var out, 1023);
    try out.append_byte(allocator, 124);
    try append_byte_count(allocator, &var out, 1536);
    try out.append_byte(allocator, 124);
    try append_byte_count(allocator, &var out, 1280);
    try out.append_byte(allocator, 124);
    try append_byte_count(allocator, &var out, 3145728);
    let bytes = out.as_bytes();
    testing::expect(mem::equal_bytes(bytes, "1023 B|1.5 KiB|1.2 KiB|3.0 MiB"));
}

test "a locale names a language tag" {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    testing::expect(try append_locale_language(allocator, &var out, "ja_JP.UTF-8"));
    try out.append_byte(allocator, 124);
    testing::expect(try append_locale_language(allocator, &var out, "EN-us@euro"));
    try out.append_byte(allocator, 124);
    testing::expect(try append_locale_language(allocator, &var out, "de"));
    testing::expect(!try append_locale_language(allocator, &var out, "C.UTF-8"));
    testing::expect(!try append_locale_language(allocator, &var out, "POSIX"));
    testing::expect(!try append_locale_language(allocator, &var out, ""));
    let bytes = out.as_bytes();
    testing::expect(mem::equal_bytes(bytes, "ja-JP|en-US|de"));
}

test "titles, languages and ids are checked" {
    let allocator = mem::page_allocator();
    var message = string::new(allocator);
    defer message.deinit(allocator);
    try validate_title(allocator, &var message, "調査結果");
    try validate_language(allocator, &var message, "zh-Hant-TW");
    try validate_artifact_id(allocator, &var message, "a0123456789ab");
    var refused: i64 = 0;
    if validate_title(allocator, &var message, "   ") {} else |_| {
        refused = refused + 1;
    }
    if validate_title(allocator, &var message,
        \\two
        \\lines
    ) {} else |_| {
        refused = refused + 1;
    }
    if validate_language(allocator, &var message, "en_US") {} else |_| {
        refused = refused + 1;
    }
    if validate_artifact_id(allocator, &var message, "../etc") {} else |_| {
        refused = refused + 1;
    }
    testing::expect(refused == 4);
}
