        \\---
        \\soft
        \\break and a hard\
        \\break
        \\
        \\***
        \\- - -
        \\
    ,
        \\T|▌ |One
        \\T|▌ |Two
        \\T|› |Three
        \\T|· |Four
        \\T||#No heading
        \\T|▌ |Setext two lines
        \\T|▌ |Under
        \\T||soft break and a hard
        \\break
        \\R||
        \\R||
        \\
    ));
}

