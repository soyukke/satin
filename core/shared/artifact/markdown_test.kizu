test "links, references and footnotes read as their text" {
    testing::expect(reads_as(
        \\[inline](https://example.test "title") <https://auto.test> <a@b.c>
        \\[text][ref] [ref][] [Ref] [missing][nope] [none]
        \\note[^1] and[^none]
        \\
        \\[ref]: https://example.test/ref
        \\[^1]: The note.
        \\    More of it.
        \\
    ,
        \\T||inline https://auto.test a@b.c text ref Ref [missing][nope] [none] note[1] and[^none]
        \\T||The note. More of it.
        \\
    ));
    testing::expect(span_flags(
        \\[text][ref]
        \\
        \\[ref]: /url
    , "text") == 49);
    testing::expect(span_flags(
        \\[text][nope]
        \\
        \\[ref]: /url
    , "[text][nope]") == 1);
}

