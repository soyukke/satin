test "a document is drawn wrapped, boxed and prefixed" {
    testing::expect(draws_as(
        \\# Report
        \\
        \\## Findings
        \\
        \\A paragraph that is long enough to wrap in a narrow pane.
        \\
        \\- first item wraps under its own text
        \\  - 入れ子の項目は全角で折り返す
        \\
        \\> [!NOTE]
        \\> quoted
        \\
        \\| Check | Result |
        \\|---|---|
        \\| tests | pass |
        \\
        \\```sh
        \\cargo test
        \\```
        \\
        \\---
        \\
        \\![Far](https://example.test/far.png)
        \\
    , 24,
        \\▌ Findings
        \\
        \\A paragraph that is long
        \\enough to wrap in a nar
        \\row pane.
        \\
        \\• first item wraps under
        \\  its own text
        \\
        \\  • 入れ子の項目は全角で
        \\    折り返す
        \\
        \\NOTE │ quoted
        \\
        \\┌───────────┬──────────┐
        \\│Check      │Result    │
        \\├───────────┼──────────┤
        \\│tests      │pass      │
        \\└───────────┴──────────┘
        \\
        \\┌─ sh
        \\│ cargo test
        \\└─
        \\
        \\────────────────────────
        \\
        \\▧ Image: Far (remote or
        \\  non-PNG source not fet
        \\  ched)
        \\
    ));
}

test "what a pane cannot show is counted" {
    let allocator = mem::page_allocator();
    var omitted: i64 = 0;
    let drawn = try draw(
        \\one
        \\
        \\two
        \\
        \\```
        \\a line of code that is wider than the pane
        \\b
        \\c
        \\```
        \\
        \\three
        \\
    , 20, 6, &var omitted);
    defer drawn.deinit(allocator);
    let bytes = drawn.as_bytes();
    testing::expect(mem::equal_bytes(bytes,
        \\one
        \\
        \\two
        \\
        \\┌─ code
        \\└─
        \\
    ));
    // The three code lines, which leave the last row to the line that
    // closes the block, then an empty line and the last paragraph.
    testing::expect(omitted == 5);
}
