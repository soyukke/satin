test "the reject policy does not register an oversized preview" {
    let allocator = mem::page_allocator();
    let root = try test_directory(allocator, "reject");
    defer root.deinit(allocator);
    let root_bytes = root.as_bytes();
    defer remove_tree(allocator, root_bytes);
    let socket = try joined(allocator, root_bytes, "control.sock");
    defer socket.deinit(allocator);
    let socket_bytes = socket.as_bytes();
    let source = try joined(allocator, root_bytes, "long.txt");
    defer source.deinit(allocator);
    let source_bytes = source.as_bytes();
    var lines = string::new(allocator);
    defer lines.deinit(allocator);
    for 0..100 |_| {
        try append_line(allocator, &var lines, "line", "", "");
    }
    let text = lines.as_bytes();
    try fs::write_file(io::blocking(), source_bytes, text);
    var message = string::new(allocator);
    defer message.deinit(allocator);
    var policy = try default_policy(allocator);
    defer policy.deinit(allocator);
    policy.overflow = ArtifactOverflow::Reject;
    var refused = false;
    if register_test(allocator, &var message, socket_bytes, &policy, ArtifactKind::Text, "Long", source_bytes,
        "") |manifest| {
        manifest.deinit(allocator);
    } else |_| {
        refused = true;
    }
    let why = message.as_bytes();
    testing::expect(refused);
    testing::expect(contains(why, "exceeds the configured bounds"));
    let store = try joined(allocator, root_bytes, "artifacts");
    defer store.deinit(allocator);
    let store_bytes = store.as_bytes();
    testing::expect(!exists(allocator, store_bytes));
}

test "the store is beside the run directory of the socket" {
    let allocator = mem::page_allocator();
    var message = string::new(allocator);
    defer message.deinit(allocator);
    let beside_run = try artifact_root(allocator, &var message, "/home/alice/Satin/run/control.sock");
    defer beside_run.deinit(allocator);
    let first = beside_run.as_bytes();
    testing::expect(mem::equal_bytes(first, "/home/alice/Satin/artifacts"));
    let beside_socket = try artifact_root(allocator, &var message, "/tmp//work/./control.sock");
    defer beside_socket.deinit(allocator);
    let second = beside_socket.as_bytes();
    testing::expect(mem::equal_bytes(second, "/tmp/work/artifacts"));
    var refused = false;
    if artifact_root(allocator, &var message, "control.sock") |root| {
        root.deinit(allocator);
    } else |_| {
        refused = true;
    }
    testing::expect(refused);
    let in_root = try artifact_root(allocator, &var message, "/control.sock");
    defer in_root.deinit(allocator);
    let third = in_root.as_bytes();
    testing::expect(mem::equal_bytes(third, "/artifacts"));
    let under_run = try artifact_root(allocator, &var message, "/run/control.sock");
    defer under_run.deinit(allocator);
    let fourth = under_run.as_bytes();
    testing::expect(mem::equal_bytes(fourth, "/artifacts"));
}

test "a title names its directory" {
    let allocator = mem::page_allocator();
    var slug = string::new(allocator);
    defer slug.deinit(allocator);
    try append_artifact_slug(allocator, &var slug, "  Renderer Notes: v2!  ");
    try slug.append_byte(allocator, 32);
    try append_artifact_slug(allocator, &var slug, "調査 結果");
    try slug.append_byte(allocator, 32);
    try append_artifact_slug(allocator, &var slug, "!!!");
    let bytes = slug.as_bytes();
    testing::expect(mem::equal_bytes(bytes, "renderer-notes-v2 調査-結果 artifact"));
}

test "a selector names an artifact and a version" {
    let allocator = mem::page_allocator();
    var message = string::new(allocator);
    defer message.deinit(allocator);
    var version: i64 = -1;
    testing::expect(try parse_artifact_selector(allocator, &var message, "a12", &var version) == 3);
    testing::expect(version == 0);
    testing::expect(try parse_artifact_selector(allocator, &var message, "a12@v3", &var version) == 3);
    testing::expect(version == 3);
    testing::expect(try parse_artifact_selector(allocator, &var message, "a12@12", &var version) == 3);
    testing::expect(version == 12);
    var refused: i64 = 0;
    if parse_artifact_selector(allocator, &var message, "a12@0", &var version) |_| {} else |_| {
        refused = refused + 1;
    }
    if parse_artifact_selector(allocator, &var message, "a12@x", &var version) |_| {} else |_| {
        refused = refused + 1;
    }
    if parse_artifact_selector(allocator, &var message, "A12", &var version) |_| {} else |_| {
        refused = refused + 1;
    }
    testing::expect(refused == 3);
}

test "a relative path stays inside its directory" {
    let allocator = mem::page_allocator();
    var message = string::new(allocator);
    defer message.deinit(allocator);
    try validate_relative_artifact_path(allocator, &var message, "versions/v001/artifact.md");
    var refused: i64 = 0;
    if validate_relative_artifact_path(allocator, &var message, "") {} else |_| {
        refused = refused + 1;
    }
    if validate_relative_artifact_path(allocator, &var message, "/etc/passwd") {} else |_| {
        refused = refused + 1;
    }
    if validate_relative_artifact_path(allocator, &var message, "versions/../../outside") {} else |_| {
        refused = refused + 1;
    }
    testing::expect(refused == 3);
    testing::expect(is_under("versions/v001/images/a.png", "versions/v001"));
    testing::expect(!is_under("versions/v0011/a.png", "versions/v001"));
}

test "a document previews as its first two lines of text" {
    let allocator = mem::page_allocator();
    let root = try test_directory(allocator, "preview");
    defer root.deinit(allocator);
    let root_bytes = root.as_bytes();
    defer remove_tree(allocator, root_bytes);
    let document = try joined(allocator, root_bytes, "artifact.md");
    defer document.deinit(allocator);
    let document_bytes = document.as_bytes();
    try fs::write_file(io::blocking(), document_bytes,
        \\---
        \\title: hidden
        \\---
        \\# Heading
        \\
        \\![Trend](images/chart.png)
        \\```text
        \\`cargo test`
        \\third
        \\
    );
    var message = string::new(allocator);
    defer message.deinit(allocator);
    let preview = try artifact_document_preview(allocator, &var message, document_bytes);
    defer preview.deinit(allocator);
    let bytes = preview.as_bytes();
    testing::expect(mem::equal_bytes(bytes, "Image · Trend · cargo test"));
}
