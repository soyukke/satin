#!/usr/bin/env bash
set -euo pipefail

app="${SATIN_NATIVE_EXECUTABLE:-spikes/macos-shell/.build/SatinApplication}"
result_file="spikes/macos-shell/.build/native-tmux-session-switch.result"
socket_name="satin-session-switch-smoke-$$"
first_session="satin-switch-first-$$"
second_session="satin-switch-second-$$"
tmux_executable="$(command -v tmux)"
smoke_root="$(mktemp -d "${TMPDIR:-/tmp}/satin-tmux-session-switch.XXXXXX")"
first_cwd="$smoke_root/first session cwd"

cleanup() {
  tmux -L "$socket_name" kill-server >/dev/null 2>&1 || true
  case "$smoke_root" in
    "${TMPDIR:-/tmp}"/satin-tmux-session-switch.*) rm -rf -- "$smoke_root" ;;
    *) echo "refusing unexpected smoke cleanup path: $smoke_root" >&2 ;;
  esac
}
trap cleanup EXIT

rm -f -- "$result_file"
mkdir -p -- "$first_cwd"
tmux -L "$socket_name" new-session -d -c "$first_cwd" -s "$first_session"
socket_path="$(tmux -L "$socket_name" display-message -p '#{socket_path}')"
tmux -S "$socket_path" new-session -d -s "$second_session"

tmux -S "$socket_path" send-keys -t "=$first_session:" -l \
  "printf 'SATIN_TMUX_SWITCH_FIRST_HISTORY\\n'; seq 1 180; printf 'SATIN_TMUX_SWITCH_FIRST_READY\\n'"
tmux -S "$socket_path" send-keys -t "=$first_session:" Enter
tmux -S "$socket_path" send-keys -t "=$second_session:" -l \
  "printf 'SATIN_TMUX_SWITCH_SECOND_READY\\n'"
tmux -S "$socket_path" send-keys -t "=$second_session:" Enter

ready=false
for _ in {1..40}; do
  if tmux -S "$socket_path" capture-pane -p -t "=$first_session:" |
    rg --fixed-strings --quiet "SATIN_TMUX_SWITCH_FIRST_READY" &&
    tmux -S "$socket_path" capture-pane -p -t "=$second_session:" |
    rg --fixed-strings --quiet "SATIN_TMUX_SWITCH_SECOND_READY"; then
    ready=true
    break
  fi
  sleep 0.05
done
[[ "$ready" == true ]]

SATIN_NATIVE_SMOKE_SCENARIO=tmux-session-switch \
  SATIN_NATIVE_SMOKE_RESULT="$result_file" \
  SATIN_NATIVE_SMOKE_TMUX_FIRST_SESSION="$first_session" \
  SATIN_NATIVE_SMOKE_TMUX_SECOND_SESSION="$second_session" \
  SATIN_NATIVE_SMOKE_TMUX_SOCKET="$socket_path" \
  SATIN_NATIVE_SMOKE_TMUX_EXECUTABLE="$tmux_executable" \
  "$app" >"/tmp/satin-native-tmux-session-switch.log" 2>&1

if [[ ! -s "$result_file" ]]; then
  echo "tmux session switch smoke failed before result was written" >&2
  sed -n '1,200p' "/tmp/satin-native-tmux-session-switch.log" >&2 || true
  exit 1
fi

result="$(cat "$result_file")"
printf '%s\n' "$result"
if [[ "$result" != ok\ tmux-session-switch* ]]; then
  exit 1
fi
tmux -S "$socket_path" has-session -t "=$first_session"
tmux -S "$socket_path" has-session -t "=$second_session"
[[ -z "$(tmux -S "$socket_path" list-clients -F '#{client_control_mode}' \
  -f '#{client_control_mode}')" ]]
