#!/usr/bin/env bash
set -euo pipefail

app="spikes/macos-shell/.build/SatinApplication"
result_file="spikes/macos-shell/.build/native-terminal-exit-closes-tab.result"

rm -f "$result_file"

SATIN_NATIVE_SMOKE_SCENARIO=terminal-exit-closes-tab \
  SATIN_NATIVE_SMOKE_RESULT="$result_file" \
  "$app" >"/tmp/satin-terminal-exit-closes-tab.log" 2>&1

if [[ ! -s "$result_file" ]]; then
  echo "terminal exit closes tab smoke failed before result was written" >&2
  cat "/tmp/satin-terminal-exit-closes-tab.log" >&2 || true
  exit 1
fi

cat "$result_file"
grep -q '^ok terminal-exit-closes-tab ' "$result_file"
