#!/usr/bin/env bash
set -euo pipefail

app="spikes/macos-shell/.build/SatinApplication"
result_file="spikes/macos-shell/.build/native-terminal-vim-scroll.result"

rm -f "$result_file"

SATIN_NATIVE_SMOKE_SCENARIO=terminal-vim-scroll \
  SATIN_NATIVE_SMOKE_RESULT="$result_file" \
  "$app" >"/tmp/satin-terminal-vim-scroll.log" 2>&1

result=$(cat "$result_file")
echo "$result"
[[ "$result" == ok* ]]
