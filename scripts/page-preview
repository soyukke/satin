#!/usr/bin/env bash
# Serves page-renderer on localhost and prints the URL of a page drawn as the
# reader draws it, with a datasheet/paper switch. Usage:
#   scripts/page-preview [PAGE.md] [PORT]
# PAGE.md defaults to the sample and must lie below page-renderer.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)/page-renderer"
page="${1:-sample/artifact.md}"
port="${2:-8765}"

printf 'http://127.0.0.1:%s/index.html?page=%s&preview&lang=ja\n' "$port" "$page"
exec python3 -m http.server "$port" --bind 127.0.0.1 --directory "$root"
