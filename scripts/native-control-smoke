#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/native-control-smoke "$@"
fi

app="${SATIN_NATIVE_EXECUTABLE:-spikes/macos-shell/.build/SatinApplication}"
cli="${SATIN_CONTROL_EXECUTABLE:-target/debug/satin}"
cli="$(cd "$(dirname "$cli")" && pwd)/$(basename "$cli")"
app_arguments=(-restoreSession NO)
if [[ -n "${SATIN_CONTROL_SMOKE_SHELL:-}" ]]; then
  app_arguments+=(-shellPath "$SATIN_CONTROL_SMOKE_SHELL")
fi
smoke_root="$(mktemp -d "${TMPDIR:-/tmp}/satin-control-smoke.XXXXXX")"
socket="$smoke_root/control.sock"
app_log="$smoke_root/app.log"

SATIN_CONTROL_SOCKET="$socket" \
  SATIN_NATIVE_SMOKE_SCENARIO=control \
  "$app" "${app_arguments[@]}" >"$app_log" 2>&1 &
app_pid=$!

cleanup() {
  if kill -0 "$app_pid" 2>/dev/null; then
    kill "$app_pid" 2>/dev/null || true
    wait "$app_pid" 2>/dev/null || true
  fi
  rm -rf -- "$smoke_root"
}
trap cleanup EXIT INT TERM

for _ in {1..100}; do
  if [[ -S "$socket" ]] && kill -0 "$app_pid" 2>/dev/null; then
    break
  fi
  sleep 0.05
done
if [[ ! -S "$socket" ]]; then
  cat "$app_log" >&2
  echo "control smoke failed: socket was not created" >&2
  exit 1
fi
if [[ "$(/usr/bin/stat -f '%Lp' "$socket")" != "600" ]]; then
  echo "control smoke failed: socket is not mode 0600" >&2
  exit 1
fi

list="$("$cli" --socket "$socket" --json list)"
jq -e '.ok and .result.activeTab == 1 and (.result.panes | length) == 1' <<<"$list" >/dev/null
identify="$({
  SATIN_SOCKET="$socket" SATIN_TAB_ID=1 SATIN_PANE_ID=1 \
    "$cli" --json identify
})"
jq -e \
  '.ok and .result.tab.id == 1 and .result.pane.id == 1 and .result.pane.tab == 1' \
  <<<"$identify" >/dev/null

"$cli" --socket "$socket" send --pane 1 \
  "resolved_satin=\$(command -v satin 2>/dev/null || true); printf 'CONTROL_ENV:%s:%s:%s:%s:%s\\n' \"\$SATIN_TAB_ID\" \"\$SATIN_PANE_ID\" \"\$SATIN_SOCKET\" \"\$SATIN_CLI\" \"\$resolved_satin\"; if [ \"\$SATIN_TAB_ID:\$SATIN_PANE_ID:\$SATIN_SOCKET:\$SATIN_CLI\" = \"1:1:$socket:$cli\" ] && [ \"\$resolved_satin\" = \"\$SATIN_CLI\" ]; then echo CONTROL_READY:OK; else echo CONTROL_READY:BAD; fi" \
  >/dev/null
"$cli" --socket "$socket" key --pane 1 Enter >/dev/null
for _ in {1..100}; do
  screen="$("$cli" --socket "$socket" read-screen --pane 1)"
  if grep -Fq -- "CONTROL_READY:OK" <<<"$screen"; then
    break
  fi
  sleep 0.05
done
if ! grep -Fq -- "CONTROL_READY:OK" <<<"${screen:-}"; then
  printf '%s\n' "${screen:-<empty screen>}" >&2
  cat "$app_log" >&2
  echo "control smoke failed: pane environment or read-screen mismatch" >&2
  exit 1
fi

new_tab="$("$cli" --socket "$socket" --json new-tab \
  --cwd "$smoke_root" --title controlled --background)"
jq -e '.result.tab == 2 and .result.pane == 2' <<<"$new_tab" >/dev/null
background_tab="$("$cli" --socket "$socket" --json list)"
jq -e '
  .result.activeTab == 1
    and (.result.tabs[] | select(.id == 2) | .title == "controlled" and (.active | not))
' <<<"$background_tab" >/dev/null
"$cli" --socket "$socket" set-theme --tab 2 Harbor >/dev/null
"$cli" --socket "$socket" select-tab --tab 2 >/dev/null
"$cli" --socket "$socket" send --pane 2 \
  "printf '\\033]0;⠹ automatic-agent-title\\007'; sleep 0.4" >/dev/null
"$cli" --socket "$socket" key --pane 2 Enter >/dev/null
for _ in {1..100}; do
  manual_title_state="$("$cli" --socket "$socket" --json list)"
  if jq -e '
    (.result.tabs[] | select(.id == 2) | .title == "controlled")
      and (.result.panes[] | select(.id == 2) | .status.status == "running")
  ' <<<"$manual_title_state" >/dev/null; then
    break
  fi
  sleep 0.05
done
jq -e '
  (.result.tabs[] | select(.id == 2) | .title == "controlled")
    and (.result.panes[] | select(.id == 2) | .status.status == "running")
' <<<"${manual_title_state:-}" >/dev/null

split="$("$cli" --socket "$socket" --json split \
  --pane 2 --horizontal --cwd "$smoke_root" --background)"
jq -e '.result.tab == 2 and .result.pane == 3' <<<"$split" >/dev/null
background_split="$("$cli" --socket "$socket" --json list)"
jq -e '
  .result.activeTab == 2
    and (.result.tabs[] | select(.id == 2) | .activePane == 2)
' <<<"$background_split" >/dev/null
"$cli" --socket "$socket" select-pane --pane 3 >/dev/null
"$cli" --socket "$socket" move-tab --tab 2 --index 0 >/dev/null
moved="$("$cli" --socket "$socket" --json list)"
jq -e '
  .result.activeTab == 2
    and .result.tabs[0].id == 2
    and (.result.tabs[] | select(.id == 2) | .activePane == 3)
' <<<"$moved" >/dev/null

"$cli" --socket "$socket" send --pane 3 \
  "if [ \"\$SATIN_TAB_ID:\$SATIN_PANE_ID:\$SATIN_CLI\" = \"2:3:$cli\" ] && \"\$SATIN_CLI\" --json identify >/dev/null; then echo NEW_CONTEXT:OK; else echo NEW_CONTEXT:BAD; fi" \
  >/dev/null
"$cli" --socket "$socket" key --pane 3 Enter >/dev/null
for _ in {1..100}; do
  new_screen="$("$cli" --socket "$socket" read-screen --pane 3)"
  if grep -Fq -- "NEW_CONTEXT:OK" <<<"$new_screen"; then
    break
  fi
  sleep 0.05
done
if ! grep -Fq -- "NEW_CONTEXT:OK" <<<"${new_screen:-}"; then
  printf '%s\n' "${new_screen:-<empty screen>}" >&2
  cat "$app_log" >&2
  echo "control smoke failed: split pane identity mismatch" >&2
  exit 1
fi
"$cli" --socket "$socket" status session-start --pane 3 codex >/dev/null
session_status="$("$cli" --socket "$socket" --json list)"
jq -e '
  .result.panes[]
    | select(.id == 3)
    | .status.status == "idle" and .status.summary == "Codex ready"
' <<<"$session_status" >/dev/null

private_prompt="control smoke prompt must stay private"
printf '{"hook_event_name":"UserPromptSubmit","prompt":"%s"}\n' "$private_prompt" |
  "$cli" --socket "$socket" status event --pane 3 claude >/dev/null
running_status="$("$cli" --socket "$socket" --json list)"
jq -e '
  .result.panes[]
    | select(.id == 3)
    | .status.status == "running" and .status.summary == "Claude Code working"
' <<<"$running_status" >/dev/null
if grep -Fq -- "$private_prompt" <<<"$running_status"; then
  echo "control smoke failed: agent prompt leaked into pane status" >&2
  exit 1
fi

"$cli" --socket "$socket" --json status wait --pane 3 --timeout 5 >"$smoke_root/wait.json" &
wait_pid=$!
sleep 0.1
private_response="control smoke response must stay private"
printf '{"hook_event_name":"Stop","last_assistant_message":"%s"}\n' "$private_response" |
  "$cli" --socket "$socket" status event --pane 3 claude >/dev/null
wait "$wait_pid"
jq -e '.ok and .result.status == "done" and .result.summary == "Claude Code finished"' \
  "$smoke_root/wait.json" >/dev/null
if grep -Fq -- "$private_response" "$smoke_root/wait.json"; then
  echo "control smoke failed: agent response leaked into pane status" >&2
  exit 1
fi

"$cli" --socket "$socket" close-pane --pane 3 >/dev/null
closed_pane="$("$cli" --socket "$socket" --json list)"
jq -e '
  (.result.panes | all(.id != 3))
    and (.result.tabs[] | select(.id == 2) | .activePane == 2)
' <<<"$closed_pane" >/dev/null

disposable="$("$cli" --socket "$socket" --json new-tab \
  --cwd "$smoke_root" --title disposable --background)"
jq -e '.result.tab == 3 and .result.pane == 4' <<<"$disposable" >/dev/null
"$cli" --socket "$socket" close-tab --tab 3 >/dev/null

final="$("$cli" --socket "$socket" --json list)"
jq -e '
  .ok
    and .result.activeTab == 2
    and (.result.tabs | length) == 2
    and (.result.panes | length) == 2
    and .result.tabs[0].id == 2
    and (.result.tabs[] | select(.id == 2) | .title == "controlled" and .theme == "Harbor")
    and (.result.tabs | all(.id != 3))
    and (.result.panes | all(.id != 3 and .id != 4))
' <<<"$final" >/dev/null
"$cli" --socket "$socket" close-tab --tab 1 >/dev/null
if "$cli" --socket "$socket" close-tab --tab 2 >"$smoke_root/final-tab.out" 2>&1; then
  echo "control smoke failed: final tab close unexpectedly succeeded" >&2
  exit 1
fi
grep -F "final_tab" "$smoke_root/final-tab.out" >/dev/null
if "$cli" --socket "$socket" close-pane --pane 2 >"$smoke_root/final-pane.out" 2>&1; then
  echo "control smoke failed: final pane close unexpectedly succeeded" >&2
  exit 1
fi
grep -F "final_pane" "$smoke_root/final-pane.out" >/dev/null
safe_final="$("$cli" --socket "$socket" --json list)"
jq -e '
  .result.activeTab == 2
    and (.result.tabs | length) == 1
    and (.result.panes | length) == 1
    and .result.tabs[0].id == 2
' <<<"$safe_final" >/dev/null

echo "native control smoke passed"
