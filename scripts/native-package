#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/native-package "$@"
fi

version="$(cargo metadata --no-deps --format-version 1 | jq -r '.packages[0].version')"
build_number="${SATIN_BUILD_NUMBER:-$(git rev-list --count HEAD 2>/dev/null || printf '1')}"
package_root="spikes/macos-shell/.build/package"
app_path="$package_root/Satin.app"
contents="$app_path/Contents"
binary="$contents/MacOS/satin-app"
control_binary="$contents/MacOS/satin"
nvim_launcher="$contents/MacOS/satin-nvim"
plist_template="spikes/macos-shell/Info.plist.in"
entitlements="spikes/macos-shell/Satin.entitlements"
icon_source="assets/app-icon.png"
update_key_source="assets/update-signing-public-key.json"
update_helper_source="scripts/apply-update"
project_license_source="LICENSE"
third_party_notices_source="THIRD_PARTY_NOTICES.md"
font_license_source="assets/fonts/LICENSE"
iconset="$package_root/AppIcon.iconset"
identity="${APPLE_SIGNING_IDENTITY:--}"
minimum_macos="14.0"
host_arch="$(uname -m)"
if [[ "$host_arch" != "arm64" ]]; then
  echo "unsupported macOS architecture: $host_arch (Apple Silicon is required)" >&2
  exit 64
fi
swift_target="$host_arch-apple-macos$minimum_macos"
timestamp_option="--timestamp=none"
if [[ "$identity" != "-" ]]; then
  timestamp_option="--timestamp"
fi

case "$package_root" in
  spikes/macos-shell/.build/package) ;;
  *)
    echo "refusing unexpected package root: $package_root" >&2
    exit 64
    ;;
esac

rm -rf -- "$app_path"
mkdir -p "$contents/MacOS" "$contents/Resources"
legal_resources="$contents/Resources/Legal"
mkdir -p "$legal_resources"

sdk="$(env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun --sdk macosx --show-sdk-path)"
satin_sdk_version="$(env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun --sdk macosx --show-sdk-version)"
satin_sdk_major="${satin_sdk_version%%.*}"
swift_feature_flags=()
if [[ "$satin_sdk_major" =~ ^[0-9]+$ ]] && ((satin_sdk_major >= 26)); then
  swift_feature_flags=(-D SATIN_HAS_LIQUID_GLASS_SDK)
fi
portable_ldflags=("-L$sdk/usr/lib")
read -r -a inherited_ldflags <<<"${NIX_LDFLAGS:-}"
for flag in "${inherited_ldflags[@]}"; do
  case "$flag" in
    -L/nix/store/*-libiconv-*/lib) ;;
    *) portable_ldflags+=("$flag") ;;
  esac
done
NIX_LDFLAGS="${portable_ldflags[*]}" \
  MACOSX_DEPLOYMENT_TARGET="$minimum_macos" \
  cargo build --release --lib --bin satin --bin satin-nvim
tmp_binary="$package_root/satin.$$"
trap 'rm -f "$tmp_binary"' EXIT INT TERM

env -u SDKROOT -u DEVELOPER_DIR \
  /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc \
  -O \
  -parse-as-library \
  -warnings-as-errors \
  -whole-module-optimization \
  -sdk "$sdk" \
  -target "$swift_target" \
  "${swift_feature_flags[@]}" \
  spikes/macos-shell/AppUpdateChecker.swift \
  spikes/macos-shell/ControlHost.swift \
  spikes/macos-shell/PerformanceRecorder.swift \
  spikes/macos-shell/SatinFFI.swift \
  spikes/macos-shell/SettingsWindow.swift \
  spikes/macos-shell/SatinApplication.swift \
  spikes/macos-shell/UpdateInstaller.swift \
  target/release/libsatin.a \
  -framework AppKit \
  -framework CryptoKit \
  -framework MetalKit \
  -framework Metal \
  -framework QuartzCore \
  -lc++ \
  -o "$tmp_binary"
mv -f "$tmp_binary" "$binary"
/usr/bin/ditto target/release/satin "$control_binary"
/usr/bin/ditto target/release/satin-nvim "$nvim_launcher"
chmod 755 "$control_binary"
chmod 755 "$nvim_launcher"

rm -rf -- "$iconset"
mkdir -p "$iconset"
while read -r points pixels suffix; do
  /usr/bin/sips \
    --resampleHeightWidth "$pixels" "$pixels" \
    "$icon_source" \
    --out "$iconset/icon_${points}x${points}${suffix}.png" \
    >/dev/null
done <<'SIZES'
16 16
16 32 @2x
32 32
32 64 @2x
128 128
128 256 @2x
256 256
256 512 @2x
512 512
512 1024 @2x
SIZES
/usr/bin/iconutil -c icns "$iconset" -o "$contents/Resources/AppIcon.icns"
rm -rf -- "$iconset"
/usr/bin/ditto "$update_key_source" "$contents/Resources/update-signing-public-key.json"
/usr/bin/ditto "$update_helper_source" "$contents/Resources/apply-update"
/usr/bin/ditto "$project_license_source" "$legal_resources/LICENSE.txt"
/usr/bin/ditto "$third_party_notices_source" "$legal_resources/THIRD_PARTY_NOTICES.md"
/usr/bin/ditto "$font_license_source" "$legal_resources/FONT_LICENSE.txt"
mkdir -p "$contents/Resources/ShellIntegration"
/usr/bin/ditto scripts/shell-integration/zsh "$contents/Resources/ShellIntegration/zsh"
cargo about generate \
  --locked \
  --fail \
  about.hbs \
  -o "$legal_resources/RUST_DEPENDENCY_LICENSES.html"
chmod 755 "$contents/Resources/apply-update"

sed \
  -e "s/@VERSION@/$version/g" \
  -e "s/@BUILD_NUMBER@/$build_number/g" \
  -e "s/@MINIMUM_MACOS@/$minimum_macos/g" \
  -e "s/@DISPLAY_NAME@/Satin/g" \
  -e "s/@EXECUTABLE@/satin-app/g" \
  -e "s/@BUNDLE_ID@/dev.soyukke.satin/g" \
  -e "s/@DATA_DIRECTORY@/Satin/g" \
  -e "s/@DEVELOPMENT_BUILD@/false/g" \
  "$plist_template" >"$contents/Info.plist"
plutil -lint "$contents/Info.plist"
test -s "$contents/Resources/AppIcon.icns"
test -s "$legal_resources/LICENSE.txt"
test -s "$legal_resources/THIRD_PARTY_NOTICES.md"
test -s "$legal_resources/FONT_LICENSE.txt"
test -s "$legal_resources/RUST_DEPENDENCY_LICENSES.html"
jq -e '
  .schemaVersion == 1
    and .algorithm == "ed25519"
    and (.keyID | length > 0)
    and (.publicKey | length > 0)
' "$contents/Resources/update-signing-public-key.json" >/dev/null
test -x "$contents/Resources/apply-update"
test -x "$control_binary"
test -x "$nvim_launcher"
test -s "$contents/Resources/ShellIntegration/zsh/.zshrc"
for packaged_binary in "$binary" "$control_binary" "$nvim_launcher"; do
  if /usr/bin/otool -L "$packaged_binary" |
    awk 'NR > 1 { print $1 }' |
    grep -Eq '^/nix/store/'; then
    echo "packaged binary depends on the Nix store: $packaged_binary" >&2
    /usr/bin/otool -L "$packaged_binary" >&2
    exit 65
  fi
done
for auxiliary_binary in "$control_binary" "$nvim_launcher"; do
  if [[ "$(lipo -archs "$auxiliary_binary")" != "arm64" ]]; then
    echo "auxiliary binary is not exact arm64: $auxiliary_binary" >&2
    exit 65
  fi
done
actual_minimum="$(
  env -u SDKROOT -u DEVELOPER_DIR /usr/bin/vtool -show-build "$binary" |
    awk '/minos/ {print $2; exit}'
)"
control_minimum="$(
  env -u SDKROOT -u DEVELOPER_DIR /usr/bin/vtool -show-build "$control_binary" |
    awk '/minos/ {print $2; exit}'
)"
launcher_minimum="$(
  env -u SDKROOT -u DEVELOPER_DIR /usr/bin/vtool -show-build "$nvim_launcher" |
    awk '/minos/ {print $2; exit}'
)"
if [[ "$actual_minimum" != "$minimum_macos" || "$control_minimum" != "$minimum_macos" || "$launcher_minimum" != "$minimum_macos" ]]; then
  echo "unexpected minimum macOS: app=$actual_minimum cli=$control_minimum launcher=$launcher_minimum (expected $minimum_macos)" >&2
  exit 65
fi

/usr/bin/codesign \
  --force \
  --sign "$identity" \
  --options runtime \
  "$timestamp_option" \
  "$control_binary"

/usr/bin/codesign \
  --force \
  --sign "$identity" \
  --options runtime \
  "$timestamp_option" \
  "$nvim_launcher"

/usr/bin/codesign \
  --force \
  --sign "$identity" \
  --options runtime \
  "$timestamp_option" \
  --entitlements "$entitlements" \
  "$app_path"

/usr/bin/codesign --verify --deep --strict --verbose=2 "$app_path"
printf '%s\n' "$app_path"
