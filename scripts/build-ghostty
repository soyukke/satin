#!/bin/sh
# Builds libghostty-vt.a from the pinned Ghostty commit with zig and puts it
# at target/native/libghostty-vt.a, which kizu.toml's `[native]` searches.
# Needs git and zig 0.15 on PATH.
# Usage: scripts/build-ghostty [ReleaseFast|ReleaseSafe|Debug]
set -eu
repo=https://github.com/ghostty-org/ghostty.git
commit=a887df42c56f6de86c0fe6da9c4eeca37931e083
optimize=${1:-ReleaseFast}
root=$(cd "$(dirname "$0")/.." && pwd)
source=$root/target/ghostty/source
prefix=$root/target/ghostty/install

if [ "$(git -C "$source" rev-parse HEAD 2>/dev/null || true)" != "$commit" ]; then
    rm -rf "$source"
    mkdir -p "$source"
    git -C "$source" init -q
    git -C "$source" fetch -q --depth 1 "$repo" "$commit"
    git -C "$source" checkout -q FETCH_HEAD
fi

(cd "$source" && zig build \
    -Demit-lib-vt=true \
    "-Doptimize=$optimize" \
    -Demit-xcframework=false \
    -Dapp-runtime=none \
    --prefix "$prefix" \
    --cache-dir "$root/target/ghostty/zig-cache")

archive=$prefix/lib/libghostty-vt.a
if [ ! -f "$archive" ]; then
    echo "zig build left no $archive" >&2
    exit 1
fi
mkdir -p "$root/target/native"
ln -sf "$archive" "$root/target/native/libghostty-vt.a"
echo "target/native/libghostty-vt.a -> $archive"
