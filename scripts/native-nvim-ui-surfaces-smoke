#!/usr/bin/env bash
set -euo pipefail

app="spikes/macos-shell/.build/SatinApplication"
shot="spikes/macos-shell/.build/native-nvim-ui-surfaces.png"
result_file="spikes/macos-shell/.build/native-nvim-ui-surfaces.result"
window_id_file="spikes/macos-shell/.build/native-nvim-ui-surfaces-window-id"
capture_error="spikes/macos-shell/.build/native-nvim-ui-surfaces-screencapture.err"
verify_error="spikes/macos-shell/.build/native-nvim-ui-surfaces-verify.err"

rm -f "$shot" "$result_file" "$window_id_file" "$capture_error" "$verify_error"

SATIN_NATIVE_PANE=nvim \
  SATIN_NATIVE_SMOKE_SCENARIO=nvim-ui-surfaces \
  SATIN_NATIVE_SMOKE_RESULT="$result_file" \
  SATIN_NATIVE_SMOKE_WINDOW_ID="$window_id_file" \
  SATIN_NATIVE_SMOKE_KEEP_OPEN=1 \
  "$app" &
app_pid=$!

cleanup() {
  if kill -0 "$app_pid" 2>/dev/null; then
    kill "$app_pid" 2>/dev/null || true
    wait "$app_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT

for _ in {1..100}; do
  if [[ -s "$window_id_file" ]]; then
    break
  fi
  sleep 0.05
done

if [[ ! -s "$window_id_file" ]]; then
  echo "native ui surfaces smoke failed: window id was not written" >&2
  exit 1
fi

window_id=$(tr -d '[:space:]' < "$window_id_file")
if [[ -z "$window_id" ]]; then
  echo "native ui surfaces smoke failed: empty window id" >&2
  exit 1
fi

for _ in {1..100}; do
  if [[ -s "$result_file" ]] &&
    ./scripts/native-window-capture "$window_id" "$shot" 2>"$capture_error" &&
    [[ -s "$shot" ]] &&
    ./scripts/native-smoke-verify "$shot" nvim-ui-surfaces "$result_file" 2>"$verify_error"; then
    cat "$result_file"
    exit 0
  fi
  sleep 0.15
done

if [[ -s "$verify_error" ]]; then
  cat "$verify_error" >&2
elif [[ -s "$capture_error" ]]; then
  cat "$capture_error" >&2
else
  echo "native ui surfaces smoke failed before verifier ran" >&2
fi
exit 1
