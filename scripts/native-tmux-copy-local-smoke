#!/usr/bin/env bash
set -euo pipefail

# Run inside tmux, the tmux command and the application would reach the
# server of that session whatever TMUX_TMPDIR says, and the cleanup below
# would end it.
unset TMUX TMUX_PANE

app="${SATIN_NATIVE_EXECUTABLE:-spikes/macos-shell/.build/SatinApplication}"
result_file="spikes/macos-shell/.build/native-tmux-copy-local.result"
log_file="/tmp/satin-native-tmux-copy-local.log"
socket_name="satin-copy-local-smoke-$$"
session="satin-copy-local-$$"
tmux_executable="$(command -v tmux)"
smoke_root="$(mktemp -d "${TMPDIR:-/tmp}/satin-tmux-copy-local.XXXXXX")"
folder="$(cd "$smoke_root" && pwd -P)/local tabs"
default_tmux_root="$(mktemp -d /private/tmp/satin-tmux-default.XXXXXX)"
app_pid=""

cleanup() {
  if [[ -n "$app_pid" ]]; then
    kill "$app_pid" >/dev/null 2>&1 || true
    wait "$app_pid" 2>/dev/null || true
  fi
  tmux -L "$socket_name" kill-server >/dev/null 2>&1 || true
  case "$default_tmux_root" in
    /private/tmp/satin-tmux-default.*) rm -rf -- "$default_tmux_root" ;;
    *) echo "refusing unexpected tmux root cleanup path: $default_tmux_root" >&2 ;;
  esac
  case "$smoke_root" in
    "${TMPDIR:-/tmp}"/satin-tmux-copy-local.*) rm -rf -- "$smoke_root" ;;
    *) echo "refusing unexpected smoke cleanup path: $smoke_root" >&2 ;;
  esac
}
trap cleanup EXIT

rm -f -- "$result_file"
mkdir -p -- "$folder/left" "$folder/right" "$folder/second"
# A session that keeps the server up, so its socket is known up front.
tmux -L "$socket_name" new-session -d -s "satin-copy-local-keep-$$"
socket_path="$(tmux -L "$socket_name" display-message -p '#{socket_path}')"

/usr/bin/env -u LC_ALL -u LC_CTYPE -u LANG \
  TMUX_TMPDIR="$default_tmux_root" \
  SATIN_NATIVE_SMOKE_SCENARIO=tmux-copy-local \
  SATIN_NATIVE_SMOKE_RESULT="$result_file" \
  SATIN_NATIVE_SMOKE_TMUX_SESSION="$session" \
  SATIN_NATIVE_SMOKE_FOLDER="$folder" \
  SATIN_NATIVE_SMOKE_TMUX_SOCKET="$socket_path" \
  SATIN_NATIVE_SMOKE_TMUX_EXECUTABLE="$tmux_executable" \
  "$app" >"$log_file" 2>&1 &
app_pid=$!

for _ in {1..300}; do
  [[ -s "$result_file" ]] && break
  sleep 0.1
done
result="$(cat "$result_file" 2>/dev/null || true)"
printf '%s\n' "${result:-<no result>}"
if [[ "$result" != ok\ tmux-copy-local* ]]; then
  sed -n '1,120p' "$log_file" >&2 || true
  exit 1
fi

panes="$(tmux -S "$socket_path" list-panes -s -t "=$session" \
  -F '#{window_index}|#{window_active}|#{pane_left}|#{pane_current_path}')"
printf '%s\n' "$panes"
expected_windows="$(tmux -S "$socket_path" list-windows -t "=$session" | wc -l | tr -d ' ')"
first="$(sed -n 1p <<<"$panes")"
second="$(sed -n 2p <<<"$panes")"
third="$(sed -n 3p <<<"$panes")"
fail() {
  echo "tmux copy local smoke failed: $1" >&2
  exit 1
}
[[ "$expected_windows" == 2 ]] || fail "windows=$expected_windows"
[[ "$(wc -l <<<"$panes" | tr -d ' ')" == 3 ]] || fail "panes"
[[ "$first" == *"|0|0|$folder/left" ]] || fail "first pane: $first"
[[ "$second" == *"|$folder/right" && "${second#*|*|}" != 0\|* ]] || fail "second pane: $second"
[[ "${first%%|*}" == "${second%%|*}" ]] || fail "split panes are in one window"
[[ "$third" == *"|1|0|$folder/second" ]] || fail "second window: $third"
echo "native tmux copy local smoke passed"
