#!/usr/bin/env python3
import struct
import sys
import zlib


def main() -> int:
    path = sys.argv[1] if len(sys.argv) > 1 else "spikes/macos-shell/.build/native-smoke.png"
    mode = sys.argv[2] if len(sys.argv) > 2 else "terminal"
    width, height, pixels = read_png_rgba(path)
    if mode == "kitty":
        verify_kitty(width, height, pixels)
        return 0
    if mode == "nvim-shaped-text-visual":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_shaped_text_visual(width, height, pixels, result_path)
        return 0
    if mode == "nvim-cursor-switch":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_cursor_switch(width, height, pixels, result_path)
        return 0
    if mode == "nvim-ui-surfaces":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_ui_surfaces(width, height, pixels, result_path)
        return 0
    if mode == "nvim-popupmenu":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_popupmenu(width, height, pixels, result_path)
        return 0
    if mode == "nvim-cursor-shape":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_cursor_shape(width, height, pixels, result_path)
        return 0
    if mode == "nvim-cursor-normal-shape":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_cursor_normal_shape(width, height, pixels, result_path)
        return 0
    if mode == "nvim-cursor-replace-shape":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_cursor_replace_shape(width, height, pixels, result_path)
        return 0
    if mode == "nvim-cursor-blink":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_cursor_blink(width, height, pixels, result_path)
        return 0
    if mode == "nvim-file-tree-close":
        result_path = sys.argv[3] if len(sys.argv) > 3 else ""
        verify_file_tree_close(width, height, pixels, result_path)
        return 0
    if mode == "nvim-skia" and len(sys.argv) > 3:
        verify_nvim_skia(width, height, pixels, sys.argv[3])
        return 0
    if mode == "nvim-image" and len(sys.argv) > 3:
        verify_nvim_image(width, height, pixels, sys.argv[3])
        return 0

    focus_blue = 0
    dark_surface = 0
    terminal_text = 0

    for y in range(height):
        for x in range(width):
            r, g, b, a = pixels[y][x]
            if a > 200 and b > 100 and g > 45 and b - r > 75 and b - g > 45:
                focus_blue += 1
            if y > height // 4 and a > 200 and r < 35 and g < 40 and b < 50:
                dark_surface += 1
            if y > height // 8 and a > 200 and r > 170 and g > 170 and b > 160:
                terminal_text += 1

    if width < 800 or height < 500:
        raise SystemExit(f"native smoke image is too small: {width}x{height}")
    if mode == "terminal" and focus_blue < 150:
        raise SystemExit(
            f"native smoke active pane outline missing: focus_blue={focus_blue}"
        )
    if dark_surface < 100_000:
        raise SystemExit(f"native smoke terminal surface missing: dark={dark_surface}")
    # The native toolbar no longer contributes custom white tab labels to this
    # count. Compact AppKit windows also dim inactive terminal glyphs, so keep
    # the gate focused on the presence of rendered text instead of key state.
    min_text = 80
    if terminal_text < min_text:
        raise SystemExit(f"native smoke terminal text missing: text={terminal_text}")
    if mode == "terminal" and len(sys.argv) > 3:
        verify_native_smoke_result(sys.argv[3])

    print(
        f"native smoke verified: mode={mode} {width}x{height} focus_blue={focus_blue} "
        f"dark_surface={dark_surface} terminal_text={terminal_text}"
    )
    return 0


def verify_kitty(width: int, height: int, pixels) -> None:
    saturated = 0
    dark_surface = 0
    for y in range(height // 8, height):
        for x in range(width):
            r, g, b, a = pixels[y][x]
            if a > 200 and max(r, g, b) > 150 and max(r, g, b) - min(r, g, b) > 80:
                saturated += 1
            if a > 200 and r < 35 and g < 40 and b < 50:
                dark_surface += 1
    if width < 800 or height < 500:
        raise SystemExit(f"kitty smoke image is too small: {width}x{height}")
    if dark_surface < 100_000:
        raise SystemExit(f"kitty smoke terminal surface missing: dark={dark_surface}")
    if saturated < 2_000:
        raise SystemExit(f"kitty smoke image pixels missing: saturated={saturated}")
    print(
        f"native kitty smoke verified: {width}x{height} "
        f"dark_surface={dark_surface} saturated={saturated}"
    )


def verify_nvim_skia(width: int, height: int, pixels, result_path: str) -> None:
    result = read_prefixed_result(result_path, "ok nvim-skia ")
    marker = parse_named_cell(result, "marker-cell", "marker")
    text_count = int(parse_result_field(result, "text"))
    if text_count != 1:
        raise SystemExit(f"nvim skia marker count mismatch: {text_count}")

    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )
    cell_x, cell_y, cell_pixel_width, cell_pixel_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        marker["row"],
        marker["col"],
    )
    stats = cell_ink_stats(
        pixels,
        cell_x,
        cell_y,
        cell_pixel_width,
        cell_pixel_height,
    )
    if not glyph_region_visible(stats, cell_pixel_width, cell_pixel_height, "marker"):
        raise SystemExit(f"nvim skia marker glyph pixels missing: {stats}")

    print(
        "native nvim skia verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} "
        f"marker={marker['row']}:{marker['col']} "
        f"ink={stats['ink']}"
    )


def verify_nvim_image(width: int, height: int, pixels, result_path: str) -> None:
    result = read_prefixed_result(result_path, "ok nvim-image ")
    if int(parse_result_field(result, "images")) != 1:
        raise SystemExit(f"native nvim image placement missing: {result}")
    if parse_result_field(result, "skia-frames") != "yes":
        raise SystemExit(f"native nvim image did not use Skia: {result}")

    red = 0
    for row in pixels:
        for r, g, b, a in row:
            if a > 200 and r > 200 and g < 40 and b < 40:
                red += 1
    if red < 20_000:
        raise SystemExit(f"native nvim image pixels missing: red={red}")
    print(f"native nvim image verified: {width}x{height} red={red}")


def verify_file_tree_close(width: int, height: int, pixels, result_path: str) -> None:
    result = read_prefixed_result(result_path, "ok file-tree-close ")
    boundary = int(parse_result_field(result, "boundary"))
    marker = parse_named_cell(result, "marker", "marker")
    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )
    if marker["row"] != 0:
        raise SystemExit(f"file tree close marker is not on first row: {marker}")

    separator_x, separator_y, separator_width, separator_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        0,
        boundary,
        rows=30,
    )
    sample_height = min(height - separator_y, separator_height)
    stats = cell_ink_stats(
        pixels,
        separator_x,
        separator_y,
        separator_width,
        sample_height,
    )
    if stats["ink"] > 8:
        raise SystemExit(
            "file tree separator pixels remain after close: "
            f"boundary={boundary} stats={stats}"
        )

    print(
        "native file tree close verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} boundary={boundary} "
        f"ink={stats['ink']}"
    )


def verify_native_smoke_result(result_path: str) -> None:
    result = read_prefixed_result(result_path, "ok native-smoke ")
    if parse_result_field(result, "skia-frames") != "yes":
        raise SystemExit(f"native smoke did not use skia terminal renderer: {result}")


def verify_shaped_text_visual(width: int, height: int, pixels, result_path: str) -> None:
    if not result_path:
        raise SystemExit("shaped text visual smoke missing result path")
    result = read_result(result_path)
    cells = parse_cells(result)
    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )

    failures = []
    for label in ("jp1", "jp2", "jp3", "nerd", "combining", "ambiguous"):
        row, col = cells[label]
        width_cells = 2 if label.startswith("jp") else 1
        cell_x, cell_y, cell_pixel_width, cell_pixel_height = captured_cell_rect(
            origin_x,
            origin_y,
            cell_width,
            cell_height,
            row,
            col,
            cols=width_cells,
        )
        stats = cell_ink_stats(
            pixels,
            cell_x,
            cell_y,
            cell_pixel_width,
            cell_pixel_height,
        )
        single_cell_width = max(1, round(cell_pixel_width / width_cells))
        if not glyph_region_visible(stats, single_cell_width, cell_pixel_height, label):
            failures.append(f"{label}:{stats}")

    if failures:
        raise SystemExit("shaped text glyph pixels missing: " + "; ".join(failures))

    print(
        "native shaped text visual verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} labels={','.join(cells)}"
    )


def verify_cursor_switch(width: int, height: int, pixels, result_path: str) -> None:
    if not result_path:
        raise SystemExit("cursor switch smoke missing result path")
    result = read_prefixed_result(result_path, "ok cursor-switch ")
    old_row, old_col = parse_row_col_field(result, "old")
    new_row, new_col = parse_row_col_field(result, "new")
    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )
    new_x, new_y, new_width, new_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        new_row,
        new_col,
    )
    old_x, old_y, old_width, old_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        old_row,
        old_col,
    )

    new_stats = cursor_cell_stats(
        pixels,
        new_x,
        new_y,
        new_width,
        new_height,
    )
    old_stats = cursor_cell_stats(
        pixels,
        old_x,
        old_y,
        old_width,
        old_height,
    )
    min_cursor_pixels = max(40, new_width * new_height // 4)
    if new_stats["cursor"] < min_cursor_pixels:
        raise SystemExit(f"new cursor body pixels missing: {new_stats}")
    if old_stats["cursor"] > 8:
        raise SystemExit(f"previous pane cursor/trail pixels remain: {old_stats}")

    print(
        "native cursor switch verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} "
        f"new={new_row}:{new_col} old={old_row}:{old_col}"
    )


def verify_ui_surfaces(width: int, height: int, pixels, result_path: str) -> None:
    if not result_path:
        raise SystemExit("ui surfaces smoke missing result path")
    result = read_prefixed_result(result_path, "ok ui-surfaces ")
    blend = parse_blend_cell(result)
    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )
    cell_x, cell_y, cell_pixel_width, cell_pixel_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        blend["row"],
        blend["col"],
    )
    stats = blended_cell_stats(
        pixels,
        cell_x,
        cell_y,
        cell_pixel_width,
        cell_pixel_height,
    )
    expected = blended_rgb(blend["bg"], blend["base"], blend["amount"])
    distance = color_distance(stats["average"], expected)
    if distance > 28:
        raise SystemExit(
            "ui surface blended cell color mismatch: "
            f"average={stats['average']} expected={expected} distance={distance:.1f}"
        )

    float_cell = parse_named_cell(result, "float-cell", "float")
    float_x, float_y, float_width, float_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        float_cell["row"],
        float_cell["col"],
    )
    float_stats = cell_ink_stats(
        pixels,
        float_x,
        float_y,
        float_width,
        float_height,
    )
    if not glyph_region_visible(float_stats, float_width, float_height, "float"):
        raise SystemExit(f"ui surface overlapping float glyph pixels missing: {float_stats}")

    print(
        "native ui surfaces verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} "
        f"blend={blend['row']}:{blend['col']} "
        f"average={stats['average']} expected={expected} float-ink={float_stats['ink']}"
    )


