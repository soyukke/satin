        f"popup={popup['row']}:{popup['col']} "
        f"ink={stats['ink']}"
    )


def verify_cursor_shape(width: int, height: int, pixels, result_path: str) -> None:
    if not result_path:
        raise SystemExit("cursor shape smoke missing result path")
    result = read_prefixed_result(result_path, "ok cursor-shape ")
    cursor = parse_cursor_detail(result)
    if cursor["style"] != "bar" or cursor["percentage"] != 25:
        raise SystemExit(f"cursor shape result is not expected insert bar: {cursor}")
    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )
    cell_x, cell_y, cell_pixel_width, cell_pixel_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        cursor["row"],
        cursor["col"],
    )
    stats = bar_cursor_stats(
        pixels,
        cell_x,
        cell_y,
        cell_pixel_width,
        cell_pixel_height,
        cursor["percentage"],
    )
    min_bar_pixels = max(20, stats["bar_width"] * cell_pixel_height // 8)
    if stats["bar"] < min_bar_pixels:
        raise SystemExit(f"bar cursor pixels missing: {stats}")
    if stats["outside"] > 8:
        raise SystemExit(f"bar cursor is too wide: {stats}")

    print(
        "native cursor shape verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} "
        f"cursor={cursor['row']}:{cursor['col']} "
        f"bar={stats['bar']} outside={stats['outside']}"
    )


def verify_cursor_normal_shape(width: int, height: int, pixels, result_path: str) -> None:
    if not result_path:
        raise SystemExit("cursor normal shape smoke missing result path")
    result = read_prefixed_result(result_path, "ok cursor-normal-shape ")
    cursor = parse_cursor_detail(result)
    if cursor["style"] != "block":
        raise SystemExit(f"cursor normal result is not expected block: {cursor}")
    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )
    cell_x, cell_y, cell_pixel_width, cell_pixel_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        cursor["row"],
        cursor["col"],
    )
    stats = cursor_cell_stats(
        pixels,
        cell_x,
        cell_y,
        cell_pixel_width,
        cell_pixel_height,
    )
    min_cursor_pixels = max(40, cell_pixel_width * cell_pixel_height // 4)
    if stats["cursor"] < min_cursor_pixels:
        raise SystemExit(f"block cursor pixels missing: {stats}")

    print(
        "native cursor normal shape verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} "
        f"cursor={cursor['row']}:{cursor['col']} "
        f"pixels={stats['cursor']}"
    )


def verify_cursor_replace_shape(width: int, height: int, pixels, result_path: str) -> None:
    if not result_path:
        raise SystemExit("cursor replace shape smoke missing result path")
    result = read_prefixed_result(result_path, "ok cursor-replace-shape ")
    cursor = parse_cursor_detail(result)
    if cursor["style"] != "underline" or cursor["percentage"] != 20:
        raise SystemExit(f"cursor replace result is not expected underline: {cursor}")
    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )
    cell_x, cell_y, cell_pixel_width, cell_pixel_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        cursor["row"],
        cursor["col"],
    )
    stats = underline_cursor_stats(
        pixels,
        cell_x,
        cell_y,
        cell_pixel_width,
        cell_pixel_height,
        cursor["percentage"],
    )
    min_underline_pixels = max(20, cell_pixel_width)
    if stats["underline"] < min_underline_pixels:
        raise SystemExit(f"underline cursor pixels missing: {stats}")
    if stats["above"] > 8:
        raise SystemExit(f"underline cursor is too tall: {stats}")

    print(
        "native cursor replace shape verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} "
        f"cursor={cursor['row']}:{cursor['col']} "
        f"underline={stats['underline']} above={stats['above']}"
    )


def verify_cursor_blink(width: int, height: int, pixels, result_path: str) -> None:
    if not result_path:
        raise SystemExit("cursor blink smoke missing result path")
    result = read_prefixed_result(result_path, "ok cursor-blink ")
    cursor = parse_cursor_detail(result)
    if cursor["style"] != "bar" or cursor["blinkoff"] < 1000:
        raise SystemExit(f"cursor blink result is not expected long off-phase bar: {cursor}")
    origin_x, origin_y, cell_width, cell_height = captured_grid_geometry_from_result(
        width,
        height,
        result,
    )
    cell_x, cell_y, cell_pixel_width, cell_pixel_height = captured_cell_rect(
        origin_x,
        origin_y,
        cell_width,
        cell_height,
        cursor["row"],
        cursor["col"],
    )
    stats = bar_cursor_stats(
        pixels,
        cell_x,
        cell_y,
        cell_pixel_width,
        cell_pixel_height,
        cursor["percentage"],
    )
    if stats["bar"] > 8 or stats["outside"] > 8:
        raise SystemExit(f"cursor should be hidden during blink off phase: {stats}")

    print(
        "native cursor blink verified: "
        f"{width}x{height} origin={origin_x:.2f},{origin_y:.2f} "
        f"cell={cell_width:.2f}x{cell_height:.2f} "
        f"cursor={cursor['row']}:{cursor['col']} "
        f"bar={stats['bar']} outside={stats['outside']}"
    )


def read_result(path: str) -> str:
    return read_prefixed_result(path, "ok shaped-text ")


def read_prefixed_result(path: str, prefix: str) -> str:
    with open(path, encoding="utf-8") as file:
        result = file.read().strip()
    if not result.startswith(prefix):
        raise SystemExit(f"smoke did not pass: {result}")
    return result


def parse_geometry(result: str):
    value = parse_result_field(result, "geometry")
    parts = value.split(":")
    if len(parts) != 4:
        raise SystemExit(f"bad shaped text geometry: {value}")
    origin_x, origin_y, cell_width, cell_height = (float(part) for part in parts)
    if cell_width <= 0 or cell_height <= 0:
        raise SystemExit(f"bad shaped text cell size: {value}")
    return {
        "origin_x": origin_x,
        "origin_y": origin_y,
        "cell_width": cell_width,
        "cell_height": cell_height,
    }


def parse_viewport(result: str):
    value = parse_result_field(result, "viewport")
    parts = value.split(":")
    if len(parts) != 2:
        raise SystemExit(f"bad renderer viewport: {value}")
    width, height = (int(part) for part in parts)
    if width <= 0 or height <= 0:
        raise SystemExit(f"bad renderer viewport size: {value}")
    return {"width": width, "height": height}


def captured_grid_geometry(width: int, height: int, geometry, viewport):
    capture_scale = width / viewport["width"]
    captured_viewport_height = viewport["height"] * capture_scale
    titlebar_height = max(0.0, height - captured_viewport_height)
    return (
        geometry["origin_x"] * capture_scale,
        titlebar_height + geometry["origin_y"] * capture_scale,
        geometry["cell_width"] * capture_scale,
        geometry["cell_height"] * capture_scale,
    )


def captured_grid_geometry_from_result(width: int, height: int, result: str):
    return captured_grid_geometry(
        width,
        height,
        parse_geometry(result),
        parse_viewport(result),
    )


def captured_cell_rect(
    origin_x: float,
    origin_y: float,
    cell_width: float,
    cell_height: float,
    row: int,
    col: int,
    rows: int = 1,
    cols: int = 1,
):
    left = round(origin_x + col * cell_width)
    top = round(origin_y + row * cell_height)
    right = round(origin_x + (col + cols) * cell_width)
    bottom = round(origin_y + (row + rows) * cell_height)
    return left, top, max(1, right - left), max(1, bottom - top)


def parse_cells(result: str):
    value = parse_result_field(result, "cells")
    cells = {}
    for entry in value.split(","):
        parts = entry.split(":")
        if len(parts) != 3:
            raise SystemExit(f"bad shaped text cell entry: {entry}")
        label, row, col = parts
        cells[label] = (int(row), int(col))
    expected = {"jp1", "jp2", "jp3", "nerd", "combining", "ambiguous"}
    missing = expected - set(cells)
    if missing:
        raise SystemExit(f"shaped text cell metadata missing: {sorted(missing)}")
    return cells


def parse_row_col_field(result: str, name: str):
    value = parse_result_field(result, name)
    parts = value.split(":")
    if len(parts) != 2:
        raise SystemExit(f"bad row/col field {name}: {value}")
    return int(parts[0]), int(parts[1])


def parse_blend_cell(result: str):
    value = parse_result_field(result, "blend-cell")
    parts = value.split(":")
    if len(parts) != 9:
        raise SystemExit(f"bad blend cell field: {value}")
    numbers = [int(part) for part in parts]
    row, col, amount, bg_r, bg_g, bg_b, base_r, base_g, base_b = numbers
    if not 0 <= amount <= 100:
        raise SystemExit(f"bad blend amount: {amount}")
    return {
        "row": row,
        "col": col,
        "amount": amount,
        "bg": (bg_r, bg_g, bg_b),
        "base": (base_r, base_g, base_b),
    }


def parse_cursor_detail(result: str):
    value = parse_result_field(result, "cursor")
    parts = value.split(":")
    if len(parts) != 7:
        raise SystemExit(f"bad cursor detail field: {value}")
    row, col, style, percentage, blinkwait, blinkon, blinkoff = parts
    return {
        "row": int(row),
        "col": int(col),
        "style": style,
        "percentage": int(percentage),
        "blinkwait": int(blinkwait),
        "blinkon": int(blinkon),
        "blinkoff": int(blinkoff),
    }


def parse_named_cell(result: str, field: str, expected_label: str):
    value = parse_result_field(result, field)
    parts = value.split(":")
    if len(parts) != 3:
        raise SystemExit(f"bad cell field {field}: {value}")
    label, row, col = parts
    if label != expected_label:
        raise SystemExit(f"unexpected cell label for {field}: {label}")
    return {"row": int(row), "col": int(col)}


def parse_result_field(result: str, name: str) -> str:
    prefix = f"{name}="
    for field in result.split():
        if field.startswith(prefix):
            return field[len(prefix) :]
    raise SystemExit(f"shaped text result missing {name}: {result}")


def is_terminal_background(r: int, g: int, b: int, a: int) -> bool:
    return a > 200 and r < 35 and g < 40 and b < 50


def cell_ink_stats(pixels, x: int, y: int, width: int, height: int):
    image_height = len(pixels)
    image_width = len(pixels[0]) if image_height else 0
    left = max(0, x)
    top = max(0, y)
    right = min(image_width, x + width)
    bottom = min(image_height, y + height)
    ink = 0
    xs = []
    ys = []
    center_ink = 0
    center_left = left + max(1, (right - left) // 4)
    center_right = right - max(1, (right - left) // 4)
    center_top = top + max(1, (bottom - top) // 4)
    center_bottom = bottom - max(1, (bottom - top) // 4)
    for yy in range(top, bottom):
        for xx in range(left, right):
            r, g, b, a = pixels[yy][xx]
            if is_glyph_pixel(r, g, b, a):
                ink += 1
                xs.append(xx)
                ys.append(yy)
                if center_left <= xx < center_right and center_top <= yy < center_bottom:
                    center_ink += 1
    if not xs:
        return {"ink": 0, "width": 0, "height": 0, "center": 0}
    return {
        "ink": ink,
        "width": max(xs) - min(xs) + 1,
        "height": max(ys) - min(ys) + 1,
        "center": center_ink,
    }


def cursor_cell_stats(pixels, x: int, y: int, width: int, height: int):
    image_height = len(pixels)
    image_width = len(pixels[0]) if image_height else 0
    left = max(0, x)
    top = max(0, y)
    right = min(image_width, x + width)
    bottom = min(image_height, y + height)
    cursor = 0
    for yy in range(top, bottom):
        for xx in range(left, right):
            r, g, b, a = pixels[yy][xx]
            if is_cursor_pixel(r, g, b, a) or is_glyph_pixel(r, g, b, a):
                cursor += 1
    return {"cursor": cursor, "area": max(0, right - left) * max(0, bottom - top)}


def blended_cell_stats(pixels, x: int, y: int, width: int, height: int):
    image_height = len(pixels)
    image_width = len(pixels[0]) if image_height else 0
    inset_x = max(1, width // 4)
    inset_y = max(1, height // 4)
    left = max(0, x + inset_x)
    top = max(0, y + inset_y)
    right = min(image_width, x + width - inset_x)
    bottom = min(image_height, y + height - inset_y)
    if left >= right or top >= bottom:
        raise SystemExit("blended cell sample region is empty")
    red = green = blue = count = 0
    for yy in range(top, bottom):
        for xx in range(left, right):
            r, g, b, _ = pixels[yy][xx]
            red += r
            green += g
            blue += b
            count += 1
    return {"average": (red // count, green // count, blue // count), "count": count}


def bar_cursor_stats(pixels, x: int, y: int, width: int, height: int, percentage: int):
    image_height = len(pixels)
    image_width = len(pixels[0]) if image_height else 0
    bar_width = max(1, round(width * max(1, min(percentage, 100)) / 100))
    left = max(0, x)
    top = max(0, y)
    right = min(image_width, x + width)
    bottom = min(image_height, y + height)
    bar_right = min(right, left + bar_width + 1)
    outside_left = min(right, left + bar_width + 2)
    bar = 0
    outside = 0
    for yy in range(top, bottom):
        for xx in range(left, right):
            r, g, b, a = pixels[yy][xx]
            if not is_visual_cursor_pixel(r, g, b, a):
                continue
            if xx < bar_right:
                bar += 1
            elif xx >= outside_left:
                outside += 1
    return {"bar": bar, "outside": outside, "bar_width": bar_width}


def underline_cursor_stats(pixels, x: int, y: int, width: int, height: int, percentage: int):
    image_height = len(pixels)
    image_width = len(pixels[0]) if image_height else 0
    underline_height = max(1, round(height * max(1, min(percentage, 100)) / 100))
    left = max(0, x)
    top = max(0, y)
    right = min(image_width, x + width)
    bottom = min(image_height, y + height)
    underline_top = max(top, bottom - underline_height - 1)
    above_bottom = max(top, bottom - underline_height - 2)
    underline = 0
    above = 0
    for yy in range(top, bottom):
        for xx in range(left, right):
            r, g, b, a = pixels[yy][xx]
            if not is_visual_cursor_pixel(r, g, b, a):
                continue
            if yy >= underline_top:
                underline += 1
            elif yy < above_bottom:
                above += 1
    return {"underline": underline, "above": above, "underline_height": underline_height}


def blended_rgb(background, base, blend: int):
    alpha = (100 - blend) / 100.0
    return tuple(round(background[index] * alpha + base[index] * (1.0 - alpha)) for index in range(3))


def color_distance(left, right) -> float:
    return sum((left[index] - right[index]) ** 2 for index in range(3)) ** 0.5


def is_glyph_pixel(r: int, g: int, b: int, a: int) -> bool:
    return a > 180 and r > 120 and g > 120 and b > 110


def is_cursor_pixel(r: int, g: int, b: int, a: int) -> bool:
    return a > 180 and r > 145 and g > 135 and b > 115 and r >= b + 10 and g >= b + 5


def is_visual_cursor_pixel(r: int, g: int, b: int, a: int) -> bool:
    return is_cursor_pixel(r, g, b, a) or is_glyph_pixel(r, g, b, a)


def glyph_region_visible(stats, cell_width: int, cell_height: int, label: str) -> bool:
    min_ink = 10
    min_width = max(2, cell_width // 5)
    min_height = max(4, cell_height // 4)
    if label.startswith("jp"):
        min_ink = 20
        min_width = max(4, cell_width // 3)
        min_height = max(6, cell_height // 3)
    return (
        stats["ink"] >= min_ink
        and stats["width"] >= min_width
        and stats["height"] >= min_height
    )


def read_png_rgba(path: str):
    with open(path, "rb") as file:
        data = file.read()
    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
        raise SystemExit("not a png")

    pos = 8
    width = height = bit_depth = color_type = None
    compressed = bytearray()
    while pos < len(data):
        length = struct.unpack(">I", data[pos : pos + 4])[0]
        chunk_type = data[pos + 4 : pos + 8]
        chunk = data[pos + 8 : pos + 8 + length]
        pos += 12 + length

        if chunk_type == b"IHDR":
            width, height, bit_depth, color_type = parse_ihdr(chunk)
        elif chunk_type == b"IDAT":
            compressed.extend(chunk)
        elif chunk_type == b"IEND":
            break

    if bit_depth != 8 or color_type not in (2, 6):
        raise SystemExit(f"unsupported png format: bit_depth={bit_depth} color_type={color_type}")

    channels = 4 if color_type == 6 else 3
    raw = zlib.decompress(bytes(compressed))
    rows = unfilter_rows(raw, width, height, channels)
    return width, height, to_rgba(rows, color_type)


def parse_ihdr(chunk: bytes):
    width, height = struct.unpack(">II", chunk[:8])
    return width, height, chunk[8], chunk[9]


def unfilter_rows(raw: bytes, width: int, height: int, channels: int):
    stride = width * channels
    rows = []
    pos = 0
    previous = [0] * stride
    for _ in range(height):
        filter_type = raw[pos]
        pos += 1
        row = list(raw[pos : pos + stride])
        pos += stride
        apply_filter(row, previous, channels, filter_type)
        rows.append(row)
        previous = row
    return rows


def apply_filter(row, previous, channels: int, filter_type: int) -> None:
    for idx, value in enumerate(row):
        left = row[idx - channels] if idx >= channels else 0
        up = previous[idx]
        up_left = previous[idx - channels] if idx >= channels else 0

        if filter_type == 0:
            delta = 0
        elif filter_type == 1:
            delta = left
        elif filter_type == 2:
            delta = up
        elif filter_type == 3:
            delta = (left + up) // 2
        elif filter_type == 4:
            delta = paeth(left, up, up_left)
        else:
            raise SystemExit(f"unsupported png filter: {filter_type}")

        row[idx] = (value + delta) & 0xFF


def paeth(left: int, up: int, up_left: int) -> int:
    estimate = left + up - up_left
    left_distance = abs(estimate - left)
    up_distance = abs(estimate - up)
    up_left_distance = abs(estimate - up_left)
    if left_distance <= up_distance and left_distance <= up_left_distance:
        return left
    if up_distance <= up_left_distance:
        return up
    return up_left


def to_rgba(rows, color_type: int):
    pixels = []
    for row in rows:
        pixel_row = []
        step = 4 if color_type == 6 else 3
        for idx in range(0, len(row), step):
            if color_type == 6:
                pixel_row.append(tuple(row[idx : idx + 4]))
            else:
                pixel_row.append((*row[idx : idx + 3], 255))
        pixels.append(pixel_row)
    return pixels


if __name__ == "__main__":
    raise SystemExit(main())
