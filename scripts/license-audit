#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/license-audit "$@"
fi

expected_fira_hash="f6ce2df86c65720b6aa0b1c948bcc63b16ce21a441488e61fb3b5e8b56486b3a"
expected_last_resort_hash="2cdfa3f7d70ee06c32e9bb37c94634cecd54ba018e5a8110e853b394e0f91f01"
expected_neovide_revision="618605b79d70577f4b7ec92b50b3b9b5bf482c1a"
expected_message_selection_revision="7f90c1276c4daafc60923bb1be3f175b504969d0"
actual_fira_hash="$(shasum -a 256 assets/fonts/FiraCodeNerdFont-Regular.ttf | awk '{print $1}')"
actual_last_resort_hash="$(shasum -a 256 assets/fonts/LastResort-Regular.ttf | awk '{print $1}')"
test "$actual_fira_hash" = "$expected_fira_hash"
test "$actual_last_resort_hash" = "$expected_last_resort_hash"

grep -F "Copyright (c) 2023 Neovide Contributors" THIRD_PARTY_NOTICES.md >/dev/null
grep -F "Copyright (c) 2023 Neovide Contributors" core/src/term/render.kizu >/dev/null
cmp -s assets/fonts/FiraCodeNerdFont-Regular.ttf core/assets/fonts/FiraCodeNerdFont-Regular.ttf
cmp -s assets/fonts/LastResort-Regular.ttf core/assets/fonts/LastResort-Regular.ttf
grep -F "$expected_neovide_revision" THIRD_PARTY_NOTICES.md >/dev/null
grep -F "$expected_message_selection_revision" THIRD_PARTY_NOTICES.md >/dev/null
grep -F "$expected_fira_hash" THIRD_PARTY_NOTICES.md >/dev/null
grep -F "$expected_last_resort_hash" THIRD_PARTY_NOTICES.md >/dev/null
grep -F "Copyright 2014-2021 The Fira Code Project Authors" assets/fonts/LICENSE >/dev/null
grep -F "Copyright (c) 2014 Ryan L McIntyre" assets/fonts/LICENSE >/dev/null
grep -F "https://github.com/ryanoasis/nerd-fonts/tree/v2.1.0" \
  assets/fonts/LICENSE >/dev/null
grep -F "Copyright © 2020 Unicode, Inc." assets/fonts/LICENSE >/dev/null
grep -F "SIL OPEN FONT LICENSE Version 1.1" assets/fonts/LICENSE >/dev/null
grep -F "Copyright (c) 2014 Ryan L McIntyre" THIRD_PARTY_NOTICES.md >/dev/null

grep -F "Copyright (c) 2024 Mitchell Hashimoto, Ghostty contributors" THIRD_PARTY_NOTICES.md >/dev/null
grep -F "a887df42c56f6de86c0fe6da9c4eeca37931e083" THIRD_PARTY_NOTICES.md >/dev/null
grep -F "a887df42c56f6de86c0fe6da9c4eeca37931e083" core/scripts/build-ghostty >/dev/null
# The page renderer's libraries are the unmodified files the notices name.
while read -r hash file; do
  test "$(shasum -a 256 "page-renderer/lib/$file" | awk '{print $1}')" = "$hash"
  grep -F "$hash" THIRD_PARTY_NOTICES.md >/dev/null
done <<'LIBS'
38c70a1e7ca91ab40e2d9e6e60129851a717ed1c7d4acbbdd41bf9503791cf68 markdown-it.min.js
a43bc1afd446f9c4cc66ac5dd45d02e8d65e26fc5344ec0ef787f88d6ddb6f9e mermaid.min.js
2812cb8825fdc57469eb2f7bb055e9429244e599920511ee477e828499b632cb chart.umd.js
LIBS
test "$(find page-renderer/lib -type f | wc -l | tr -d ' ')" = 3
printf 'license audit passed\n'
