#!/bin/sh
set -eu

if [ "$#" -ne 7 ]; then
  echo "usage: apply-update CURRENT STAGED DESTINATION BACKUP TRASH PID MODE" >&2
  exit 64
fi

current=$1
staged=$2
destination=$3
backup=$4
trash=$5
parent=$(/usr/bin/dirname "$current")
destination_parent=$(/usr/bin/dirname "$destination")
pid=$6
mode=$7

case "$current" in
  */Neovide\ Tabs.app | */Satin.app) ;;
  *)
    echo "refusing unexpected current application path: $current" >&2
    exit 64
    ;;
esac
if [ "$destination_parent" != "$parent" ] || [ "$destination" != "$parent/Satin.app" ]; then
  echo "refusing unexpected destination application path: $destination" >&2
  exit 64
fi
case "$staged" in
  "$parent"/.Satin.update.*.app) ;;
  *)
    echo "refusing unexpected staged application path: $staged" >&2
    exit 64
    ;;
esac
case "$current" in
  */Neovide\ Tabs.app)
    case "$backup" in
      "$parent"/.Neovide\ Tabs.previous.*.app) ;;
      *)
        echo "refusing unexpected backup application path: $backup" >&2
        exit 64
        ;;
    esac
    case "$trash" in
      */.Trash/Neovide\ Tabs.previous.*.app) ;;
      *)
        echo "refusing unexpected Trash path: $trash" >&2
        exit 64
        ;;
    esac
    ;;
  */Satin.app)
    case "$backup" in
      "$parent"/.Satin.previous.*.app) ;;
      *)
        echo "refusing unexpected backup application path: $backup" >&2
        exit 64
        ;;
    esac
    case "$trash" in
      */.Trash/Satin.previous.*.app) ;;
      *)
        echo "refusing unexpected Trash path: $trash" >&2
        exit 64
        ;;
    esac
    ;;
esac
case "$pid" in
  '' | *[!0-9]*)
    echo "invalid application pid: $pid" >&2
    exit 64
    ;;
esac
case "$mode" in
  launch | smoke) ;;
  *)
    echo "invalid update mode: $mode" >&2
    exit 64
    ;;
esac

test -d "$current"
test -d "$staged"
if [ "$destination" != "$current" ]; then
  test ! -e "$destination"
fi
test ! -e "$backup"
test ! -e "$trash"

attempt=0
while /bin/kill -0 "$pid" 2>/dev/null; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 300 ]; then
    echo "timed out waiting for application pid $pid" >&2
    exit 75
  fi
  /bin/sleep 0.1
done

/bin/mv "$current" "$backup"
if ! /bin/mv "$staged" "$destination"; then
  /bin/mv "$backup" "$current"
  exit 74
fi

if ! /usr/bin/codesign --verify --deep --strict "$destination"; then
  /bin/mv "$destination" "$staged"
  /bin/mv "$backup" "$current"
  exit 65
fi
if [ "$(
  /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
    "$destination/Contents/Info.plist" 2>/dev/null
)" != "dev.soyukke.satin" ]; then
  /bin/mv "$destination" "$staged"
  /bin/mv "$backup" "$current"
  exit 65
fi

if [ "$mode" = "launch" ] && ! /usr/bin/open -n "$destination"; then
  /bin/mv "$destination" "$staged"
  /bin/mv "$backup" "$current"
  /usr/bin/open -n "$current" || true
  exit 69
fi

# Keep the previous application recoverable instead of deleting it.
/bin/mv "$backup" "$trash" || true
