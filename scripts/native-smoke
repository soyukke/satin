#!/usr/bin/env bash
set -euo pipefail

app="${SATIN_NATIVE_EXECUTABLE:-spikes/macos-shell/.build/SatinApplication}"
shot="spikes/macos-shell/.build/native-smoke.png"
result_file="spikes/macos-shell/.build/native-smoke.result"
window_id_file="spikes/macos-shell/.build/native-window-id"

rm -f "$shot" "$result_file" "$window_id_file"

SATIN_NATIVE_SMOKE_SCENARIO=1 \
  SATIN_NATIVE_SMOKE_RESULT="$result_file" \
  SATIN_NATIVE_SMOKE_WINDOW_ID="$window_id_file" \
  "$app" &
app_pid=$!

# ShellCheck does not treat a trap handler name as a direct function call.
# shellcheck disable=SC2329
cleanup() {
  if kill -0 "$app_pid" 2>/dev/null; then
    kill "$app_pid" 2>/dev/null || true
    wait "$app_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT

for _ in {1..100}; do
  if [[ -s "$window_id_file" ]]; then
    break
  fi
  sleep 0.05
done

if [[ ! -s "$window_id_file" ]]; then
  echo "native smoke failed: window id was not written" >&2
  exit 1
fi

window_id=$(tr -d '[:space:]' <"$window_id_file")
if [[ -z "$window_id" ]]; then
  echo "native smoke failed: empty window id" >&2
  exit 1
fi

capture_error="spikes/macos-shell/.build/native-smoke-screencapture.err"
verify_error="spikes/macos-shell/.build/native-smoke-verify.err"
rm -f "$capture_error" "$verify_error"
for _ in {1..40}; do
  if [[ -s "$result_file" ]] &&
    ./scripts/native-window-capture "$window_id" "$shot" 2>"$capture_error" &&
    [[ -s "$shot" ]]; then
    if ./scripts/native-smoke-verify "$shot" terminal "$result_file" 2>"$verify_error"; then
      cat "$result_file"
      exit 0
    fi
  fi
  sleep 0.15
done

if [[ -s "$verify_error" ]]; then
  cat "$verify_error" >&2
else
  cat "$capture_error" >&2
fi
exit 1
