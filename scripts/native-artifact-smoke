#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/native-artifact-smoke "$@"
fi

app="${SATIN_NATIVE_EXECUTABLE:-spikes/macos-shell/.build/SatinApplication}"
cli="${SATIN_CONTROL_EXECUTABLE:-target/debug/satin}"
cli="$(cd "$(dirname "$cli")" && pwd)/$(basename "$cli")"
smoke_root="$(mktemp -d "${TMPDIR:-/tmp}/satin-artifact-smoke.XXXXXX")"
socket="$smoke_root/control.sock"
popover_result="$smoke_root/popover.result"
app_log="$smoke_root/app.log"

"$cli" --socket "$socket" artifact policy set \
  --max-columns 80 --max-rows 32 --language ja-JP --overflow compact >/dev/null

table_source="$smoke_root/test-results.json"
jq -n '[
  {"テスト":"auth_login", "結果":"成功", "時間":"0.8s", "対象":"auth.rs"},
  {"テスト":"token_refresh", "結果":"失敗", "時間":"2.4s", "対象":"token.rs"},
  {"テスト":"session_expiry", "結果":"成功", "時間":"1.1s", "対象":"session.rs"},
  {"テスト":"permission_check", "結果":"成功", "時間":"0.4s", "対象":"policy.rs"}
]' >"$table_source"
table_registration="$($cli --socket "$socket" --json artifact add \
  --kind table --title "テスト結果" --language ja-JP --file "$table_source")"
table_id="$(jq -r '.result.id' <<<"$table_registration")"
table_next="$smoke_root/test-results-next.json"
jq '. + [{"テスト":"artifact_list", "結果":"成功", "時間":"0.3s", "対象":"artifact.rs"}]' \
  "$table_source" >"$table_next"
mv "$table_next" "$table_source"
table_version="$($cli --socket "$socket" --json artifact add --id "$table_id" \
  --kind table --title "テスト結果" --language ja-JP --file "$table_source")"
table_unchanged="$($cli --socket "$socket" --json artifact add --id "$table_id" \
  --kind table --title "テスト結果" --language ja-JP --file "$table_source")"
jq -e '.result.version == 2' <<<"$table_version" >/dev/null
jq -e '.result.version == 2' <<<"$table_unchanged" >/dev/null
table_document="$(jq -r '.result.document' <<<"$table_version")"
table_directory="$(dirname "$(dirname "$(dirname "$table_document")")")"
test -f "$smoke_root/artifacts/INDEX.md"
test -f "$table_directory/README.md"
test -f "$table_directory/current.md"
test -f "$table_directory/versions/v001/artifact.md"
test -f "$table_directory/versions/v002/artifact.md"

rich_image="$smoke_root/rich-image.png"
rich_source="$smoke_root/rich-report.md"
cp "$PWD/assets/app-icon.png" "$rich_image"
cat >"$rich_source" <<'MARKDOWN'
# リッチレポート

結論: **重要情報**を先に置き、*補足*、~~旧情報~~、`cargo test`を区別します。

| Check | Result |
| --- | --- |
| Rust tests | pass |
| Native smoke | pass |

```rust
let status = "pass";
assert_eq!(status, "pass");
```

![Satin icon](rich-image.png)
MARKDOWN
rich_registration="$($cli --socket "$socket" --json artifact add \
  --kind markdown --title "リッチレポート" --language ja-JP --file "$rich_source")"
rich_id="$(jq -r '.result.id' <<<"$rich_registration")"
rich_document="$(jq -r '.result.document' <<<"$rich_registration")"
rich_asset="$(jq -r '.result.assets[0]' <<<"$rich_registration")"
rich_directory="$(dirname "$(dirname "$(dirname "$rich_document")")")"
test -f "$rich_asset"
test -f "$rich_directory/rich-image.png"
rm -f "$rich_source" "$rich_image"

SATIN_CONTROL_SOCKET="$socket" \
  SATIN_NATIVE_SMOKE_SCENARIO=artifact-popover \
  SATIN_NATIVE_SMOKE_ARTIFACT="$rich_id" \
  SATIN_NATIVE_SMOKE_RESULT="$popover_result" \
  "$app" >"$app_log" 2>&1 &
app_pid=$!

# ShellCheck does not treat a trap handler name as a direct function call.
# shellcheck disable=SC2329
cleanup() {
  cleanup_status=$?
  if [[ "$cleanup_status" -ne 0 && -s "$app_log" ]]; then
    cat "$app_log" >&2
  fi
  if kill -0 "$app_pid" 2>/dev/null; then
    kill "$app_pid" 2>/dev/null || true
    wait "$app_pid" 2>/dev/null || true
  fi
  rm -rf -- "$smoke_root"
  return "$cleanup_status"
}
trap cleanup EXIT INT TERM

for _ in {1..100}; do
  if [[ -S "$socket" ]] && kill -0 "$app_pid" 2>/dev/null; then
    break
  fi
  sleep 0.05
done
if [[ ! -S "$socket" ]]; then
  cat "$app_log" >&2
  echo "artifact smoke failed: application did not become ready" >&2
  exit 1
fi

for _ in {1..100}; do
  if [[ -s "$popover_result" ]]; then
    break
  fi
  sleep 0.05
done
if [[ "$(cat "$popover_result" 2>/dev/null || true)" != ok\ artifact-popover* ]]; then
  cat "$app_log" >&2
  echo "artifact smoke failed: recent artifact popover did not load" >&2
  exit 1
fi

state_before="$($cli --socket "$socket" --json list)"
rich_source_pane="$(jq -r '.result.tabs[] | select(.active) | .activePane' <<<"$state_before")"
pane_count_before="$(jq -r '.result.panes | length' <<<"$state_before")"
: >"$popover_result.open"

rich_pane=""
for _ in {1..100}; do
  state="$($cli --socket "$socket" --json list)"
  rich_pane="$(jq -r --arg artifact "$rich_id" \
    '.result.panes[] | select(.artifact == $artifact) | .id' <<<"$state")"
  if [[ -n "$rich_pane" ]]; then
    rich_screen="$($cli --socket "$socket" read-screen --pane "$rich_pane")"
  fi
  if [[ -n "$rich_pane" ]] && grep -Fq "リッチレポート" <<<"${rich_screen:-}"; then
    break
  fi
  sleep 0.05
done
if [[ -z "$rich_pane" ]] || ! grep -Fq "リッチレポート" <<<"${rich_screen:-}" ||
  ! jq -e --argjson source "$rich_source_pane" --argjson pane "$rich_pane" \
    --argjson count "$pane_count_before" '
    (.result.panes | length) == ($count + 1)
      and any(.result.panes[]; .id == $source and .artifact == null)
      and any(.result.panes[]; .id == $pane and .artifact != null)
  ' <<<"$state" >/dev/null; then
  cat "$app_log" >&2
  echo "artifact smoke failed: popover selection did not preserve its source pane" >&2
  exit 1
fi

for _ in {1..100}; do
  rich_screen="$($cli --socket "$socket" read-screen --pane "$rich_pane")"
  state="$($cli --socket "$socket" --json list)"
  if grep -Fq "リッチレポート" <<<"$rich_screen" &&
    grep -Fq "Check" <<<"$rich_screen" &&
    grep -Fq "rust" <<<"$rich_screen" &&
    grep -Fq "cargo test" <<<"$rich_screen" &&
    jq -e --argjson pane "$rich_pane" '
      any(.result.panes[]; .id == $pane and .kittyImages == 1)
    ' <<<"$state" >/dev/null; then
    break
  fi
  sleep 0.05
done
if ! grep -Fq "cargo test" <<<"${rich_screen:-}"; then
  printf '%s\n' "${rich_screen:-<empty screen>}" >&2
  cat "$app_log" >&2
  echo "artifact smoke failed: rich Markdown preview did not render" >&2
  exit 1
fi
jq -e --argjson pane "$rich_pane" '
  any(.result.panes[]; .id == $pane and .kittyImages == 1)
' <<<"$state" >/dev/null

"$cli" --socket "$socket" key --pane "$rich_pane" q >/dev/null
sleep 0.1
rich_screen="$($cli --socket "$socket" read-screen --pane "$rich_pane")"
if ! grep -Fq "リッチレポート" <<<"$rich_screen"; then
  echo "artifact smoke failed: GUI artifact changed after ignored q input" >&2
  exit 1
fi

table_show="$($cli --socket "$socket" --json artifact show \
  "$table_id@1" --pane "$rich_source_pane" --background)"
table_pane="$(jq -r '.result.pane' <<<"$table_show")"
if [[ "$table_pane" != "$rich_pane" ]] ||
  ! jq -e '.result.reused == true' <<<"$table_show" >/dev/null; then
  echo "artifact smoke failed: artifact show did not reuse the sidebar" >&2
  exit 1
fi
for _ in {1..100}; do
  table_screen="$($cli --socket "$socket" read-screen --pane "$table_pane")"
  if grep -Fq "テスト結果" <<<"$table_screen"; then
    break
  fi
  sleep 0.05
done
if ! grep -Fq "テスト結果" <<<"${table_screen:-}"; then
  printf '%s\n' "${table_screen:-<empty screen>}" >&2
  echo "artifact smoke failed: table preview did not render" >&2
  exit 1
fi
if grep -Fq "artifact_list" <<<"$table_screen"; then
  echo "artifact smoke failed: immutable artifact version was not selected" >&2
  exit 1
fi
table_refresh="$($cli --socket "$socket" --json artifact show \
  "$table_id" --pane "$rich_source_pane" --background)"
if [[ "$(jq -r '.result.pane' <<<"$table_refresh")" != "$table_pane" ]] ||
  ! jq -e '.result.reused == true' <<<"$table_refresh" >/dev/null; then
  echo "artifact smoke failed: artifact refresh replaced the sidebar pane" >&2
  exit 1
fi
for _ in {1..100}; do
  table_screen="$($cli --socket "$socket" read-screen --pane "$table_pane")"
  if grep -Fq "artifact_list" <<<"$table_screen"; then
    break
  fi
  sleep 0.05
done
if ! grep -Fq "artifact_list" <<<"${table_screen:-}"; then
  echo "artifact smoke failed: artifact refresh did not render the latest version" >&2
  exit 1
fi
"$cli" --socket "$socket" key --pane "$table_pane" q >/dev/null
sleep 0.1
table_screen="$($cli --socket "$socket" read-screen --pane "$table_pane")"
if ! grep -Fq "テスト結果" <<<"$table_screen"; then
  echo "artifact smoke failed: sidebar artifact changed after ignored q input" >&2
  exit 1
fi
"$cli" --socket "$socket" close-pane --pane "$table_pane" >/dev/null
for _ in {1..100}; do
  state="$($cli --socket "$socket" --json list)"
  if jq -e --argjson pane "$table_pane" \
    '.result.panes | all(.id != $pane)' <<<"$state" >/dev/null; then
    break
  fi
  sleep 0.05
done
jq -e --argjson pane "$table_pane" \
  '.result.panes | all(.id != $pane)' <<<"$state" >/dev/null

image_source="$PWD/assets/app-icon.png"
image_registration="$($cli --socket "$socket" --json artifact add \
  --kind image --title "Satin image preview" --language en-US --file "$image_source")"
image_id="$(jq -r '.result.id' <<<"$image_registration")"
image_show="$($cli --socket "$socket" --json artifact show \
  "$image_id" --pane "$rich_source_pane" --background)"
image_pane="$(jq -r '.result.pane' <<<"$image_show")"

for _ in {1..100}; do
  state="$($cli --socket "$socket" --json list)"
  if jq -e --argjson pane "$image_pane" '
    any(.result.panes[]; .id == $pane and .kittyImages == 1)
  ' <<<"$state" >/dev/null; then
    break
  fi
  sleep 0.05
done
jq -e --argjson pane "$image_pane" '
  any(.result.panes[]; .id == $pane and .kittyImages == 1)
' <<<"$state" >/dev/null
image_screen="$($cli --socket "$socket" read-screen --pane "$image_pane")"
if ! grep -Fq "Satin image preview" <<<"$image_screen" ||
  grep -Fq "q close" <<<"$image_screen"; then
  printf '%s\n' "$image_screen" >&2
  echo "artifact smoke failed: image preview chrome is incorrect" >&2
  exit 1
fi

echo "native artifact smoke passed"
