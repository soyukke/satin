#!/usr/bin/env bash
set -euo pipefail

app="spikes/macos-shell/.build/SatinApplication"
result_file="spikes/macos-shell/.build/native-tmux-zoom-resize.result"
log_file="/tmp/satin-native-tmux-zoom-resize.log"

rm -f -- "$result_file" "$log_file"
SATIN_NATIVE_SMOKE_SCENARIO=tmux-native \
  SATIN_NATIVE_SMOKE_TMUX_SCOPE=zoom-resize \
  SATIN_NATIVE_PERF_FONT_SIZE=15 \
  SATIN_NATIVE_SMOKE_RESULT="$result_file" \
  "$app" >"$log_file" 2>&1

if [[ ! -s "$result_file" ]]; then
  echo "tmux zoom/resize smoke failed before result was written" >&2
  sed -n '1,160p' "$log_file" >&2 || true
  exit 1
fi

result="$(cat "$result_file")"
printf '%s\n' "$result"
[[ "$result" == ok\ tmux-zoom-resize* ]]
