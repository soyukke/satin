cat >"$work_root/review.zsh" <<'ZSH'
printf '\033[2J\033[H'
printf '\033[1;38;2;206;180;255m  SATIN\033[0m  '
printf '\033[38;2;126;231;214mnative AI workspace\033[0m\n'
printf '\033[38;2;112;199;255m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n\n'
printf '  \033[1;36m●\033[0m  reviewing retained renderer changes\n'
printf '  \033[2mstatus is routed from the tmux pane title\033[0m\n\n'
printf '  \033[48;2;255;95;135m  \033[0m '
