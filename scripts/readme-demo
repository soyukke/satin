ls -lh \
  assets/satin-demo.mp4 \
  assets/satin-demo.gif \
  assets/satin-demo-poster.png \
  assets/satin-work-switcher-demo.mp4 \
  assets/satin-work-switcher-demo.gif \
  assets/satin-work-switcher-demo-poster.png \
  assets/satin-artifact-demo.mp4 \
  assets/satin-artifact-demo.gif \
  assets/satin-artifact-demo-poster.png
