#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${SATIN_SOCKET:-}" ]]; then
  echo "readme-demo must run from a terminal outside Satin" >&2
  exit 64
fi
if [[ "${SATIN_ALLOW_SCREEN_CAPTURE:-0}" != 1 ]]; then
  echo "set SATIN_ALLOW_SCREEN_CAPTURE=1 to record the isolated demo window" >&2
  exit 64
fi
if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/readme-demo "$@"
fi

for executable in ffmpeg ffprobe jq tmux; do
  if ! command -v "$executable" >/dev/null; then
    echo "readme-demo requires $executable from the Nix shell" >&2
    exit 69
  fi
done

if [[ "${SATIN_README_DEMO_SKIP_BUILD:-0}" != 1 ]]; then
  just native-dev-app
fi

app="$(pwd)/spikes/macos-shell/.build/dev/Satin Dev.app/Contents/MacOS/satin-dev-app"
cli="$(pwd)/spikes/macos-shell/.build/dev/Satin Dev.app/Contents/MacOS/satin"
if [[ ! -x "$app" || ! -x "$cli" ]]; then
  echo "readme-demo requires a built Satin Dev app" >&2
  exit 66
fi

demo_root="$(mktemp -d "${TMPDIR:-/tmp}/satin-readme-demo.XXXXXX")"
app_pid=""
capture_pid=""
tmux_socket=""

cleanup_processes() {
  if [[ -n "$capture_pid" ]] && kill -0 "$capture_pid" 2>/dev/null; then
    kill "$capture_pid" 2>/dev/null || true
    wait "$capture_pid" 2>/dev/null || true
  fi
  capture_pid=""
  if [[ -n "$app_pid" ]] && kill -0 "$app_pid" 2>/dev/null; then
    kill "$app_pid" 2>/dev/null || true
    wait "$app_pid" 2>/dev/null || true
  fi
  app_pid=""
  if [[ -n "$tmux_socket" ]]; then
    tmux -S "$tmux_socket" kill-server 2>/dev/null || true
  fi
  tmux_socket=""
}

cleanup() {
  local cleanup_status=$?
  cleanup_processes
  case "$demo_root" in
    "${TMPDIR:-/tmp}"/satin-readme-demo.*) rm -rf -- "$demo_root" ;;
    *) echo "refusing unexpected demo cleanup path: $demo_root" >&2 ;;
  esac
  return "$cleanup_status"
}
trap cleanup EXIT INT TERM

wait_for_file() {
  local file=$1
  local description=$2
  for _ in {1..200}; do
    if [[ -s "$file" ]]; then
      return 0
    fi
    if [[ -n "$app_pid" ]] && ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  echo "readme-demo timed out waiting for $description" >&2
  return 1
}

wait_for_socket() {
  local socket=$1
  for _ in {1..200}; do
    if [[ -S "$socket" ]]; then
      return 0
    fi
    if [[ -n "$app_pid" ]] && ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  echo "readme-demo timed out waiting for the control socket" >&2
  return 1
}

launch_demo_app() {
  local root=$1
  local socket="$root/control.sock"
  local result="$root/ready.result"
  local window_id="$root/window-id"
  local log="$root/app.log"
  (
    cd /tmp
    exec env \
      SATIN_CONTROL_SOCKET="$socket" \
      SATIN_NATIVE_SMOKE_SCENARIO=readme-demo \
      SATIN_NATIVE_SMOKE_RESULT="$result" \
      SATIN_NATIVE_SMOKE_WINDOW_ID="$window_id" \
      "$app"
  ) >"$log" 2>&1 &
  app_pid=$!
  wait_for_socket "$socket"
  wait_for_file "$result" "the README demo scenario"
  wait_for_file "$window_id" "the Satin Dev window ID"
  if [[ "$(<"$result")" != ok\ readme-demo* ]]; then
    cat "$log" >&2
    echo "readme-demo scenario did not become ready" >&2
    return 1
  fi
}

wait_for_tmux_projection() {
  local socket=$1
  local state
  for _ in {1..200}; do
    state="$("$cli" --socket "$socket" --json list 2>/dev/null || true)"
    if jq -e '
      .ok == true
        and (.result.panes | length) == 2
        and any(.result.panes[]; .status.status == "running")
        and any(.result.panes[]; .status.status == "waiting")
    ' <<<"$state" >/dev/null 2>&1; then
      printf '%s' "$state"
      return 0
    fi
    sleep 0.05
  done
  echo "readme-demo tmux projection or agent status did not settle" >&2
  return 1
}

record_window() {
  local window_id=$1
  local duration=$2
  local output=$3
  local frames="${output%.mov}-frames"
  local frame_count=$((duration * 5))
  local frame
  local index

  mkdir -p "$frames"
  (
    for ((index = 0; index < frame_count; index++)); do
      printf -v frame '%s/%04d.jpg' "$frames" "$index"
      /usr/sbin/screencapture -x -t jpg -l "$window_id" "$frame"
      if [[ ! -s "$frame" ]]; then
        echo "README demo capture produced no frame: $index" >&2
        exit 1
      fi
      sleep 0.17
    done
    ffmpeg -y -v error -framerate 5 -start_number 0 -i "$frames/%04d.jpg" \
      -an -vf setparams=range=limited -c:v libx264 -preset ultrafast -crf 12 \
      -pix_fmt yuv420p -color_range tv "$output"
  ) &
  capture_pid=$!
}

finish_recording() {
  local output=$1
  if ! wait "$capture_pid"; then
    capture_pid=""
    echo "README demo capture failed; allow Screen & System Audio Recording for Terminal" >&2
    return 1
  fi
  capture_pid=""
  if [[ ! -s "$output" ]]; then
    echo "README demo capture produced no video" >&2
    return 1
  fi
}

main_root="$demo_root/main"
mkdir -p "$main_root"
chmod 700 "$main_root"
tmux_socket="$main_root/tmux.sock"
tmux_session="satin-readme"

cat >"$main_root/review.zsh" <<'ZSH'
printf '\033[2J\033[H'
printf '\033[1;38;2;206;180;255m  SATIN\033[0m  '
printf '\033[38;2;126;231;214mnative AI workspace\033[0m\n'
printf '\033[38;2;112;199;255m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n\n'
printf '  \033[1;36m●\033[0m  reviewing retained renderer changes\n'
printf '  \033[2mstatus is routed from the tmux pane title\033[0m\n\n'
printf '  \033[48;2;255;95;135m  \033[0m '
printf '\033[48;2;255;189;89m  \033[0m '
printf '\033[48;2;110;220;170m  \033[0m '
printf '\033[48;2;86;180;255m  \033[0m '
printf '\033[48;2;190;140;255m  \033[0m\n\n'
printf '  \033[38;2;126;231;214msatin-demo\033[0m ❯ '
IFS= read -r _
ZSH

cat >"$main_root/checks.zsh" <<'ZSH'
printf '\033[2J\033[H'
printf '\033[1;38;2;206;180;255m  Release checks\033[0m\n'
printf '\033[38;2;112;199;255m━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n\n'
printf '  \033[1;32m✓\033[0m  Rust tests          182 passed\n'
printf '  \033[1;32m✓\033[0m  native smoke       Skia/Metal\n'
printf '  \033[1;33m●\033[0m  approval           requested\n\n'
printf '  \033[2mprojected tmux pane · pane-local zoom\033[0m\n\n'
printf '  \033[38;2;126;231;214msatin-demo\033[0m ❯ '
IFS= read -r _
ZSH

tmux -f /dev/null -S "$tmux_socket" new-session -d \
  -s "$tmux_session" -n "AI workspace" -c /tmp -x 120 -y 36
tmux -S "$tmux_socket" split-window -h -t "$tmux_session:0" -c /tmp
printf -v review_command 'source %q' "$main_root/review.zsh"
printf -v checks_command 'source %q' "$main_root/checks.zsh"
tmux -S "$tmux_socket" send-keys -l -t "$tmux_session:0.0" "$review_command"
tmux -S "$tmux_socket" send-keys -t "$tmux_session:0.0" Enter
tmux -S "$tmux_socket" send-keys -l -t "$tmux_session:0.1" "$checks_command"
tmux -S "$tmux_socket" send-keys -t "$tmux_session:0.1" Enter
tmux -S "$tmux_socket" select-pane -t "$tmux_session:0.0" -T "⠹ Codex renderer review"
tmux -S "$tmux_socket" select-pane -t "$tmux_session:0.1" \
  -T "[ ! ] Action Required | Claude Code"

launch_demo_app "$main_root"
main_socket="$main_root/control.sock"
initial_pane="$("$cli" --socket "$main_socket" --json list | jq -r '.result.panes[0].id')"
printf -v attach_command '%q -S %q -CC attach-session -t %q' \
  "$(command -v tmux)" "$tmux_socket" "$tmux_session"
"$cli" --socket "$main_socket" send --pane "$initial_pane" "$attach_command" >/dev/null
"$cli" --socket "$main_socket" key --pane "$initial_pane" Enter >/dev/null
main_state="$(wait_for_tmux_projection "$main_socket")"
main_panes="$(jq -r '.result.panes[].id' <<<"$main_state" | sort -n)"
mapfile -t main_pane_ids <<<"$main_panes"
if [[ "${#main_pane_ids[@]}" -ne 2 ]]; then
  echo "readme-demo expected two projected tmux panes" >&2
  exit 1
fi

sleep 0.8
main_window_id="$(tr -d '[:space:]' <"$main_root/window-id")"
raw_main="$demo_root/satin-demo.mov"
record_window "$main_window_id" 18 "$raw_main"
sleep 4
: >"$main_root/ready.result.work"
wait_for_file "$main_root/ready.result.work-open" "the README Work Switcher"
if [[ "$(<"$main_root/ready.result.work-open")" != ok\ readme-demo* ]]; then
  echo "readme-demo Work Switcher did not open" >&2
  exit 1
fi
sleep 6
tmux -S "$tmux_socket" select-pane -t "$tmux_session:0.0" -T "Codex review complete"
finish_recording "$raw_main"
cleanup_processes

artifact_root="$demo_root/artifact"
mkdir -p "$artifact_root"
chmod 700 "$artifact_root"
artifact_socket="$artifact_root/control.sock"
artifact_source="$artifact_root/release-readiness.md"
cp assets/app-icon.png "$artifact_root/satin-icon.png"
cat >"$artifact_source" <<'MARKDOWN'
# Satin release readiness

The current workspace keeps terminal, tmux, Neovim, and AI-produced reports
together without embedding a browser.

| Check | Result | Detail |
| --- | --- | --- |
| Renderer | Pass | Skia + Metal retained UI |
| Neovim | Pass | scroll and split redraw |
| Terminal | Pass | libghostty-vt |

```rust
let workspace = Satin::native()
    .with_tmux()
    .with_neovim();
assert!(workspace.is_ready());
```

![Current Satin icon](satin-icon.png)
MARKDOWN

"$cli" --socket "$artifact_socket" artifact policy set \
  --max-columns 80 --max-rows 32 --language en-US --overflow compact >/dev/null
artifact_registration="$("$cli" --socket "$artifact_socket" --json artifact add \
  --kind markdown --title "Satin release readiness" --language en-US \
  --file "$artifact_source")"
artifact_id="$(jq -r '.result.id' <<<"$artifact_registration")"

launch_demo_app "$artifact_root"
artifact_pane="$("$cli" --socket "$artifact_socket" --json list | jq -r '.result.panes[0].id')"
printf -v artifact_intro 'source %q' "$main_root/review.zsh"
"$cli" --socket "$artifact_socket" send --pane "$artifact_pane" "$artifact_intro" >/dev/null
"$cli" --socket "$artifact_socket" key --pane "$artifact_pane" Enter >/dev/null
sleep 0.8
artifact_window_id="$(tr -d '[:space:]' <"$artifact_root/window-id")"
raw_artifact="$demo_root/satin-artifact-demo.mov"
record_window "$artifact_window_id" 16 "$raw_artifact"
sleep 3
"$cli" --socket "$artifact_socket" artifact show --pane "$artifact_pane" "$artifact_id" \
  >/dev/null
sleep 6
printf '\nUpdated after the final native smoke passed.\n' >>"$artifact_source"
"$cli" --socket "$artifact_socket" artifact add --id "$artifact_id" \
  --kind markdown --title "Satin release readiness" --language en-US \
  --file "$artifact_source" >/dev/null
"$cli" --socket "$artifact_socket" artifact show --pane "$artifact_pane" "$artifact_id" \
  >/dev/null
finish_recording "$raw_artifact"
cleanup_processes

render_demo() {
  local input=$1
  local name=$2
  local poster_second=$3
  local mp4="$demo_root/$name.mp4"
  local gif="$demo_root/$name.gif"
  local poster="$demo_root/$name-poster.png"
  local video_filter
  local gif_filter
  local dimensions
  video_filter="fps=30,scale=1100:720:force_original_aspect_ratio=decrease"
  video_filter+=",pad=1100:720:(ow-iw)/2:(oh-ih)/2:color=black"
  video_filter+=",setparams=range=limited"
  gif_filter="[0:v]fps=5,scale=880:576:force_original_aspect_ratio=decrease,"
  gif_filter+="pad=880:576:(ow-iw)/2:(oh-ih)/2:color=black,split[a][b];"
  gif_filter+="[a]palettegen=max_colors=64:stats_mode=diff[p];"
  gif_filter+="[b][p]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle"
  ffmpeg -y -v error -i "$input" -an -vf "$video_filter" \
    -c:v libx264 -preset slow -crf 24 -pix_fmt yuv420p -color_range tv \
    -movflags +faststart "$mp4"
  ffmpeg -y -v error -i "$mp4" -filter_complex "$gif_filter" "$gif"
  ffmpeg -y -v error -ss "$poster_second" -i "$mp4" -frames:v 1 "$poster"
  ffmpeg -v error -i "$mp4" -f null -
  ffmpeg -v error -i "$gif" -f null -
  dimensions="$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=width,height -of json "$mp4" |
    jq -r '.streams[0] | "\(.width)x\(.height)"')"
  if [[ "$dimensions" != "1100x720" ]]; then
    echo "unexpected README MP4 dimensions: $dimensions" >&2
    return 1
  fi
}

render_demo "$raw_main" satin-demo 8
render_demo "$raw_artifact" satin-artifact-demo 8

chmod 644 \
  "$demo_root/satin-demo.mp4" \
  "$demo_root/satin-demo.gif" \
  "$demo_root/satin-demo-poster.png" \
  "$demo_root/satin-artifact-demo.mp4" \
  "$demo_root/satin-artifact-demo.gif" \
  "$demo_root/satin-artifact-demo-poster.png"
mv -f "$demo_root/satin-demo.mp4" assets/satin-demo.mp4
mv -f "$demo_root/satin-demo.gif" assets/satin-demo.gif
mv -f "$demo_root/satin-demo-poster.png" assets/satin-demo-poster.png
mv -f "$demo_root/satin-artifact-demo.mp4" assets/satin-artifact-demo.mp4
mv -f "$demo_root/satin-artifact-demo.gif" assets/satin-artifact-demo.gif
mv -f "$demo_root/satin-artifact-demo-poster.png" assets/satin-artifact-demo-poster.png

ls -lh \
  assets/satin-demo.mp4 \
  assets/satin-demo.gif \
  assets/satin-demo-poster.png \
  assets/satin-artifact-demo.mp4 \
  assets/satin-artifact-demo.gif \
  assets/satin-artifact-demo-poster.png
