#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${SATIN_SOCKET:-}" ]]; then
  echo "readme-demo must run from a terminal outside Satin" >&2
  exit 64
fi
if [[ "${SATIN_ALLOW_SCREEN_CAPTURE:-0}" != 1 ]]; then
  echo "set SATIN_ALLOW_SCREEN_CAPTURE=1 to record the isolated demo window" >&2
  exit 64
fi
if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/readme-demo "$@"
fi

for executable in ffmpeg ffprobe git jq tmux; do
  if ! command -v "$executable" >/dev/null; then
    echo "readme-demo requires $executable from the Nix shell" >&2
    exit 69
  fi
done

if [[ "${SATIN_README_DEMO_SKIP_BUILD:-0}" != 1 ]]; then
  just native-dev-app
fi

app="$(pwd)/spikes/macos-shell/.build/dev/Satin Dev.app/Contents/MacOS/satin-dev-app"
cli="$(pwd)/spikes/macos-shell/.build/dev/Satin Dev.app/Contents/MacOS/satin"
if [[ ! -x "$app" || ! -x "$cli" ]]; then
  echo "readme-demo requires a built Satin Dev app" >&2
  exit 66
fi

demo_root="$(mktemp -d "${TMPDIR:-/tmp}/satin-readme-demo.XXXXXX")"
app_pid=""
capture_pid=""
tmux_socket=""

cleanup_processes() {
  if [[ -n "$capture_pid" ]] && kill -0 "$capture_pid" 2>/dev/null; then
    kill "$capture_pid" 2>/dev/null || true
    wait "$capture_pid" 2>/dev/null || true
  fi
  capture_pid=""
  if [[ -n "$app_pid" ]] && kill -0 "$app_pid" 2>/dev/null; then
    kill "$app_pid" 2>/dev/null || true
    wait "$app_pid" 2>/dev/null || true
  fi
  app_pid=""
  if [[ -n "$tmux_socket" ]]; then
    tmux -S "$tmux_socket" kill-server 2>/dev/null || true
  fi
  tmux_socket=""
}

cleanup() {
  local cleanup_status=$?
  cleanup_processes
  case "$demo_root" in
    "${TMPDIR:-/tmp}"/satin-readme-demo.*) rm -rf -- "$demo_root" ;;
    *) echo "refusing unexpected demo cleanup path: $demo_root" >&2 ;;
  esac
  return "$cleanup_status"
}
trap cleanup EXIT INT TERM

wait_for_file() {
  local file=$1
  local description=$2
  for _ in {1..200}; do
    if [[ -s "$file" ]]; then
      return 0
    fi
    if [[ -n "$app_pid" ]] && ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  echo "readme-demo timed out waiting for $description" >&2
  return 1
}

wait_for_socket() {
  local socket=$1
  for _ in {1..200}; do
    if [[ -S "$socket" ]]; then
      return 0
    fi
    if [[ -n "$app_pid" ]] && ! kill -0 "$app_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  echo "readme-demo timed out waiting for the control socket" >&2
  return 1
}

launch_demo_app() {
  local root=$1
  local scene=$2
  local socket="$root/control.sock"
  local result="$root/ready.result"
  local window_id="$root/window-id"
  local log="$root/app.log"
  (
    cd /tmp
    exec env \
      SATIN_CONTROL_SOCKET="$socket" \
      SATIN_NATIVE_SMOKE_SCENARIO=readme-demo \
      SATIN_README_DEMO_SCENE="$scene" \
      SATIN_NATIVE_SMOKE_RESULT="$result" \
      SATIN_NATIVE_SMOKE_WINDOW_ID="$window_id" \
      "$app"
  ) >"$log" 2>&1 &
  app_pid=$!
  wait_for_socket "$socket"
  wait_for_file "$result" "the README demo scenario"
  wait_for_file "$window_id" "the Satin Dev window ID"
  if [[ "$(<"$result")" != ok\ readme-demo* ]]; then
    cat "$log" >&2
    echo "readme-demo scenario did not become ready" >&2
    return 1
  fi
}

wait_for_pane_kind() {
  local socket=$1
  local pane=$2
  local kind=$3
  local state
  for _ in {1..200}; do
    state="$("$cli" --socket "$socket" --json list 2>/dev/null || true)"
    if jq -e --argjson pane "$pane" --arg kind "$kind" '
      .ok == true
        and any(.result.panes[]; .id == $pane and .kind == $kind)
    ' <<<"$state" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.05
  done
  echo "readme-demo timed out waiting for pane $pane to become $kind" >&2
  return 1
}

type_into_pane() {
  local socket=$1
  local pane=$2
  local value=$3
  local delay=$4
  local character
  local index
  for ((index = 0; index < ${#value}; index++)); do
    character="${value:index:1}"
    printf '%s' "$character" |
      "$cli" --socket "$socket" send --pane "$pane" - >/dev/null
    sleep "$delay"
  done
}

wait_for_tmux_projection() {
  local socket=$1
  local state
  for _ in {1..200}; do
    state="$("$cli" --socket "$socket" --json list 2>/dev/null || true)"
    if jq -e '
      .ok == true
        and (.result.panes | length) == 2
        and any(.result.panes[]; .status.status == "running")
        and any(.result.panes[]; .status.status == "waiting")
    ' <<<"$state" >/dev/null 2>&1; then
      printf '%s' "$state"
      return 0
    fi
    sleep 0.05
  done
  echo "readme-demo tmux projection or agent status did not settle" >&2
  return 1
}

record_window() {
  local window_id=$1
  local duration=$2
  local output=$3
  local trailing_margin=${4:-0}

  /usr/bin/caffeinate -u -t 1
  ./scripts/native-window-record \
    "$window_id" "$duration" "$trailing_margin" "$output" &
  capture_pid=$!
}

finish_recording() {
  local output=$1
  if ! wait "$capture_pid"; then
    capture_pid=""
    echo "README demo capture failed; allow Screen & System Audio Recording for Terminal" >&2
    return 1
  fi
  capture_pid=""
  if [[ ! -s "$output" ]]; then
    echo "README demo capture produced no video" >&2
    return 1
  fi
}

main_root="$demo_root/main"
mkdir -p "$main_root"
chmod 700 "$main_root"
main_workspace="$main_root/workspace"
mkdir -p "$main_workspace"

cat >"$main_root/prompt.zsh" <<'ZSH'
precmd_functions=()
chpwd_functions=()
PROMPT=$'  \033[38;2;126;231;214msatin\033[0m \033[2m~/demo\033[0m ❯ '
RPROMPT=''
printf '\033[2J\033[H'
printf '\033[1;38;2;206;180;255m  SATIN\033[0m  '
printf '\033[38;2;126;231;214mnative terminal + Neovim workspace\033[0m\n'
printf '\033[38;2;112;199;255m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n\n'
printf '  \033[1;32m✓\033[0m  libghostty-vt terminal\n'
printf '  \033[1;32m✓\033[0m  retained Skia / Metal renderer\n'
printf '  \033[1;32m✓\033[0m  animated native Neovim cursor + scroll\n\n'
printf '  \033[48;2;255;95;135m  \033[0m '
printf '\033[48;2;255;189;89m  \033[0m '
printf '\033[48;2;110;220;170m  \033[0m '
printf '\033[48;2;86;180;255m  \033[0m '
printf '\033[48;2;190;140;255m  \033[0m\n\n'
ZSH

cat >"$main_workspace/demo.lua" <<'LUA'
vim.opt.termguicolors = true
vim.opt.number = true
vim.opt.relativenumber = false
vim.opt.signcolumn = "no"
vim.opt.foldcolumn = "0"
vim.opt.laststatus = 2
vim.opt.showtabline = 0
vim.opt.scrolloff = 4
vim.opt.sidescrolloff = 4
vim.opt.cursorline = true
vim.opt.wrap = false
vim.opt.smoothscroll = false
vim.opt.statusline = "  Satin native Neovim  %=  retained cursor + scroll  %l:%c "
vim.cmd("syntax enable")
vim.cmd("colorscheme habamax")
LUA

cat >"$main_workspace/renderer.rs" <<'RUST'
#[derive(Clone, Debug)]
pub struct DrawCommand {
    pub row: usize,
    pub text: &'static str,
}

pub fn retained_frame() -> Vec<DrawCommand> {
    vec![
RUST
for row in {1..140}; do
  printf '        DrawCommand { row: %3d, text: "retained pane row %03d" },\n' \
    "$row" "$row" >>"$main_workspace/renderer.rs"
done
cat >>"$main_workspace/renderer.rs" <<'RUST'
    ]
}
RUST

git -C "$main_workspace" init -q -b main
git -C "$main_workspace" config user.name "Satin Demo"
git -C "$main_workspace" config user.email "demo@satin.invalid"
git -C "$main_workspace" config commit.gpgsign false
git -C "$main_workspace" add renderer.rs demo.lua
GIT_AUTHOR_DATE=2026-08-01T10:00:00Z GIT_COMMITTER_DATE=2026-08-01T10:00:00Z \
  git -C "$main_workspace" commit -qm "Add retained draw commands"
printf '%s\n' 'cursor_animation = true' >"$main_workspace/renderer.toml"
git -C "$main_workspace" add renderer.toml
GIT_AUTHOR_DATE=2026-08-02T10:00:00Z GIT_COMMITTER_DATE=2026-08-02T10:00:00Z \
  git -C "$main_workspace" commit -qm "Animate pane-local cursor state"
printf '%s\n' 'ctrl-d' 'ctrl-u' >"$main_workspace/scroll-cases.txt"
git -C "$main_workspace" add scroll-cases.txt
GIT_AUTHOR_DATE=2026-08-03T10:00:00Z GIT_COMMITTER_DATE=2026-08-03T10:00:00Z \
  git -C "$main_workspace" commit -qm "Keep smooth scroll on UI events"
printf '%s\n' 'terminal cursor' 'native Neovim cursor' >"$main_workspace/smoke-cases.txt"
git -C "$main_workspace" add smoke-cases.txt
GIT_AUTHOR_DATE=2026-08-04T10:00:00Z GIT_COMMITTER_DATE=2026-08-04T10:00:00Z \
  git -C "$main_workspace" commit -qm "Verify terminal and Neovim motion"

launch_demo_app "$main_root" main
main_socket="$main_root/control.sock"
main_pane="$("$cli" --socket "$main_socket" --json list | jq -r '.result.panes[0].id')"
printf -v main_intro 'cd %q && source %q' "$main_workspace" "$main_root/prompt.zsh"
"$cli" --socket "$main_socket" send --pane "$main_pane" "$main_intro" >/dev/null
"$cli" --socket "$main_socket" key --pane "$main_pane" Enter >/dev/null
sleep 0.8

main_window_id="$(tr -d '[:space:]' <"$main_root/window-id")"
raw_main="$demo_root/satin-demo.mov"
record_window "$main_window_id" 19 "$raw_main"
sleep 0.8
type_into_pane \
  "$main_socket" "$main_pane" \
  "git log --graph --decorate --oneline --color=always -4" 0.025
"$cli" --socket "$main_socket" key --pane "$main_pane" Enter >/dev/null
sleep 1.2

main_split="$("$cli" --socket "$main_socket" --json split \
  --pane "$main_pane" --vertical --cwd "$main_workspace")"
nvim_pane="$(jq -r '.result.pane' <<<"$main_split")"
printf -v nvim_intro 'source %q' "$main_root/prompt.zsh"
"$cli" --socket "$main_socket" send --pane "$nvim_pane" "$nvim_intro" >/dev/null
"$cli" --socket "$main_socket" key --pane "$nvim_pane" Enter >/dev/null
sleep 0.8
type_into_pane "$main_socket" "$nvim_pane" "nvim -u demo.lua renderer.rs" 0.04
"$cli" --socket "$main_socket" key --pane "$nvim_pane" Enter >/dev/null
wait_for_pane_kind "$main_socket" "$nvim_pane" neovim
sleep 0.7
for key in l l l j j j l l; do
  "$cli" --socket "$main_socket" send --pane "$nvim_pane" "$key" >/dev/null
  sleep 0.24
done
"$cli" --socket "$main_socket" key --pane "$nvim_pane" Ctrl+D >/dev/null
sleep 1.4
for key in j j l l; do
  "$cli" --socket "$main_socket" send --pane "$nvim_pane" "$key" >/dev/null
  sleep 0.24
done
"$cli" --socket "$main_socket" key --pane "$nvim_pane" Ctrl+D >/dev/null
sleep 1.4
"$cli" --socket "$main_socket" key --pane "$nvim_pane" Ctrl+U >/dev/null
sleep 1.5
finish_recording "$raw_main"
cleanup_processes

work_root="$demo_root/work-switcher"
mkdir -p "$work_root"
chmod 700 "$work_root"
tmux_socket="$work_root/tmux.sock"
