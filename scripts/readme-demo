  "$(command -v tmux)" "$tmux_socket" "$tmux_session"
"$cli" --socket "$work_socket" send --pane "$initial_pane" "$attach_command" >/dev/null
"$cli" --socket "$work_socket" key --pane "$initial_pane" Enter >/dev/null
