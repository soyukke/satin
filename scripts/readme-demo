sleep 3
"$cli" --socket "$artifact_socket" artifact show --pane "$artifact_pane" "$artifact_id" \
  >/dev/null
sleep 6
printf '\nUpdated after the final native smoke passed.\n' >>"$artifact_source"
"$cli" --socket "$artifact_socket" artifact add --id "$artifact_id" \
  --kind markdown --title "Satin release readiness" --language en-US \
  --file "$artifact_source" >/dev/null
"$cli" --socket "$artifact_socket" artifact show --pane "$artifact_pane" "$artifact_id" \
  >/dev/null
finish_recording "$raw_artifact"
cleanup_processes

render_demo() {
  local input=$1
  local name=$2
  local poster_second=$3
  local mp4="$demo_root/$name.mp4"
  local gif="$demo_root/$name.gif"
  local poster="$demo_root/$name-poster.png"
  local video_filter
  local gif_filter
  local dimensions
  video_filter="fps=30,scale=1100:720:force_original_aspect_ratio=decrease"
  video_filter+=",pad=1100:720:(ow-iw)/2:(oh-ih)/2:color=black"
  video_filter+=",setparams=range=limited"
  gif_filter="[0:v]fps=15,scale=880:576:force_original_aspect_ratio=decrease,"
  gif_filter+="pad=880:576:(ow-iw)/2:(oh-ih)/2:color=black,split[a][b];"
  gif_filter+="[a]palettegen=max_colors=64:stats_mode=diff[p];"
  gif_filter+="[b][p]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle"
  ffmpeg -y -v error -i "$input" -an -vf "$video_filter" \
    -c:v libx264 -preset slow -crf 24 -pix_fmt yuv420p -color_range tv \
    -movflags +faststart "$mp4"
  ffmpeg -y -v error -i "$mp4" -filter_complex "$gif_filter" "$gif"
  ffmpeg -y -v error -ss "$poster_second" -i "$mp4" -frames:v 1 "$poster"
  ffmpeg -v error -i "$mp4" -f null -
  ffmpeg -v error -i "$gif" -f null -
  dimensions="$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=width,height -of json "$mp4" |
    jq -r '.streams[0] | "\(.width)x\(.height)"')"
  if [[ "$dimensions" != "1100x720" ]]; then
    echo "unexpected README MP4 dimensions: $dimensions" >&2
    return 1
  fi
}

render_demo "$raw_main" satin-demo 12
render_demo "$raw_work" satin-work-switcher-demo 8
render_demo "$raw_artifact" satin-artifact-demo 8

chmod 644 \
  "$demo_root/satin-demo.mp4" \
