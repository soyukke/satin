#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/native-package-smoke "$@"
fi

./scripts/native-package
app_path="spikes/macos-shell/.build/package/Satin.app"
executable="$app_path/Contents/MacOS/satin"
control_executable="$app_path/Contents/MacOS/satinctl"
nvim_launcher="$app_path/Contents/MacOS/satin-nvim"
package_version="$(
  sed -nE 's/^version = "([^"]+)"$/\1/p' Cargo.toml |
    head -n 1
)"
test -n "$package_version"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' \
    "$app_path/Contents/Info.plist"
)" = "Satin"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' \
    "$app_path/Contents/Info.plist"
)" = "satin"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
    "$app_path/Contents/Info.plist"
)" = "dev.soyukke.satin"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' \
    "$app_path/Contents/Info.plist"
)" = "$package_version"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :CFBundleDocumentTypes:0:CFBundleTypeRole' \
    "$app_path/Contents/Info.plist"
)" = "Editor"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :CFBundleDocumentTypes:0:LSItemContentTypes:0' \
    "$app_path/Contents/Info.plist"
)" = "public.text"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :CFBundleDocumentTypes:1:LSItemContentTypes:0' \
    "$app_path/Contents/Info.plist"
)" = "public.directory"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :NSServices:0:NSMessage' \
    "$app_path/Contents/Info.plist"
)" = "openFilesInEditor"
test "$(
  /usr/libexec/PlistBuddy -c 'Print :NSServices:0:NSMenuItem:default' \
    "$app_path/Contents/Info.plist"
)" = "Open in Satin Editor"

/usr/bin/codesign --verify --deep --strict --verbose=2 "$app_path"
/usr/bin/codesign --verify --strict --verbose=2 "$control_executable"
/usr/bin/codesign --verify --strict --verbose=2 "$nvim_launcher"
test -s "$app_path/Contents/Resources/AppIcon.icns"
test -s "$app_path/Contents/Resources/update-signing-public-key.json"
test -s "$app_path/Contents/Resources/Legal/LICENSE.txt"
test -s "$app_path/Contents/Resources/Legal/THIRD_PARTY_NOTICES.md"
test -s "$app_path/Contents/Resources/Legal/FONT_LICENSE.txt"
test -s "$app_path/Contents/Resources/Legal/RUST_DEPENDENCY_LICENSES.html"
grep -F "Copyright (c) 2023 Neovide Contributors" \
  "$app_path/Contents/Resources/Legal/THIRD_PARTY_NOTICES.md" >/dev/null
grep -F "SIL OPEN FONT LICENSE Version 1.1" \
  "$app_path/Contents/Resources/Legal/FONT_LICENSE.txt" >/dev/null
grep -F "Copyright (c) 2014 Ryan L McIntyre" \
  "$app_path/Contents/Resources/Legal/FONT_LICENSE.txt" >/dev/null
grep -F "Third Party Licenses" \
  "$app_path/Contents/Resources/Legal/RUST_DEPENDENCY_LICENSES.html" >/dev/null
test -x "$app_path/Contents/Resources/apply-update"
test -x "$control_executable"
test -x "$nvim_launcher"
test -s "$app_path/Contents/Resources/ShellIntegration/zsh/.zshrc"
for packaged_executable in "$executable" "$control_executable" "$nvim_launcher"; do
  if /usr/bin/otool -L "$packaged_executable" |
    awk 'NR > 1 { print $1 }' |
    grep -Eq '^/nix/store/'; then
    echo "packaged executable depends on the Nix store: $packaged_executable" >&2
    exit 65
  fi
done
test "$(/usr/bin/lipo -archs "$control_executable")" = "arm64"
test "$(/usr/bin/lipo -archs "$nvim_launcher")" = "arm64"
test "$(
  env -u SDKROOT -u DEVELOPER_DIR /usr/bin/vtool -show-build "$executable" |
    awk '/minos/ {print $2; exit}'
)" = "14.0"
test "$(
  env -u SDKROOT -u DEVELOPER_DIR /usr/bin/vtool -show-build "$control_executable" |
    awk '/minos/ {print $2; exit}'
)" = "14.0"
test "$(
  env -u SDKROOT -u DEVELOPER_DIR /usr/bin/vtool -show-build "$nvim_launcher" |
    awk '/minos/ {print $2; exit}'
)" = "14.0"
env -i PATH=/usr/bin:/bin "$control_executable" --version |
  grep -Fx "satinctl $package_version"
env -i PATH=/usr/bin:/bin "$nvim_launcher" --satin-launcher-version |
  grep -Fx "satin-nvim $package_version"

env -u SATIN_FONT -u NVTERM_FONT \
  SATIN_NATIVE_EXECUTABLE="$executable" \
  ./scripts/native-smoke
