#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command ./scripts/native-update-release-smoke "$@"
fi

release_root="spikes/macos-shell/.build/release"
manifest="$release_root/latest.json"
app_path="spikes/macos-shell/.build/package/Satin.app"
executable="$app_path/Contents/MacOS/satin"
test -f "$manifest"
test -x "$executable"
jq -e '
  .schemaVersion == 2
    and .signature.algorithm == "ed25519"
    and (.signature.keyID | length > 0)
    and (.signature.value | length > 0)
' "$manifest" >/dev/null
archive="$(jq -r .archive "$manifest")"
test -f "$release_root/$archive"

SATIN_UPDATE_VERIFY_RELEASE_ROOT="$release_root" "$executable"
SATIN_UPDATE_VERIFY_INSTALLABLE_RELEASE_ROOT="$release_root" "$executable"
