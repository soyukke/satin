#!/usr/bin/env python3
"""Runs a command on a terminal of its own and prints what it wrote.

    scripts/on-terminal COMMAND [ARGUMENT...]

The command's standard input and output are the terminal, this process is
its parent, and SATIN_SHELL_EXECUTABLE names this process's executable. The
exit status is the command's.
"""
import ctypes
import os
import pty
import sys

buffer = ctypes.create_string_buffer(4096)
ctypes.CDLL(None).proc_pidpath(os.getpid(), buffer, 4096)
os.environ["SATIN_SHELL_EXECUTABLE"] = buffer.value.decode()

child, terminal = pty.fork()
if child == 0:
    os.execv(sys.argv[1], sys.argv[1:])
output = b""
while True:
    try:
        chunk = os.read(terminal, 65536)
    except OSError:
        break
    if not chunk:
        break
    output += chunk
_, status = os.waitpid(child, 0)
sys.stdout.buffer.write(output.replace(b"\r\n", b"\n"))
sys.exit(os.waitstatus_to_exitcode(status))
