#!/usr/bin/env bash
set -euo pipefail

if (($# != 2)); then
  echo "usage: $0 <base-commit> <head-commit>" >&2
  exit 64
fi

base_ref="$1"
head_ref="$2"
git rev-parse --verify "${base_ref}^{commit}" >/dev/null
git rev-parse --verify "${head_ref}^{commit}" >/dev/null

changed_paths=()
while IFS= read -r path; do
  changed_paths+=("$path")
done < <(git diff --name-only --diff-filter=ACDMRTUXB "$base_ref" "$head_ref")

version_at() {
  git show "$1:VERSION" | tr -d '[:space:]'
}

is_version_only_release_bump() {
  ((${#changed_paths[@]} == 1)) || return 1
  [[ "${changed_paths[0]}" == "VERSION" ]] || return 1

  local base_version head_version
  base_version="$(version_at "$base_ref")"
  head_version="$(version_at "$head_ref")"
  [[ "$base_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ "$head_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ "$base_version" != "$head_version" ]] || return 1
}

if is_version_only_release_bump; then
  printf 'full=false\nreason=version-only-release-bump\n'
  exit 0
fi

full=false
reason=non-runtime-only
for path in "${changed_paths[@]}"; do
  case "$path" in
    .github/workflows/macos.yml | scripts/ci-change-scope)
      full=true
      reason=production-gate-definition
      break
      ;;
    .github/* | README.md | docs/* | assets/satin-demo.* | \
      assets/satin-work-switcher-demo.* | assets/satin-artifact-demo.*) ;;
    *)
      full=true
      reason=runtime-or-build-change
      break
      ;;
  esac
done

printf 'full=%s\nreason=%s\n' "$full" "$reason"
