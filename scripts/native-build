#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop --command just native-build
fi

build_dir="spikes/macos-shell/.build"
output="$build_dir/SatinApplication"
tmp_output="$build_dir/SatinApplication.$$"
lock_dir="$build_dir/native-build.lock"
minimum_macos="14.0"
host_arch="$(uname -m)"
if [[ "$host_arch" != "arm64" ]]; then
  echo "unsupported macOS architecture: $host_arch (Apple Silicon is required)" >&2
  exit 64
fi
swift_target="$host_arch-apple-macos$minimum_macos"

mkdir -p "$build_dir"

acquire_lock() {
  local waits=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    local owner=""
    if [[ -r "$lock_dir/pid" ]]; then
      owner="$(cat "$lock_dir/pid" 2>/dev/null || true)"
    fi
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f "$lock_dir/pid"
      rmdir "$lock_dir" 2>/dev/null || true
      continue
    fi
    if (( waits >= 600 )); then
      echo "native build lock timed out: $lock_dir" >&2
      exit 75
    fi
    waits=$((waits + 1))
    sleep 0.1
  done
  echo "$$" >"$lock_dir/pid"
}

cleanup() {
  rm -f "$tmp_output"
  rm -rf "$lock_dir"
}

acquire_lock
trap cleanup EXIT INT TERM

sdk="$(env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun --sdk macosx --show-sdk-path)"
portable_ldflags=("-L$sdk/usr/lib")
read -r -a inherited_ldflags <<<"${NIX_LDFLAGS:-}"
for flag in "${inherited_ldflags[@]}"; do
  case "$flag" in
    -L/nix/store/*-libiconv-*/lib) ;;
    *) portable_ldflags+=("$flag") ;;
  esac
done
NIX_LDFLAGS="${portable_ldflags[*]}" \
  MACOSX_DEPLOYMENT_TARGET="$minimum_macos" \
  cargo build --lib --bin satin --bin satin-nvim
env -u SDKROOT -u DEVELOPER_DIR \
  /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc \
  -parse-as-library \
  -warnings-as-errors \
  -sdk "$sdk" \
  -target "$swift_target" \
  spikes/macos-shell/ControlHost.swift \
  spikes/macos-shell/SettingsWindow.swift \
  spikes/macos-shell/SatinApplication.swift \
  spikes/macos-shell/UpdateInstaller.swift \
  target/debug/libsatin.a \
  -framework AppKit \
  -framework CryptoKit \
  -framework MetalKit \
  -framework Metal \
  -framework QuartzCore \
  -lc++ \
  -o "$tmp_output"
mv -f "$tmp_output" "$output"
