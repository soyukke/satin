#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${IN_NIX_SHELL:-}" && -z "${KIZU:-}" ]]; then
  exec nix develop --command just native-build
fi

# shellcheck source=scripts/native-swift-sources
source scripts/native-swift-sources

build_dir="spikes/macos-shell/.build"
output="$build_dir/SatinApplication"
tmp_output="$build_dir/SatinApplication.$$"
lock_dir="$build_dir/native-build.lock"
minimum_macos="14.0"
host_arch="$(uname -m)"
if [[ "$host_arch" != "arm64" ]]; then
  echo "unsupported macOS architecture: $host_arch (Apple Silicon is required)" >&2
  exit 64
fi
swift_target="$host_arch-apple-macos$minimum_macos"

mkdir -p "$build_dir"

acquire_lock() {
  local waits=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    local owner=""
    if [[ -r "$lock_dir/pid" ]]; then
      owner="$(cat "$lock_dir/pid" 2>/dev/null || true)"
    fi
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f "$lock_dir/pid"
      rmdir "$lock_dir" 2>/dev/null || true
      continue
    fi
    if ((waits >= 600)); then
      echo "native build lock timed out: $lock_dir" >&2
      exit 75
    fi
    waits=$((waits + 1))
    sleep 0.1
  done
  echo "$$" >"$lock_dir/pid"
}

cleanup() {
  rm -f "$tmp_output"
  rm -rf "$lock_dir"
}

acquire_lock
trap cleanup EXIT INT TERM

sdk="$(env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun --sdk macosx --show-sdk-path)"
satin_sdk_version="$(env -u SDKROOT -u DEVELOPER_DIR /usr/bin/xcrun --sdk macosx --show-sdk-version)"
satin_sdk_major="${satin_sdk_version%%.*}"
swift_feature_flags=(-D SATIN_SMOKE_SCENARIOS)
if [[ "$satin_sdk_major" =~ ^[0-9]+$ ]] && ((satin_sdk_major >= 26)); then
  swift_feature_flags+=(-D SATIN_HAS_LIQUID_GLASS_SDK)
fi
# The app core, the `satin` command and the nvim launcher are Kizu, built
# from core/ with the `kizu` the nix shell provides (or the one KIZU names).
kizu_core="$(cd core && pwd)"
MACOSX_DEPLOYMENT_TARGET="$minimum_macos" "$kizu_core/scripts/build"
# The app looks for the two commands beside itself.
cp -f "$kizu_core/target/bin/satin" "$kizu_core/target/bin/satin-nvim" "$build_dir/"
# The renderer loads its bundled fonts from `fonts` beside the executable.
rm -rf "$build_dir/fonts"
cp -R "$kizu_core/assets/fonts" "$build_dir/fonts"
env -u SDKROOT -u DEVELOPER_DIR \
  /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swiftc \
  -O \
  -parse-as-library \
  -whole-module-optimization \
  -warnings-as-errors \
  -sdk "$sdk" \
  -target "$swift_target" \
  "${swift_feature_flags[@]}" \
  "${native_swift_sources[@]}" \
  "${native_smoke_swift_sources[@]}" \
  "$kizu_core/target/host/satin.o" \
  "$kizu_core/target/native/libghostty-vt.a" \
  -framework AppKit \
  -framework CryptoKit \
  -framework MetalKit \
  -framework Metal \
  -framework QuartzCore \
  -framework CoreText \
  -framework CoreGraphics \
  -framework CoreFoundation \
  -lobjc \
  -o "$tmp_output"
mv -f "$tmp_output" "$output"
