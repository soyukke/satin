#!/usr/bin/env bash
set -euo pipefail

# Merges a pull request that carries its own version and releases it: waits
# for its checks and the branch policy, merges, tags main with the version it now holds
# and waits for the release. The tag is made only once main holds a version
# no tag has, so a merge that did not happen cannot be tagged.
#
# Usage: scripts/release-merge <pull-request-number>

if (($# != 1)) || ! [[ "$1" =~ ^[0-9]+$ ]]; then
  echo "usage: $0 <pull-request-number>" >&2
  exit 64
fi
pr="$1"

head="$(gh pr view "$pr" --json headRefOid --jq .headRefOid)"
git fetch --quiet origin main "$head"
version="$(git show "$head:VERSION" | tr -d '[:space:]')"
if ! [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "release-merge: the pull request's VERSION is not a version: $version" >&2
  exit 1
fi
if [[ "$version" == "$(git show origin/main:VERSION | tr -d '[:space:]')" ]]; then
  echo "release-merge: the pull request does not change VERSION ($version)" >&2
  exit 1
fi
if [[ -n "$(git ls-remote --tags origin "refs/tags/v$version")" ]]; then
  echo "release-merge: tag v$version exists" >&2
  exit 1
fi

echo "release-merge: waiting for the checks of #$pr (v$version)"
while true; do
  status=0
  output="$(gh pr checks "$pr" 2>&1)" || status=$?
  # A required check that depends on another is not reported until that one
  # ends, so passing checks are not enough: the branch policy must agree.
  if ((status == 0)) &&
    [[ "$(gh pr view "$pr" --json mergeStateStatus --jq .mergeStateStatus)" == CLEAN ]]; then
    break
  fi
  # 8 is pending; checks that have not been reported yet are an error.
  if ((status != 0 && status != 8)) && [[ "$output" != *"no checks reported"* ]]; then
    printf '%s\n' "$output" >&2
    exit 1
  fi
  sleep 15
done

gh pr merge "$pr" --squash --delete-branch
git fetch --quiet origin main
merged="$(git show origin/main:VERSION | tr -d '[:space:]')"
if [[ "$merged" != "$version" ]]; then
  echo "release-merge: main holds VERSION $merged, not $version; not tagging" >&2
  exit 1
fi
tagged="$(git rev-parse origin/main)"
git tag "v$version" "$tagged"
git push --quiet origin "refs/tags/v$version"

echo "release-merge: waiting for the release of v$version"
run=""
for _ in {1..30}; do
  run="$(gh run list --workflow release.yml --commit "$tagged" --limit 1 \
    --json databaseId --jq '.[0].databaseId // empty')"
  [[ -n "$run" ]] && break
  sleep 4
done
if [[ -z "$run" ]]; then
  echo "release-merge: the release workflow did not start" >&2
  exit 1
fi
gh run watch "$run" --interval 20 --exit-status >/dev/null
gh release view "v$version" --json url --jq .url
