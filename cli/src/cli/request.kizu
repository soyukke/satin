// The control request a command line stands for, as the JSON object the
// server reads.
import std::io;
import std::json;
import std::mem;
import std::string;

/// Starts a request object for command.
fn begin_request(encoder: &var json::Encoder, command: []u8) -> mem::Error!void {
    try encoder.begin_object();
    try encoder.write_i64_field("version", 1);
    try encoder.write_bytes_field("command", command);
    return;
}

/// Writes `--cwd PATH` as the cwd field, null without the flag.
fn write_optional(
    cli: &var Cli,
    allocator: Allocator,
    encoder: &var json::Encoder,
    flag: []u8,
    name: []u8
) -> mem::Error!void {
    var value = string::new(allocator);
    defer value.deinit(allocator);
    if try cli.extract_value(allocator, flag, &var value) {
        let bytes = value.as_bytes();
        try encoder.write_bytes_field(name, bytes);
    } else {
        try encoder.write_null_field(name);
    }
    return;
}

/// A request that names only a pane.
fn pane_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder, command: []u8) -> CliFailure!void {
    let pane = try cli.pane(allocator);
    try cli.ensure_empty(allocator);
    try begin_request(encoder, command);
    try encoder.write_i64_field("pane", pane);
    return;
}

/// A request that names only a tab.
fn tab_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder, command: []u8) -> CliFailure!void {
    let tab = try cli.tab(allocator);
    try cli.ensure_empty(allocator);
    try begin_request(encoder, command);
    try encoder.write_i64_field("tab", tab);
    return;
}

fn send_request_of(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder) -> CliFailure!void {
    let pane = try cli.pane(allocator);
    if cli.args.len() == 0 {
        cli.say(allocator, "send requires TEXT or - for stdin", "", "");
        return CliError::Failed;
    }
    var text = string::new(allocator);
    defer text.deinit(allocator);
    if cli.args.len() == 1 and cli.first_is("-") {
        if io::read_stdin_into(io::blocking(), allocator, &var text) {} else |_| {
            cli.say(allocator, "cannot read stdin", "", "");
            return CliError::Failed;
        }
    } else {
        try cli.join_rest(allocator, &var text);
    }
    let bytes = text.as_bytes();
    try begin_request(encoder, "send");
    try encoder.write_i64_field("pane", pane);
    try encoder.write_bytes_field("text", bytes);
    return;
}

fn key_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder) -> CliFailure!void {
    let pane = try cli.pane(allocator);
    if cli.args.len() != 1 {
        cli.say(allocator, "key requires one key name", "", "");
        return CliError::Failed;
    }
    var key = string::new(allocator);
    defer key.deinit(allocator);
    try cli.join_rest(allocator, &var key);
    let bytes = key.as_bytes();
    try begin_request(encoder, "key");
    try encoder.write_i64_field("pane", pane);
    try encoder.write_bytes_field("key", bytes);
    return;
}

fn write_status(
    encoder: &var json::Encoder,
    pane: i64,
    status: []u8,
    summary: []u8,
    session_start: bool
) -> mem::Error!void {
    try begin_request(encoder, "status-set");
    try encoder.write_i64_field("pane", pane);
    try encoder.write_bytes_field("status", status);
    try encoder.write_bytes_field("summary", summary);
    if session_start {
        try encoder.write_bool_field("agent_session_start", true);
    }
    return;
}

fn status_set_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder, pane: i64) -> CliFailure!void {
    if cli.args.len() == 0 {
        cli.say(allocator, "status set requires STATUS [SUMMARY]", "", "");
        return CliError::Failed;
    }
    var status = string::new(allocator);
    defer status.deinit(allocator);
    if cli.args.at(0) |word| {
        try status.append_string(allocator, word);
    }
    cli.shift(allocator);
    var summary = string::new(allocator);
    defer summary.deinit(allocator);
    try cli.join_rest(allocator, &var summary);
    let status_bytes = status.as_bytes();
    let summary_bytes = summary.as_bytes();
    try write_status(encoder, pane, status_bytes, summary_bytes, false);
    return;
}

fn status_wait_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder, pane: i64) -> CliFailure!void {
    var seconds: i64 = 60;
    var given = string::new(allocator);
    defer given.deinit(allocator);
    if try cli.extract_value(allocator, "--timeout", &var given) {
        let digits = given.as_bytes();
        seconds = parse_index(digits);
        if seconds < 0 {
            cli.say(allocator, "--timeout must be whole seconds", "", "");
            return CliError::Failed;
        }
    }
    if seconds > 3600 {
        seconds = 3600;
    }
    try cli.ensure_empty(allocator);
    try begin_request(encoder, "status-wait");
    try encoder.write_i64_field("pane", pane);
    try encoder.write_i64_field("timeout_ms", seconds * 1000);
    return;
}

fn status_event_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder, pane: i64) -> CliFailure!void {
    if cli.args.len() != 1 {
        cli.say(allocator, "status event requires one agent name", "", "");
        return CliError::Failed;
    }
    if !cli.first_is("claude") {
        var agent = string::new(allocator);
        defer agent.deinit(allocator);
        try cli.join_rest(allocator, &var agent);
        let name = agent.as_bytes();
        cli.say(allocator, "unsupported agent ", name, "");
        return CliError::Failed;
    }
    var input = string::new(allocator);
    defer input.deinit(allocator);
    if io::read_stdin_into(io::blocking(), allocator, &var input) {} else |_| {
        cli.say(allocator, "cannot read stdin", "", "");
        return CliError::Failed;
    }
    let event = input.as_bytes();
    let number = try claude_pane_status(allocator, event);
    if number == 0 {
        cli.say(allocator, "unsupported Claude Code hook event", "", "");
        return CliError::Failed;
    }
    try write_status(encoder, pane, status_word(number), status_summary(number), false);
    return;
}

fn status_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder) -> CliFailure!void {
    var kind = 0;
    if cli.first_is("set") {
        kind = 1;
    } else if cli.first_is("wait") {
        kind = 2;
    } else if cli.first_is("event") {
        kind = 3;
    } else if cli.first_is("session-start") {
        kind = 4;
    }
    if kind == 0 {
        cli.say(allocator, "status requires set, wait, event, or session-start", "", "");
        return CliError::Failed;
    }
    cli.shift(allocator);
    let pane = try cli.pane(allocator);
    if kind == 1 {
        try status_set_request(cli, allocator, encoder, pane);
    } else if kind == 2 {
        try status_wait_request(cli, allocator, encoder, pane);
    } else if kind == 3 {
        try status_event_request(cli, allocator, encoder, pane);
    } else if cli.args.len() == 1 and cli.first_is("codex") {
        try write_status(encoder, pane, "idle", "Codex ready", true);
    } else if cli.args.len() == 1 and cli.first_is("claude") {
        try write_status(encoder, pane, "idle", "Claude Code ready", true);
    } else {
        cli.say(allocator, "status session-start requires codex or claude", "", "");
        return CliError::Failed;
    }
    return;
}

fn new_tab_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder) -> CliFailure!void {
    try begin_request(encoder, "new-tab");
    try write_optional(cli, allocator, encoder, "--cwd", "cwd");
    try write_optional(cli, allocator, encoder, "--title", "title");
    try encoder.write_bool_field("background", cli.remove_flag(allocator, "--background"));
    try cli.ensure_empty(allocator);
    return;
}

fn split_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder) -> CliFailure!void {
    let pane = try cli.pane(allocator);
    var cwd = string::new(allocator);
    defer cwd.deinit(allocator);
    let has_cwd = try cli.extract_value(allocator, "--cwd", &var cwd);
    let background = cli.remove_flag(allocator, "--background");
    let vertical = cli.remove_flag(allocator, "--vertical");
    let horizontal = cli.remove_flag(allocator, "--horizontal");
    if vertical == horizontal {
        cli.say(allocator, "split requires exactly one of --vertical or --horizontal", "", "");
        return CliError::Failed;
    }
    try cli.ensure_empty(allocator);
    try begin_request(encoder, "split");
    try encoder.write_i64_field("pane", pane);
    if vertical {
        try encoder.write_bytes_field("axis", "vertical");
    } else {
        try encoder.write_bytes_field("axis", "horizontal");
    }
    if has_cwd {
        let directory = cwd.as_bytes();
        try encoder.write_bytes_field("cwd", directory);
    } else {
        try encoder.write_null_field("cwd");
    }
    try encoder.write_bool_field("background", background);
    return;
}

fn move_tab_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder) -> CliFailure!void {
    let tab = try cli.tab(allocator);
    var given = string::new(allocator);
    defer given.deinit(allocator);
    if !try cli.extract_value(allocator, "--index", &var given) {
        cli.say(allocator, "move-tab requires --index INDEX", "", "");
        return CliError::Failed;
    }
    let digits = given.as_bytes();
    let index = parse_index(digits);
    if index < 0 {
        cli.say(allocator, "--index must be a zero-based integer", "", "");
        return CliError::Failed;
    }
    try cli.ensure_empty(allocator);
    try begin_request(encoder, "move-tab");
    try encoder.write_i64_field("tab", tab);
    try encoder.write_i64_field("index", index);
    return;
}

/// A request of a tab and the words after it as one text field.
fn tab_text_request(
    cli: &var Cli,
    allocator: Allocator,
    encoder: &var json::Encoder,
    command: []u8,
    name: []u8,
    one_word: bool,
    missing: []u8
) -> CliFailure!void {
    let tab = try cli.tab(allocator);
    if cli.args.len() == 0 or (one_word and cli.args.len() != 1) {
        cli.say(allocator, missing, "", "");
        return CliError::Failed;
    }
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try cli.join_rest(allocator, &var text);
    let bytes = text.as_bytes();
    try begin_request(encoder, command);
    try encoder.write_i64_field("tab", tab);
    try encoder.write_bytes_field(name, bytes);
    return;
}

/// Writes the request the words stand for into the open encoder, whose
/// object the caller ends. An unknown command leaves the usage as the
/// message.
fn write_request(cli: &var Cli, allocator: Allocator, encoder: &var json::Encoder) -> CliFailure!void {
    var command = string::new(allocator);
    defer command.deinit(allocator);
    if cli.args.at(0) |word| {
        try command.append_string(allocator, word);
    } else {
        cli.say(allocator, usage(), "", "");
        return CliError::Failed;
    }
    cli.shift(allocator);
    let name = command.as_bytes();
    if mem::equal_bytes(name, "list") {
        try cli.ensure_empty(allocator);
        try begin_request(encoder, "list");
    } else if mem::equal_bytes(name, "read-screen") or mem::equal_bytes(name, "select-pane") or
        mem::equal_bytes(name, "close-pane") {
        try pane_request(cli, allocator, encoder, name);
    } else if mem::equal_bytes(name, "select-tab") or mem::equal_bytes(name, "close-tab") {
        try tab_request(cli, allocator, encoder, name);
    } else if mem::equal_bytes(name, "send") {
        try send_request_of(cli, allocator, encoder);
    } else if mem::equal_bytes(name, "key") {
        try key_request(cli, allocator, encoder);
    } else if mem::equal_bytes(name, "status") {
        try status_request(cli, allocator, encoder);
    } else if mem::equal_bytes(name, "new-tab") {
        try new_tab_request(cli, allocator, encoder);
    } else if mem::equal_bytes(name, "split") {
        try split_request(cli, allocator, encoder);
    } else if mem::equal_bytes(name, "move-tab") {
        try move_tab_request(cli, allocator, encoder);
    } else if mem::equal_bytes(name, "rename-tab") {
        try tab_text_request(cli, allocator, encoder, "rename-tab", "title", false, "rename-tab requires TITLE");
    } else if mem::equal_bytes(name, "set-theme") {
        try tab_text_request(cli, allocator, encoder, "set-theme", "theme", true, "set-theme requires THEME");
    } else {
        cli.say(allocator, "unknown command ", name, blank_line());
        if cli.message.append_bytes(allocator, usage()) {} else |_| {}
        return CliError::Failed;
    }
    return;
}

/// Appends the request the words stand for to out.
fn parse_request(cli: &var Cli, allocator: Allocator, out: &var string::String) -> CliFailure!void {
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try write_request(cli, allocator, &var encoder);
    try encoder.end_object();
    try encoder.finish_into(allocator, out);
    return;
}

fn usage() -> []u8 {
    return
        \\usage: satin --version
        \\       satin skill
        \\       satin [--socket PATH] [--json] COMMAND
        \\commands:
        \\  skill
        \\  identify
        \\  artifact policy [set [--max-columns N] [--max-rows N] [--language TAG]
        \\                       [--overflow compact|defer|reject]]
        \\  artifact add [--id ID] --kind KIND --title TITLE --file PATH [--language TAG]
        \\  artifact list [ID] [--limit N]
        \\  artifact show [--pane ID] ID [--background]
        \\  artifact view ID [--no-wait]
        \\  list
        \\  read-screen [--pane ID]
        \\  send [--pane ID] TEXT|-
        \\  key [--pane ID] KEY
        \\  status set [--pane ID] STATUS [SUMMARY]
        \\  status wait [--pane ID] [--timeout SECONDS]
        \\  status event [--pane ID] claude
        \\  status session-start [--pane ID] codex|claude
        \\  new-tab [--cwd PATH] [--title TITLE] [--background]
        \\  split [--pane ID] --vertical|--horizontal [--cwd PATH] [--background]
        \\  select-tab [--tab ID]
        \\  move-tab [--tab ID] --index INDEX
        \\  close-tab [--tab ID]
        \\  select-pane [--pane ID]
        \\  close-pane [--pane ID]
        \\  rename-tab [--tab ID] TITLE
        \\  set-theme [--tab ID] THEME
    ;
}

fn blank_line() -> []u8 {
    return
        \\
        \\
        \\
    ;
}
