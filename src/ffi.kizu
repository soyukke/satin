// The C boundary the Swift host calls: `satin_core_*`, the same functions and
// the same values the Rust core exported.
//
// The core lives in malloc storage the host holds as an opaque pointer. Each
// call reads it out, works on it, and writes it back: Kizu has no way to lend
// a raw pointer's target as `&var`, and the host calls from one thread.
import satin::core;
import std::mem;
import std::string;

extern "c" fn malloc(size: usize) -> ?ptr<u8>
extern "c" fn free(p: ptr<u8>) -> void
extern "c" fn strlen(s: ptr<const u8>) -> usize

/// Bytes of malloc storage one Core takes. Kizu has no `sizeof`, so this is
/// a bound: Core is five words of fields and three arrays of three words.
fn core_storage_bytes() -> usize {
    return 256;
}

fn none() -> usize {
    return cast<usize>(-1);
}

fn flag(value: bool) -> u8 {
    if value {
        return 1;
    }
    return 0;
}

/// Copies a NUL-terminated C string into an owned String.
fn c_string(allocator: Allocator, text: ptr<const u8>) -> mem::Error!string::String {
    // SAFETY: the host passes a NUL-terminated string that outlives the call.
    let length = unsafe strlen(text);
    // SAFETY: strlen counted length readable bytes at text.
    let bytes = unsafe view_from_ptr(text, cast<i64>(length));
    return string::from_bytes(allocator, bytes);
}

/// Copies bytes into malloc storage the host frees with `satin_string_free`.
fn c_string_out(bytes: []u8) -> ?ptr<u8> {
    let length = mem::len(bytes);
    // SAFETY: malloc returns length + 1 bytes of storage or null.
    let storage = unsafe malloc(cast<usize>(length + 1));
    if storage |out| {
        // SAFETY: out holds length + 1 writable bytes.
        let view = unsafe mut_view_from_ptr(out, length + 1);
        var index = 0;
        while index < length {
            view[index] = bytes[index];
            index = index + 1;
        }
        view[length] = cast<u8>(0);
    }
    return storage;
}

/// The null handle, the answer to a create that could not allocate.
fn null_core() -> ?ptr<core::Core> {
    // SAFETY: address zero is null, which nothing dereferences.
    return unsafe ptr_from_int<ptr<core::Core>>(0);
}

fn create(theme: []u8) -> ?ptr<core::Core> {
    let allocator = mem::page_allocator();
    if core::new_core(allocator, theme) |value| {
        // SAFETY: malloc returns storage for one Core or null.
        let storage = unsafe malloc(core_storage_bytes());
        if storage |slot| {
            // SAFETY: slot is fresh storage large enough for one Core.
            let handle = unsafe cast<ptr<core::Core>>(slot);
            // SAFETY: handle is fresh storage for one Core; the core now lives there.
            unsafe ptr_write(handle, move value);
            return handle;
        }
        value.deinit(allocator);
    } else |_| {}
    return null_core();
}

export "c" fn satin_core_create() -> ?ptr<core::Core> {
    return create("Graphite");
}

export "c" fn satin_core_create_with_theme(theme: ?ptr<const u8>) -> ?ptr<core::Core> {
    let allocator = mem::page_allocator();
    if theme |text| {
        if c_string(allocator, text) |name| {
            defer name.deinit(allocator);
            let bytes = name.as_bytes();
            return create(bytes);
        } else |_| {
            return null_core();
        }
    }
    return create("Graphite");
}

export "c" fn satin_core_destroy(handle: ?ptr<core::Core>) -> void {
    if handle |live| {
        // SAFETY: live came from satin_core_create and is destroyed once.
        let value = unsafe ptr_read(live);
        value.deinit(mem::page_allocator());
        // SAFETY: live is malloc storage nothing reads after this.
        unsafe free(cast<ptr<u8>>(live));
    }
}

export "c" fn satin_core_new_tab(handle: ?ptr<core::Core>) -> usize {
    let live = handle orelse return none();
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &var live.*;
    var result = none();
    if value.new_tab(mem::page_allocator()) |index| {
        result = cast<usize>(index);
    } else |_| {}
    return result;
}

fn axis_of(value: u32, out: &var core::Axis) -> bool {
    if value == 0 {
        out = core::Axis::Vertical;
        return true;
    }
    if value == 1 {
        out = core::Axis::Horizontal;
        return true;
    }
    return false;
}

export "c" fn satin_core_split_active(handle: ?ptr<core::Core>, axis: u32) -> usize {
    let live = handle orelse return none();
    var split = core::Axis::Vertical;
    if !axis_of(axis, &var split) {
        return none();
    }
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &var live.*;
    var result = none();
    if value.split_active(mem::page_allocator(), split) |pane| {
        if pane >= 0 {
            result = cast<usize>(pane);
        }
    } else |_| {}
    return result;
}

export "c" fn satin_core_resize_split(
    handle: ?ptr<core::Core>,
    first_pane_id: usize,
    second_pane_id: usize,
    ratio: f64
) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &var live.*;
    return flag(value.resize_split(cast<i64>(first_pane_id), cast<i64>(second_pane_id), ratio));
}

export "c" fn satin_core_close_pane(handle: ?ptr<core::Core>, pane_id: usize) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &var live.*;
    var done = false;
    if value.close_pane(mem::page_allocator(), cast<i64>(pane_id)) |closed| {
        if closed {
            done = true;
        }
    } else |_| {}
    return flag(done);
}

fn drop_position_of(value: u32, out: &var core::DropPosition) -> bool {
    if value == 0 {
        out = core::DropPosition::Center;
    } else if value == 1 {
        out = core::DropPosition::Left;
    } else if value == 2 {
        out = core::DropPosition::Right;
    } else if value == 3 {
        out = core::DropPosition::Top;
    } else if value == 4 {
        out = core::DropPosition::Bottom;
    } else {
        return false;
    }
    return true;
}

export "c" fn satin_core_move_pane(
    handle: ?ptr<core::Core>,
    source_pane_id: usize,
    target_pane_id: usize,
    position: u32
) -> u8 {
    let live = handle orelse return 0;
    var drop = core::DropPosition::Center;
    if !drop_position_of(position, &var drop) {
        return 0;
    }
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &var live.*;
    var done = false;
    if value.move_pane(mem::page_allocator(), cast<i64>(source_pane_id), cast<i64>(target_pane_id), drop) |moved| {
        if moved {
            done = true;
        }
    } else |_| {}
    return flag(done);
}

export "c" fn satin_core_select_tab(handle: ?ptr<core::Core>, index: usize) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &var live.*;
    return flag(value.select_tab(cast<i64>(index)));
}

export "c" fn satin_core_move_tab(handle: ?ptr<core::Core>, tab_id: usize, index: usize) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &var live.*;
    return flag(value.move_tab(cast<i64>(tab_id), cast<i64>(index)));
}

export "c" fn satin_core_select_pane(handle: ?ptr<core::Core>, pane_id: usize) -> u8 {
    let live = handle orelse return 0;
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &var live.*;
    return flag(value.select_pane(cast<i64>(pane_id)));
}

fn direction_of(value: u32, out: &var core::Direction) -> bool {
    if value == 0 {
        out = core::Direction::Left;
    } else if value == 1 {
        out = core::Direction::Right;
    } else if value == 2 {
        out = core::Direction::Up;
    } else if value == 3 {
        out = core::Direction::Down;
    } else {
        return false;
    }
    return true;
}

export "c" fn satin_core_pane_in_direction(handle: ?ptr<core::Core>, direction: u32) -> usize {
    let live = handle orelse return none();
    var toward = core::Direction::Left;
    if !direction_of(direction, &var toward) {
        return none();
    }
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &live.*;
    if value.pane_in_direction(mem::page_allocator(), toward) |pane| {
        if pane >= 0 {
            return cast<usize>(pane);
        }
    } else |_| {}
    return none();
}

export "c" fn satin_core_rename_tab(handle: ?ptr<core::Core>, index: usize, title: ?ptr<const u8>) -> u8 {
    let live = handle orelse return 0;
    let text = title orelse return 0;
    let allocator = mem::page_allocator();
    var done = false;
    if c_string(allocator, text) |name| {
        defer name.deinit(allocator);
        let bytes = name.as_bytes();
        // SAFETY: the host holds live from satin_core_create and calls from one thread.
        let value = unsafe &var live.*;
        if value.rename_tab(allocator, cast<i64>(index), bytes) |renamed| {
            if renamed {
                done = true;
            }
        } else |_| {}
    } else |_| {}
    return flag(done);
}

export "c" fn satin_core_set_tab_theme(handle: ?ptr<core::Core>, index: usize, theme: ?ptr<const u8>) -> u8 {
    let live = handle orelse return 0;
    let text = theme orelse return 0;
    let allocator = mem::page_allocator();
    var done = false;
    if c_string(allocator, text) |name| {
        defer name.deinit(allocator);
        let bytes = name.as_bytes();
        // SAFETY: the host holds live from satin_core_create and calls from one thread.
        let value = unsafe &var live.*;
        if value.set_tab_theme(allocator, cast<i64>(index), bytes) |set| {
            if set {
                done = true;
            }
        } else |_| {}
    } else |_| {}
    return flag(done);
}

export "c" fn satin_core_set_default_theme(handle: ?ptr<core::Core>, theme: ?ptr<const u8>) -> u8 {
    let live = handle orelse return 0;
    let text = theme orelse return 0;
    let allocator = mem::page_allocator();
    var done = false;
    if c_string(allocator, text) |name| {
        defer name.deinit(allocator);
        let bytes = name.as_bytes();
        // SAFETY: the host holds live from satin_core_create and calls from one thread.
        let value = unsafe &var live.*;
        if value.set_default_theme(allocator, bytes) {
            done = true;
        } else |_| {}
    } else |_| {}
    return flag(done);
}

/// The null string, the answer to a snapshot that could not be written.
fn null_string() -> ?ptr<u8> {
    // SAFETY: address zero is null, which nothing dereferences.
    return unsafe ptr_from_int<ptr<u8>>(0);
}

export "c" fn satin_core_snapshot_json(handle: ?ptr<core::Core>) -> ?ptr<u8> {
    let live = handle orelse return null_string();
    let allocator = mem::page_allocator();
    // SAFETY: the host holds live from satin_core_create and calls from one thread.
    let value = unsafe &live.*;
    var json = string::new(allocator);
    defer json.deinit(allocator);
    if value.snapshot_json(allocator, &var json) {
        let bytes = json.as_bytes();
        return c_string_out(bytes);
    } else |_| {}
    return null_string();
}

export "c" fn satin_core_apply_workspace_json(handle: ?ptr<core::Core>, workspace: ?ptr<const u8>) -> u8 {
    let live = handle orelse return 0;
    let text = workspace orelse return 0;
    let allocator = mem::page_allocator();
    var done = false;
    if c_string(allocator, text) |document| {
        defer document.deinit(allocator);
        let bytes = document.as_bytes();
        // SAFETY: the host holds live from satin_core_create and calls from one thread.
        let value = unsafe &var live.*;
        if value.apply_workspace(allocator, bytes) {
            done = true;
        } else |_| {}
    } else |_| {}
    return flag(done);
}
